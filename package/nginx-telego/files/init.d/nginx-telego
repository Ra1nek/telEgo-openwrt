#!/bin/sh /etc/rc.common

START=81
STOP=19
USE_PROCD=1

RECONCILE=${NGINX_TELEGO_RECONCILE:-/usr/libexec/nginx-telego-reconcile}

apply_config() {
	"$RECONCILE" apply
}

start_service() {
	apply_config
}

reload_service() {
	apply_config
}

# Managed files are configuration, not a daemon instance. Stopping this helper
# must not remove a valid Nginx listener from an already running router.
stop_service() {
	:
}

# LuCI's Save & Apply emits config.change events. Reconcile when either the
# managed ingress settings or the telEgo contract they depend on changes.
service_triggers() {
	procd_add_reload_trigger nginx_telego telego
}

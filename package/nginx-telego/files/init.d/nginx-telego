#!/bin/sh /etc/rc.common

START=81
STOP=19
USE_PROCD=1

RECONCILE=${NGINX_TELEGO_RECONCILE:-/usr/libexec/nginx-telego-reconcile}
FIREWALL_MANAGER=${NGINX_TELEGO_FIREWALL:-/usr/libexec/nginx-telego-firewall}
PLATFORM_MANAGER=${NGINX_TELEGO_PLATFORM:-/usr/libexec/nginx-telego-platform}
NGINX_INIT=${NGINX_INIT:-/etc/init.d/nginx}
UCI_BIN=${UCI_BIN:-/sbin/uci}

is_enabled() {
	case "$1" in
		1|true|yes|on) return 0 ;;
		*) return 1 ;;
	esac
}

direct_https_enabled() {
	value=$($UCI_BIN -q get nginx_telego.direct_https.enabled 2>/dev/null || true)
	is_enabled "$value"
}

ensure_nginx_running() {
	[ -x "$NGINX_INIT" ] || {
		echo "nginx-telego: nginx init script not found or not executable: $NGINX_INIT" >&2
		return 1
	}

	if "$NGINX_INIT" status >/dev/null 2>&1; then
		return 0
	fi

	"$NGINX_INIT" start || {
		echo 'nginx-telego: failed to start nginx after reconciliation' >&2
		return 1
	}

	"$NGINX_INIT" status >/dev/null 2>&1 || {
		echo 'nginx-telego: nginx did not become active after start' >&2
		return 1
	}
}

apply_config() {
	if direct_https_enabled; then
		# Dedicated Direct HTTPS owns TCP/443 directly in Nginx. Validate both
		# system-side port ownership and WAN firewall ownership before mutation.
		"$PLATFORM_MANAGER" check || return 1
		"$FIREWALL_MANAGER" check || return 1

		# Move package-managed LuCI HTTPS away from :443 and install optional
		# split DNS before Nginx claims the socket. If Nginx reconciliation then
		# fails, restore only platform state that this package actually owned.
		"$PLATFORM_MANAGER" apply || return 1
		if ! "$RECONCILE" apply; then
			"$PLATFORM_MANAGER" remove || true
			return 1
		fi

		# nginx itself starts one rc stage before this helper. Recover it here if
		# that early boot attempt failed: a valid reconciled Direct HTTPS config
		# must have a live :443 owner before WAN exposure is enabled.
		ensure_nginx_running || return 1

		# Public exposure is the final step: WAN TCP/443 is accepted only after
		# the direct Nginx listener has reconciled and the service is active.
		"$FIREWALL_MANAGER" apply
	else
		# Stop WAN exposure first, then release Nginx :443, then restore only
		# package-owned LuCI/split-DNS state. This prevents traffic from being
		# delivered to a management listener during a profile transition.
		"$FIREWALL_MANAGER" apply || return 1
		"$RECONCILE" apply || return 1
		"$PLATFORM_MANAGER" apply
	fi
}

start_service() {
	apply_config
}

reload_service() {
	apply_config
}

# Managed files and firewall state are configuration, not a daemon instance.
# Stopping this helper must not silently rewrite administrator-selected ingress.
stop_service() {
	:
}

# LuCI's Save & Apply emits config.change events. Reconcile when either the
# managed ingress settings or the telEgo contract they depend on changes.
service_triggers() {
	procd_add_reload_trigger nginx_telego telego
}

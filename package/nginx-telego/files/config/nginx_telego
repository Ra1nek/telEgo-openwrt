# Optional managed Nginx ingress profiles for telEgo.
# The UCI package uses an underscore because OpenWrt UCI package names cannot
# contain hyphens. The APK and init script remain named nginx-telego.
#
# All managed profiles are disabled by default so package upgrades never take
# over existing listeners or hand-written /etc/nginx/conf.d/*.conf files.

config shared 'shared'
	option enabled '0'
	option hostname ''
	option certificate ''
	option certificate_key ''

config cloudflare 'cloudflare'
	option enabled '0'
	option hostname ''

# Direct HTTPS terminates public WEB TLS in Nginx on the private backend port
# 18443. P12.2 owns the WAN TCP/443 -> :18443 firewall redirect separately.
config direct_https 'direct_https'
	option enabled '0'
	option hostname ''
	option certificate ''
	option certificate_key ''

# When managed, nginx-telego can provide a minimal loopback-only ordinary-site
# fallback on 127.0.0.1:8090. Set manage=0 when another local site already owns
# that listener.
config fallback 'fallback'
	option manage '1'

# Optional managed Nginx ingress profiles for telEgo.
# The UCI package uses an underscore because OpenWrt UCI package names cannot
# contain hyphens. The APK and init script remain named nginx-telego.
#
# All managed profiles are disabled by default so package upgrades never take
# over existing listeners or hand-written /etc/nginx/conf.d/*.conf files.
# A blank per-profile hostname inherits telego.web_proxy.hostname. A non-empty
# override must match telego.web_proxy.hostname exactly.

config shared 'shared'
	option enabled '0'
	option hostname ''
	option certificate ''
	option certificate_key ''

config cloudflare 'cloudflare'
	option enabled '0'
	option hostname ''

# Direct HTTPS dedicates TCP/443 to dual-stack Nginx for both LAN and WAN WEB
# ingress. LuCI/uhttpd is moved to a separate HTTPS management port (10443 by
# default). nginx-telego-firewall owns only the WAN TCP/443 ACCEPT rule.
# An optional split-DNS address lets LAN clients resolve the WEB hostname to a
# router LAN address and avoid public-IP hairpin NAT entirely.
# Configure telEgo MTProxy on another public port. Use Native Shared-Port when
# WEB and MTProxy intentionally need to share public TCP/443.
# OpenWrt ACME DNS-01 users should prefer the stable symlink paths
# /etc/ssl/acme/HOST.fullchain.crt and /etc/ssl/acme/HOST.key.
config direct_https 'direct_https'
	option enabled '0'
	option hostname ''
	option certificate ''
	option certificate_key ''
	option luci_https_port '10443'
	option split_dns_address ''

# When managed, nginx-telego can provide a minimal loopback-only ordinary-site
# fallback on 127.0.0.1:8090. Set manage=0 when another local site already owns
# that listener.
config fallback 'fallback'
	option manage '1'

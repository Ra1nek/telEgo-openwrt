#!/bin/sh
# Reconcile nginx-telego package-owned and generated Nginx files as one transaction.
#
# P6 defines ownership and drift. P7 repairs safe package drift, migrates obsolete
# generated state, delegates desired-file rendering, validates the complete Nginx
# tree, and reloads only after all managed filesystem state is known-good.
set -eu

ROOT=${NGINX_TELEGO_ROOT:-}
FILES_BIN=${NGINX_TELEGO_FILES:-${ROOT}/usr/libexec/nginx-telego-files}
RENDER_BIN=${NGINX_TELEGO_RENDER:-${ROOT}/usr/libexec/nginx-telego-render}
MANIFEST=${NGINX_TELEGO_MANIFEST:-${ROOT}/usr/share/nginx-telego/ownership.tsv}
UCI_BIN=${UCI_BIN:-/sbin/uci}
NGINX_BIN=${NGINX_BIN:-/usr/sbin/nginx}
NGINX_CONF=${NGINX_CONF:-${ROOT}/etc/nginx/uci.conf}
NGINX_INIT=${NGINX_INIT:-${ROOT}/etc/init.d/nginx}
NGINX_UCI_CONFIG=${NGINX_UCI_CONFIG:-${ROOT}/etc/config/nginx}
CONF_DIR=${NGINX_TELEGO_CONF_DIR:-${ROOT}/etc/nginx/conf.d}
INGRESS_OUTPUT=${NGINX_TELEGO_INGRESS_OUTPUT:-${CONF_DIR}/80-telego-ingress.conf}
FALLBACK_OUTPUT=${NGINX_TELEGO_FALLBACK_OUTPUT:-${CONF_DIR}/85-telego-fallback.conf}
LEGACY_OUTPUT_PATH=${NGINX_TELEGO_LEGACY_OUTPUT_PATH:-/etc/nginx/conf.d/zz-telego-managed.conf}
LEGACY_OUTPUT=$(printf '%s%s' "$ROOT" "$LEGACY_OUTPUT_PATH")
MANAGED_MARKER='# Generated by /usr/libexec/nginx-telego-render from /etc/config/nginx_telego.'
LOCK_DIR=${NGINX_TELEGO_LOCK_DIR:-${ROOT}/var/lock/nginx-telego-reconcile.lock}
RELOAD=1

case "${1:-apply}" in
    apply) ;;
    --no-reload) RELOAD=0 ;;
    *)
        echo "Usage: $0 [apply|--no-reload]" >&2
        exit 2
        ;;
esac

fail() {
    echo "nginx-telego-reconcile: $*" >&2
    exit 1
}

case "$ROOT" in
    ''|/*) ;;
    *) fail 'NGINX_TELEGO_ROOT must be empty or an absolute path' ;;
esac
case "$LEGACY_OUTPUT_PATH" in
    /etc/nginx/conf.d/*.conf) ;;
    *) fail 'NGINX_TELEGO_LEGACY_OUTPUT_PATH must be a direct /etc/nginx/conf.d/*.conf path' ;;
esac
case "${LEGACY_OUTPUT_PATH#/etc/nginx/conf.d/}" in
    ''|*/*) fail 'NGINX_TELEGO_LEGACY_OUTPUT_PATH must name one direct conf.d child' ;;
esac

root_path() {
    value=$1
    case "$value" in
        /*) printf '%s%s' "$ROOT" "$value" ;;
        *) fail "managed path is not absolute: $value" ;;
    esac
}

nginx_test() {
    [ -x "$NGINX_BIN" ] || fail "nginx executable not found: $NGINX_BIN"
    [ -r "$NGINX_CONF" ] || fail "nginx configuration not found: $NGINX_CONF"
    "$NGINX_BIN" -t -c "$NGINX_CONF"
}

reload_nginx() {
    [ "$RELOAD" -eq 1 ] || return 0
    [ -x "$NGINX_INIT" ] || return 0
    if "$NGINX_INIT" status >/dev/null 2>&1; then
        "$NGINX_INIT" reload
    fi
}

lock_held=0
work=''
tx_active=0
backup_index=0
legacy_remove=0

acquire_lock() {
    lock_parent=$(dirname "$LOCK_DIR")
    mkdir -p "$lock_parent"

    if mkdir "$LOCK_DIR" 2>/dev/null; then
        printf '%s\n' "$$" >"$LOCK_DIR/pid"
        lock_held=1
        return 0
    fi

    stale=1
    old_pid=''
    if [ -r "$LOCK_DIR/pid" ]; then
        old_pid=$(cat "$LOCK_DIR/pid" 2>/dev/null || true)
        case "$old_pid" in
            ''|*[!0-9]*) ;;
            *)
                if kill -0 "$old_pid" 2>/dev/null; then
                    stale=0
                fi
                ;;
        esac
    fi

    [ "$stale" -eq 1 ] || fail "another reconciliation is already running (pid $old_pid)"
    rm -rf "$LOCK_DIR"
    mkdir "$LOCK_DIR" || fail "could not acquire reconciliation lock: $LOCK_DIR"
    printf '%s\n' "$$" >"$LOCK_DIR/pid"
    lock_held=1
}

rollback_transaction() {
    [ -n "$work" ] || return 0
    [ -f "$work/backups.tsv" ] || return 0

    while IFS="$(printf '\t')" read -r path backup || [ -n "${path:-}" ]; do
        [ -n "${path:-}" ] || continue
        target=$(root_path "$path")

        if [ -L "$target" ] || [ -f "$target" ]; then
            rm -f "$target"
        elif [ -e "$target" ]; then
            echo "nginx-telego-reconcile: rollback skipped unsafe path type: $path" >&2
            continue
        fi

        if [ "$backup" != '-' ]; then
            mkdir -p "$(dirname "$target")"
            cp -p "$backup" "$target"
        fi
    done <"$work/backups.tsv"
}

cleanup() {
    rc=$?
    trap - EXIT HUP INT TERM

    if [ "$tx_active" -eq 1 ]; then
        rollback_transaction || true
        echo 'nginx-telego-reconcile: transaction rolled back' >&2
    fi

    [ -z "$work" ] || rm -rf "$work"
    if [ "$lock_held" -eq 1 ]; then
        rm -rf "$LOCK_DIR"
    fi
    exit "$rc"
}

trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

record_backup() {
    path=$1
    target=$(root_path "$path")
    backup_index=$((backup_index + 1))

    if [ -L "$target" ]; then
        fail "refusing to transact symlink managed path: $path"
    elif [ -e "$target" ] && [ ! -f "$target" ]; then
        fail "refusing to transact non-regular managed path: $path"
    elif [ -f "$target" ]; then
        backup="$work/backup.$backup_index"
        cp -p "$target" "$backup"
    else
        backup='-'
    fi

    printf '%s\t%s\n' "$path" "$backup" >>"$work/backups.tsv"
}

replace_file() {
    source=$1
    target=$2
    mkdir -p "$(dirname "$target")"
    staged="${target}.reconcile.$$"
    rm -f "$staged"

    if ! cp "$source" "$staged"; then
        rm -f "$staged"
        fail "could not stage managed file: $target"
    fi
    if ! chmod 0644 "$staged"; then
        rm -f "$staged"
        fail "could not set managed file mode: $target"
    fi
    if ! mv -f "$staged" "$target"; then
        rm -f "$staged"
        fail "could not install managed file: $target"
    fi
}

transaction_has_changes() {
    while IFS="$(printf '\t')" read -r path backup || [ -n "${path:-}" ]; do
        [ -n "${path:-}" ] || continue
        target=$(root_path "$path")
        if [ "$backup" = '-' ]; then
            if [ -e "$target" ] || [ -L "$target" ]; then
                return 0
            fi
        else
            if [ ! -f "$target" ] || [ -L "$target" ] || ! cmp -s "$backup" "$target"; then
                return 0
            fi
        fi
    done <"$work/backups.tsv"
    return 1
}

acquire_lock
work=$(mktemp -d /tmp/nginx-telego-reconcile.XXXXXX)
: >"$work/backups.tsv"

[ -x "$FILES_BIN" ] || fail "ownership helper not found: $FILES_BIN"
[ -x "$RENDER_BIN" ] || fail "renderer not found: $RENDER_BIN"

NGINX_TELEGO_ROOT="$ROOT" \
NGINX_TELEGO_MANIFEST="$MANIFEST" \
    "$FILES_BIN" validate

NGINX_TELEGO_ROOT="$ROOT" \
NGINX_TELEGO_MANIFEST="$MANIFEST" \
    "$FILES_BIN" status >"$work/status.tsv"

core_count=0
locations_count=0
ingress_count=0
fallback_count=0

while IFS="$(printf '\t')" read -r path role ownership presence state source || [ -n "${path:-}" ]; do
    [ -n "${path:-}" ] || continue

    case "$role" in
        core) core_count=$((core_count + 1)) ;;
        locations) locations_count=$((locations_count + 1)) ;;
        ingress) ingress_count=$((ingress_count + 1)) ;;
        fallback) fallback_count=$((fallback_count + 1)) ;;
    esac

    case "$ownership" in
        package)
            case "$state" in
                ok) ;;
                modified|missing)
                    record_backup "$path"
                    ;;
                invalid-type)
                    fail "$path has an unsafe active file type; automatic repair was not attempted"
                    ;;
                source-missing|source-invalid-type)
                    fail "$path cannot be repaired because its canonical package source is $state"
                    ;;
                *) fail "unsupported package-owned state '$state' for $path" ;;
            esac
            ;;
        generated)
            case "$state" in
                managed|absent)
                    record_backup "$path"
                    ;;
                foreign)
                    ;;
                invalid-type)
                    fail "$path has an unsafe generated-path type; refusing reconciliation"
                    ;;
                *) fail "unsupported generated state '$state' for $path" ;;
            esac
            ;;
        *) fail "unsupported ownership '$ownership' for $path" ;;
    esac
done <"$work/status.tsv"

[ "$core_count" -eq 1 ] || fail "ownership registry must contain exactly one core role (found $core_count)"
[ "$locations_count" -eq 1 ] || fail "ownership registry must contain exactly one locations role (found $locations_count)"
[ "$ingress_count" -eq 1 ] || fail "ownership registry must contain exactly one ingress role (found $ingress_count)"
[ "$fallback_count" -eq 1 ] || fail "ownership registry must contain exactly one fallback role (found $fallback_count)"

# P7 v2 migrates the old combined generated file only when its ownership marker
# proves it came from nginx-telego. A foreign regular file is preserved; a
# symlink/directory/FIFO is rejected before any managed state is changed.
if [ -L "$LEGACY_OUTPUT" ]; then
    fail "$LEGACY_OUTPUT_PATH has an unsafe legacy generated-path type; refusing migration"
elif [ -e "$LEGACY_OUTPUT" ] && [ ! -f "$LEGACY_OUTPUT" ]; then
    fail "$LEGACY_OUTPUT_PATH has an unsafe legacy generated-path type; refusing migration"
elif [ -f "$LEGACY_OUTPUT" ] && grep -Fqx "$MANAGED_MARKER" "$LEGACY_OUTPUT" 2>/dev/null; then
    record_backup "$LEGACY_OUTPUT_PATH"
    legacy_remove=1
fi

tx_active=1

while IFS="$(printf '\t')" read -r path role ownership presence state source || [ -n "${path:-}" ]; do
    [ "$ownership" = package ] || continue
    case "$state" in
        modified|missing)
            canonical=$(root_path "$source")
            target=$(root_path "$path")
            replace_file "$canonical" "$target"
            ;;
    esac
done <"$work/status.tsv"

if [ "$legacy_remove" -eq 1 ]; then
    rm -f "$LEGACY_OUTPUT"
fi

if ! UCI_BIN="$UCI_BIN" \
     NGINX_BIN="$NGINX_BIN" \
     NGINX_CONF="$NGINX_CONF" \
     NGINX_INIT="$NGINX_INIT" \
     NGINX_UCI_CONFIG="$NGINX_UCI_CONFIG" \
     NGINX_TELEGO_CONF_DIR="$CONF_DIR" \
     NGINX_TELEGO_INGRESS_OUTPUT="$INGRESS_OUTPUT" \
     NGINX_TELEGO_FALLBACK_OUTPUT="$FALLBACK_OUTPUT" \
     NGINX_TELEGO_LEGACY_OUTPUT="$LEGACY_OUTPUT" \
     "$RENDER_BIN" --no-reload; then
    echo 'nginx-telego-reconcile: renderer rejected the desired state' >&2
    exit 1
fi

if ! nginx_test; then
    echo 'nginx-telego-reconcile: final nginx -t failed; restoring previous managed state' >&2
    exit 1
fi

changed=0
if transaction_has_changes; then
    changed=1
fi

if [ "$changed" -eq 1 ]; then
    if ! reload_nginx; then
        echo 'nginx-telego-reconcile: nginx reload failed; restoring previous managed state' >&2
        exit 1
    fi
fi

tx_active=0

if [ "$changed" -eq 1 ]; then
    echo 'nginx-telego-reconcile: managed Nginx state reconciled successfully'
else
    echo 'nginx-telego-reconcile: managed Nginx state already matches desired state'
fi

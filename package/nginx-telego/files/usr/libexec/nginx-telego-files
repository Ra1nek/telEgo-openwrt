#!/bin/sh
# Inspect nginx-telego-owned Nginx files without modifying them.
#
# P6 establishes explicit ownership and drift classification. P7 extends that
# contract to the final core/ingress/fallback layout and role-specific generated
# ownership markers while keeping this helper read-only.
set -eu

ROOT=${NGINX_TELEGO_ROOT:-}
MANIFEST=${NGINX_TELEGO_MANIFEST:-${ROOT}/usr/share/nginx-telego/ownership.tsv}
MANAGED_MARKER='# Generated by /usr/libexec/nginx-telego-render from /etc/config/nginx_telego.'
INGRESS_ROLE_MARKER='# nginx-telego-role: ingress'
FALLBACK_ROLE_MARKER='# nginx-telego-role: fallback'
LEGACY_INGRESS_ROLE_MARKER='# Role: ingress. Do not edit this file directly.'
LEGACY_FALLBACK_ROLE_MARKER='# Role: fallback. Do not edit this file directly.'

fail() {
    echo "nginx-telego-files: $*" >&2
    exit 2
}

case "$ROOT" in
    ''|/*) ;;
    *) fail 'NGINX_TELEGO_ROOT must be empty or an absolute path' ;;
esac

resolve_path() {
    value=$1
    case "$value" in
        /*) printf '%s%s' "$ROOT" "$value" ;;
        *) fail "manifest path is not absolute: $value" ;;
    esac
}

validate_clean_absolute_path() {
    value=$1
    label=$2

    case "$value" in
        /*) ;;
        *) fail "$label must be absolute: $value" ;;
    esac

    case "$value" in
        *'//'*) fail "$label contains an empty path segment: $value" ;;
        *'/../'*|*/..|*'/./'*|*/.) fail "$label contains dot traversal: $value" ;;
    esac
}

validate_conf_d_path() {
    value=$1
    validate_clean_absolute_path "$value" 'managed path'
    case "$value" in
        /etc/nginx/conf.d/*.conf) ;;
        *) fail "managed conf.d path must be /etc/nginx/conf.d/*.conf: $value" ;;
    esac
    relative=${value#/etc/nginx/conf.d/}
    case "$relative" in
        ''|*/*) fail "managed conf.d path must name one direct child: $value" ;;
    esac
}

validate_snippet_path() {
    value=$1
    validate_clean_absolute_path "$value" 'managed path'
    case "$value" in
        /etc/nginx/snippets/?*) ;;
        *) fail "managed snippet path must be under /etc/nginx/snippets/: $value" ;;
    esac
    relative=${value#/etc/nginx/snippets/}
    case "$relative" in
        ''|*/*) fail "managed snippet path must name one direct child: $value" ;;
    esac
}

validate_template_path() {
    value=$1
    validate_clean_absolute_path "$value" 'package source'
    case "$value" in
        /usr/share/nginx-telego/templates/?*) ;;
        *) fail "package source must be under /usr/share/nginx-telego/templates/: $value" ;;
    esac
    relative=${value#/usr/share/nginx-telego/templates/}
    case "$relative" in
        ''|*/*) fail "package source must name one direct template: $value" ;;
    esac
}

validate_role_contract() {
    path=$1
    role=$2
    ownership=$3
    presence=$4
    source=$5
    line_no=$6

    case "$role" in
        core)
            [ "$ownership" = package ] || fail "core role must be package-owned at $MANIFEST:$line_no"
            [ "$presence" = required ] || fail "core role must be required at $MANIFEST:$line_no"
            validate_conf_d_path "$path"
            validate_template_path "$source"
            ;;
        locations)
            [ "$ownership" = package ] || fail "locations role must be package-owned at $MANIFEST:$line_no"
            [ "$presence" = required ] || fail "locations role must be required at $MANIFEST:$line_no"
            validate_snippet_path "$path"
            validate_template_path "$source"
            ;;
        ingress|fallback)
            [ "$ownership" = generated ] || fail "$role role must be generated at $MANIFEST:$line_no"
            [ "$presence" = conditional ] || fail "$role role must be conditional at $MANIFEST:$line_no"
            validate_conf_d_path "$path"
            [ "$source" = renderer ] || fail "generated source must be 'renderer' at $MANIFEST:$line_no"
            ;;
        *) fail "invalid role '$role' at $MANIFEST:$line_no" ;;
    esac
}

validate_manifest() {
    [ -r "$MANIFEST" ] || fail "ownership registry is not readable: $MANIFEST"

    seen=$(mktemp /tmp/nginx-telego-ownership.XXXXXX)
    trap 'rm -f "$seen"' EXIT INT TERM

    line_no=0
    while IFS="$(printf '\t')" read -r path role ownership presence source extra || [ -n "${path:-}" ]; do
        line_no=$((line_no + 1))
        case "${path:-}" in
            ''|'#'*) continue ;;
        esac

        [ -z "${extra:-}" ] || fail "invalid extra field at $MANIFEST:$line_no"
        [ -n "${role:-}" ] || fail "missing role at $MANIFEST:$line_no"
        [ -n "${ownership:-}" ] || fail "missing ownership at $MANIFEST:$line_no"
        [ -n "${presence:-}" ] || fail "missing presence at $MANIFEST:$line_no"
        [ -n "${source:-}" ] || fail "missing source at $MANIFEST:$line_no"

        case "$ownership" in
            package|generated) ;;
            *) fail "invalid ownership '$ownership' at $MANIFEST:$line_no" ;;
        esac
        case "$presence" in
            required|conditional) ;;
            *) fail "invalid presence '$presence' at $MANIFEST:$line_no" ;;
        esac

        validate_role_contract "$path" "$role" "$ownership" "$presence" "$source" "$line_no"

        if grep -Fqx "$path" "$seen" 2>/dev/null; then
            fail "duplicate managed path in ownership registry: $path"
        fi
        printf '%s\n' "$path" >>"$seen"
    done <"$MANIFEST"

    rm -f "$seen"
    trap - EXIT INT TERM
}

role_marker() {
    case "$1" in
        ingress) printf '%s' "$INGRESS_ROLE_MARKER" ;;
        fallback) printf '%s' "$FALLBACK_ROLE_MARKER" ;;
        *) return 1 ;;
    esac
}

is_generated_owned() {
    target=$1
    role=$2
    marker=$(role_marker "$role") || return 1
    grep -Fqx "$MANAGED_MARKER" "$target" 2>/dev/null || return 1
    if grep -Fqx "$marker" "$target" 2>/dev/null; then
        return 0
    fi
    case "$role" in
        ingress) grep -Fqx "$LEGACY_INGRESS_ROLE_MARKER" "$target" 2>/dev/null ;;
        fallback) grep -Fqx "$LEGACY_FALLBACK_ROLE_MARKER" "$target" 2>/dev/null ;;
        *) return 1 ;;
    esac
}

emit_status() {
    while IFS="$(printf '\t')" read -r path role ownership presence source extra || [ -n "${path:-}" ]; do
        case "${path:-}" in
            ''|'#'*) continue ;;
        esac

        target=$(resolve_path "$path")
        state=''

        if [ "$ownership" = package ]; then
            canonical=$(resolve_path "$source")

            if [ -L "$canonical" ]; then
                state=source-invalid-type
            elif [ ! -e "$canonical" ]; then
                state=source-missing
            elif [ ! -f "$canonical" ]; then
                state=source-invalid-type
            elif [ -L "$target" ]; then
                state=invalid-type
            elif [ ! -e "$target" ]; then
                state=missing
            elif [ ! -f "$target" ]; then
                state=invalid-type
            elif cmp -s "$canonical" "$target"; then
                state=ok
            else
                state=modified
            fi
        else
            if [ -L "$target" ]; then
                state=invalid-type
            elif [ ! -e "$target" ]; then
                state=absent
            elif [ ! -f "$target" ]; then
                state=invalid-type
            elif is_generated_owned "$target" "$role"; then
                state=managed
            else
                state=foreign
            fi
        fi

        printf '%s\t%s\t%s\t%s\t%s\t%s\n' \
            "$path" "$role" "$ownership" "$presence" "$state" "$source"
    done <"$MANIFEST"
}

case "${1:-status}" in
    status)
        validate_manifest
        emit_status
        ;;
    list)
        validate_manifest
        cat "$MANIFEST"
        ;;
    validate)
        validate_manifest
        ;;
    *)
        echo 'Usage: nginx-telego-files [status|list|validate]' >&2
        exit 2
        ;;
esac

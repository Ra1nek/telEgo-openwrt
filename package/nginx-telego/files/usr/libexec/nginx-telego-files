#!/bin/sh
# Inspect nginx-telego owned Nginx files without modifying them.
#
# This helper is intentionally read-only. P6 establishes explicit ownership and
# drift classification; reconciliation/repair actions are added in later stages.
set -eu

ROOT=${NGINX_TELEGO_ROOT:-}
MANIFEST=${NGINX_TELEGO_MANIFEST:-${ROOT}/usr/share/nginx-telego/ownership.tsv}
MANAGED_MARKER='# Generated by /usr/libexec/nginx-telego-render from /etc/config/nginx_telego.'

fail() {
    echo "nginx-telego-files: $*" >&2
    exit 2
}

case "$ROOT" in
    ''|/*) ;;
    *) fail 'NGINX_TELEGO_ROOT must be empty or an absolute path' ;;
esac

resolve_path() {
    value=$1
    case "$value" in
        /*) printf '%s%s' "$ROOT" "$value" ;;
        *) fail "manifest path is not absolute: $value" ;;
    esac
}

validate_manifest() {
    [ -r "$MANIFEST" ] || fail "ownership registry is not readable: $MANIFEST"

    seen=$(mktemp /tmp/nginx-telego-ownership.XXXXXX)
    trap 'rm -f "$seen"' EXIT INT TERM

    line_no=0
    while IFS="$(printf '\t')" read -r path role ownership presence source extra || [ -n "${path:-}" ]; do
        line_no=$((line_no + 1))
        case "${path:-}" in
            ''|'#'*) continue ;;
        esac

        [ -z "${extra:-}" ] || fail "invalid extra field at $MANIFEST:$line_no"
        case "$path" in /*) ;; *) fail "path must be absolute at $MANIFEST:$line_no" ;; esac
        [ -n "$role" ] || fail "missing role at $MANIFEST:$line_no"

        case "$ownership" in
            package|generated) ;;
            *) fail "invalid ownership '$ownership' at $MANIFEST:$line_no" ;;
        esac
        case "$presence" in
            required|conditional) ;;
            *) fail "invalid presence '$presence' at $MANIFEST:$line_no" ;;
        esac

        if [ "$ownership" = package ]; then
            case "$source" in /*) ;; *) fail "package source must be absolute at $MANIFEST:$line_no" ;; esac
        else
            [ "$source" = renderer ] || fail "generated source must be 'renderer' at $MANIFEST:$line_no"
        fi

        if grep -Fqx "$path" "$seen" 2>/dev/null; then
            fail "duplicate managed path in ownership registry: $path"
        fi
        printf '%s\n' "$path" >>"$seen"
    done <"$MANIFEST"

    rm -f "$seen"
    trap - EXIT INT TERM
}

emit_status() {
    while IFS="$(printf '\t')" read -r path role ownership presence source extra || [ -n "${path:-}" ]; do
        case "${path:-}" in
            ''|'#'*) continue ;;
        esac

        target=$(resolve_path "$path")
        state=''

        if [ "$ownership" = package ]; then
            canonical=$(resolve_path "$source")
            if [ ! -e "$target" ]; then
                state=missing
            elif [ ! -f "$target" ] || [ -L "$target" ]; then
                state=invalid-type
            elif [ ! -f "$canonical" ] || [ -L "$canonical" ]; then
                state=source-missing
            elif cmp -s "$canonical" "$target"; then
                state=ok
            else
                state=modified
            fi
        else
            if [ ! -e "$target" ]; then
                state=absent
            elif [ ! -f "$target" ] || [ -L "$target" ]; then
                state=invalid-type
            elif grep -Fqx "$MANAGED_MARKER" "$target" 2>/dev/null; then
                state=managed
            else
                state=foreign
            fi
        fi

        printf '%s\t%s\t%s\t%s\t%s\t%s\n' \
            "$path" "$role" "$ownership" "$presence" "$state" "$source"
    done <"$MANIFEST"
}

case "${1:-status}" in
    status)
        validate_manifest
        emit_status
        ;;
    list)
        validate_manifest
        cat "$MANIFEST"
        ;;
    validate)
        validate_manifest
        ;;
    *)
        echo 'Usage: nginx-telego-files [status|list|validate]' >&2
        exit 2
        ;;
esac

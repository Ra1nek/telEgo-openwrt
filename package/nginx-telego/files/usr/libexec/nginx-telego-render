#!/bin/sh
# Render optional telEgo Nginx ingress profiles from /etc/config/nginx_telego.
# Generated ingress and fallback state use separate role-owned paths.
set -eu

UCI_BIN=${UCI_BIN:-/sbin/uci}
NGINX_BIN=${NGINX_BIN:-/usr/sbin/nginx}
NGINX_CONF=${NGINX_CONF:-/etc/nginx/uci.conf}
NGINX_INIT=${NGINX_INIT:-/etc/init.d/nginx}
NGINX_UCI_CONFIG=${NGINX_UCI_CONFIG:-/etc/config/nginx}
CONF_DIR=${NGINX_TELEGO_CONF_DIR:-/etc/nginx/conf.d}
INGRESS_OUTPUT=${NGINX_TELEGO_INGRESS_OUTPUT:-$CONF_DIR/80-telego-ingress.conf}
FALLBACK_OUTPUT=${NGINX_TELEGO_FALLBACK_OUTPUT:-$CONF_DIR/85-telego-fallback.conf}
MANAGED_MARKER='# Generated by /usr/libexec/nginx-telego-render from /etc/config/nginx_telego.'
INGRESS_ROLE_MARKER='# nginx-telego-role: ingress'
FALLBACK_ROLE_MARKER='# nginx-telego-role: fallback'
RELOAD=1
MODE=apply
mode_seen=0

usage() {
    echo "Usage: $0 [apply|remove] [--no-reload]" >&2
    exit 2
}

for arg in "$@"; do
    case "$arg" in
        apply)
            [ "$mode_seen" -eq 0 ] || usage
            MODE=apply
            mode_seen=1
            ;;
        remove)
            [ "$mode_seen" -eq 0 ] || usage
            MODE=remove
            mode_seen=1
            ;;
        --no-reload)
            RELOAD=0
            ;;
        *) usage ;;
    esac
done

fail() {
    echo "nginx-telego: $*" >&2
    exit 1
}

uci_get() {
    package=$1
    section=$2
    option=$3
    default=$4
    value=$($UCI_BIN -q get "$package.$section.$option" 2>/dev/null || true)
    [ -n "$value" ] || value=$default
    printf '%s' "$value"
}

is_enabled() {
    case "$1" in
        1|true|yes|on) return 0 ;;
        *) return 1 ;;
    esac
}

validate_hsts_max_age() {
    value=$1
    case "$value" in
        ''|*[!0-9]*) fail "Direct HTTPS HSTS max-age must be an integer number of seconds: $value" ;;
    esac
    [ "$value" -le 63072000 ] 2>/dev/null ||
        fail "Direct HTTPS HSTS max-age must be between 0 and 63072000 seconds: $value"
}

role_marker() {
    case "$1" in
        ingress) printf '%s' "$INGRESS_ROLE_MARKER" ;;
        fallback) printf '%s' "$FALLBACK_ROLE_MARKER" ;;
        *) return 1 ;;
    esac
}

is_managed_file() {
    file=$1
    role=$2
    marker=$(role_marker "$role") || return 1
    [ -f "$file" ] && [ ! -L "$file" ] || return 1
    grep -Fqx "$MANAGED_MARKER" "$file" 2>/dev/null || return 1
    grep -Fqx "$marker" "$file" 2>/dev/null
}

validate_hostname() {
    value=$1
    label=$2
    [ -n "$value" ] || fail "$label is required"
    [ "${#value}" -le 253 ] || fail "$label is too long"
    case "$value" in
        .*|*..*|*.) fail "$label must be a DNS hostname" ;;
    esac

    old_ifs=$IFS
    IFS=.
    set -- $value
    IFS=$old_ifs
    [ "$#" -gt 0 ] || fail "$label must be a DNS hostname"
    for dns_label in "$@"; do
        [ -n "$dns_label" ] || fail "$label contains an empty DNS label"
        [ "${#dns_label}" -le 63 ] || fail "$label contains a DNS label longer than 63 characters"
        case "$dns_label" in
            *[!A-Za-z0-9-]*|-*|*-) fail "$label must be a DNS hostname" ;;
        esac
    done
}

validate_path() {
    value=$1
    label=$2
    case "$value" in
        /*) ;;
        *) fail "$label must be an absolute path" ;;
    esac
    case "$value" in
        *[!A-Za-z0-9_./+-]*) fail "$label contains unsupported characters" ;;
    esac
    [ -r "$value" ] || fail "$label is not readable: $value"
}

validate_tls_material() {
    certificate=$1
    certificate_key=$2
    label=$3

    validate_path "$certificate" "$label TLS certificate"
    validate_path "$certificate_key" "$label TLS private key"

    # -f deliberately follows symlinks: ACME clients commonly publish stable
    # certificate paths as symlinks to the current renewal generation.
    [ -f "$certificate" ] ||
        fail "$label TLS certificate must resolve to a regular file: $certificate"
    [ -f "$certificate_key" ] ||
        fail "$label TLS private key must resolve to a regular file: $certificate_key"
    [ "$certificate" != "$certificate_key" ] ||
        fail "$label TLS certificate and private key must use different files"

    grep -Fqx -- '-----BEGIN CERTIFICATE-----' "$certificate" 2>/dev/null &&
        grep -Fqx -- '-----END CERTIFICATE-----' "$certificate" 2>/dev/null ||
        fail "$label TLS certificate is not PEM encoded: $certificate"
    grep -Eq '^-----BEGIN (RSA |EC )?PRIVATE KEY-----$' "$certificate_key" 2>/dev/null &&
        grep -Eq '^-----END (RSA |EC )?PRIVATE KEY-----$' "$certificate_key" 2>/dev/null ||
        fail "$label TLS private key is not an unencrypted PEM private key: $certificate_key"
}

list_has_word() {
    list=" $1 "
    word=$2
    case "$list" in
        *" $word "*) return 0 ;;
        *) return 1 ;;
    esac
}

validate_web_contract() {
    expected_hostname=$1
    profile=$2

    service_enabled=$(uci_get telego general enabled 0)
    is_enabled "$service_enabled" || fail "$profile requires telego.general.enabled=1"

    web_enabled=$(uci_get telego web_proxy enabled 0)
    is_enabled "$web_enabled" || fail "$profile requires telego.web_proxy.enabled=1"

    web_hostname=$(uci_get telego web_proxy hostname '')
    [ "$web_hostname" = "$expected_hostname" ] ||
        fail "$profile hostname must match telego.web_proxy.hostname ($expected_hostname)"

    web_bind=$(uci_get telego web_proxy bind_to '127.0.0.1:8080')
    case "$web_bind" in
        127.0.0.1:8080|tcp://127.0.0.1:8080) ;;
        *) fail "$profile requires telego.web_proxy.bind_to=127.0.0.1:8080" ;;
    esac

    trusted=$(uci_get telego web_proxy trusted_proxy_cidrs '')
    list_has_word "$trusted" '127.0.0.1/32' ||
        fail "$profile requires 127.0.0.1/32 in telego.web_proxy.trusted_proxy_cidrs"
}

validate_direct_https_contract() {
    hostname=$1
    validate_web_contract "$hostname" 'Direct HTTPS ingress'

    # Direct HTTPS dedicates TCP/443 to the Nginx WEB edge on both LAN and WAN.
    # LuCI/uhttpd is moved to a separate management port by the platform
    # reconciler. Operators who need MTProxy and WEB on the same public 443
    # must use Native Shared-Port instead.
    public_bind=$(uci_get telego general bind_to '0.0.0.0:443')
    case "$public_bind" in
        *:443)
            fail 'Direct HTTPS reserves TCP/443 for WEB/Nginx on LAN and WAN; move telego.general.bind_to to another port (for example 0.0.0.0:9443), or use Native Shared-Port to share public TCP/443'
            ;;
    esac
}

validate_shared_contract() {
    hostname=$1
    validate_web_contract "$hostname" 'native shared-port ingress'

    tls_enabled=$(uci_get telego tls_fronting enabled 1)
    case "$tls_enabled" in
        1|true|yes|on) ;;
        *) fail 'native shared-port ingress requires telego.tls_fronting.enabled=1' ;;
    esac

    public_bind=$(uci_get telego general bind_to '0.0.0.0:443')
    case "$public_bind" in
        *:443) ;;
        *) fail 'native shared-port ingress requires the public telEgo listener on TCP port 443' ;;
    esac

    mask_host=$(uci_get telego tls_fronting mask_host '')
    [ "$mask_host" = "$hostname" ] ||
        fail 'native shared-port ingress requires tls_fronting.mask_host to match the WEB hostname'

    cert_host=$(uci_get telego tls_fronting cert_host '')
    cert_port=$(uci_get telego tls_fronting cert_port '')
    splice_host=$(uci_get telego tls_fronting splice_host '')
    splice_port=$(uci_get telego tls_fronting splice_port '')
    splice_proxy=$(uci_get telego tls_fronting splice_proxy_protocol 0)

    [ "$cert_host" = '127.0.0.1' ] ||
        fail 'native shared-port ingress requires tls_fronting.cert_host=127.0.0.1'
    [ "$cert_port" = '8444' ] ||
        fail 'native shared-port ingress requires tls_fronting.cert_port=8444'
    [ "$splice_host" = '127.0.0.1' ] ||
        fail 'native shared-port ingress requires tls_fronting.splice_host=127.0.0.1'
    [ "$splice_port" = '8443' ] ||
        fail 'native shared-port ingress requires tls_fronting.splice_port=8443'
    [ "$splice_proxy" = '2' ] ||
        fail 'native shared-port ingress requires tls_fronting.splice_proxy_protocol=2'
}

is_current_managed_output() {
    file=$1
    case "$file" in
        "$INGRESS_OUTPUT") is_managed_file "$file" ingress ;;
        "$FALLBACK_OUTPUT") is_managed_file "$file" fallback ;;
        *) return 1 ;;
    esac
}

port_conflict() {
    port=$1
    for file in "$CONF_DIR"/*.conf; do
        [ -e "$file" ] || [ -L "$file" ] || continue
        if is_current_managed_output "$file"; then
            continue
        fi
        if [ -f "$file" ] && grep -Eq "listen[[:space:]]+([^;[:space:]]*:)?${port}([[:space:]]|;)" "$file"; then
            echo "$file"
            return 0
        fi
    done

    if [ -r "$NGINX_UCI_CONFIG" ] &&
       awk -v port="$port" '
            /^[[:space:]]*config[[:space:]]+/ {
                active = ($2 == "server")
                next
            }
            active && /^[[:space:]]*(option|list)[[:space:]]+listen[[:space:]]+/ {
                line = $0
                sub(/^[[:space:]]*(option|list)[[:space:]]+listen[[:space:]]+/, "", line)
                if (line ~ "(^|[^0-9])" port "([^0-9]|$)") {
                    found = 1
                    exit
                }
            }
            END { exit found ? 0 : 1 }
        ' "$NGINX_UCI_CONFIG"; then
        echo "$NGINX_UCI_CONFIG"
        return 0
    fi
    return 1
}

check_port_free() {
    port=$1
    purpose=$2
    conflict=$(port_conflict "$port" || true)
    [ -z "$conflict" ] || fail "$purpose port 127.0.0.1:$port is already configured in $conflict; keep either the existing listener or the managed profile, not both"
}

nginx_test() {
    [ -x "$NGINX_BIN" ] || fail "nginx executable not found: $NGINX_BIN"
    [ -r "$NGINX_CONF" ] || fail "nginx configuration not found: $NGINX_CONF"
    "$NGINX_BIN" -t -c "$NGINX_CONF"
}

reload_nginx() {
    [ "$RELOAD" -eq 1 ] || return 0
    [ -x "$NGINX_INIT" ] || return 0
    if "$NGINX_INIT" status >/dev/null 2>&1; then
        "$NGINX_INIT" reload
    fi
}

work=$(mktemp -d /tmp/nginx-telego-render.XXXXXX)
TX_ACTIVE=0
CHANGED=0

snapshot_path() {
    path=$1
    key=$2
    role=$3

    if [ -L "$path" ]; then
        fail "refusing to manage symlink path: $path"
    elif [ -e "$path" ] && [ ! -f "$path" ]; then
        fail "refusing to manage non-regular path: $path"
    elif [ -f "$path" ]; then
        owned=0
        is_managed_file "$path" "$role" && owned=1
        if [ "$owned" -eq 1 ]; then
            cp -p "$path" "$work/$key.backup"
            printf '%s\n' managed >"$work/$key.state"
        else
            printf '%s\n' foreign >"$work/$key.state"
        fi
    else
        printf '%s\n' absent >"$work/$key.state"
    fi
}

restore_path() {
    path=$1
    key=$2
    state=$(cat "$work/$key.state")
    case "$state" in
        managed)
            mkdir -p "$(dirname "$path")"
            cp -p "$work/$key.backup" "$path"
            ;;
        absent)
            rm -f "$path"
            ;;
        foreign)
            ;;
    esac
}

restore_transaction() {
    restore_path "$INGRESS_OUTPUT" ingress
    restore_path "$FALLBACK_OUTPUT" fallback
}

cleanup() {
    rc=$?
    trap - EXIT HUP INT TERM
    if [ "$TX_ACTIVE" -eq 1 ]; then
        restore_transaction || true
        echo 'nginx-telego: generated-file transaction rolled back' >&2
    fi
    rm -rf "$work"
    exit "$rc"
}

trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM

apply_desired() {
    output=$1
    candidate=$2
    desired=$3
    key=$4
    state=$(cat "$work/$key.state")

    if [ "$desired" -eq 1 ]; then
        [ "$state" != foreign ] || fail "$output already exists but is not owned by nginx-telego; it was left unchanged"
        if [ "$state" = managed ] && cmp -s "$candidate" "$output"; then
            return 0
        fi
        mkdir -p "$(dirname "$output")"
        staged="${output}.new.$$"
        rm -f "$staged"
        cp "$candidate" "$staged"
        chmod 0644 "$staged"
        mv -f "$staged" "$output"
        CHANGED=1
    else
        case "$state" in
            managed)
                rm -f "$output"
                CHANGED=1
                ;;
            absent|foreign)
                ;;
        esac
    fi
}

snapshot_path "$INGRESS_OUTPUT" ingress ingress
snapshot_path "$FALLBACK_OUTPUT" fallback fallback

if [ "$MODE" = remove ]; then
    TX_ACTIVE=1
    apply_desired "$INGRESS_OUTPUT" '' 0 ingress
    apply_desired "$FALLBACK_OUTPUT" '' 0 fallback
    if ! nginx_test; then
        echo 'nginx-telego: generated configuration removal failed nginx -t' >&2
        exit 1
    fi
    if [ "$CHANGED" -eq 1 ] && ! reload_nginx; then
        echo 'nginx-telego: nginx reload failed after generated configuration removal' >&2
        exit 1
    fi
    TX_ACTIVE=0
    echo 'nginx-telego: managed generated Nginx files removed'
    exit 0
fi

shared_enabled=$(uci_get nginx_telego shared enabled 0)
cloudflare_enabled=$(uci_get nginx_telego cloudflare enabled 0)
direct_https_enabled=$(uci_get nginx_telego direct_https enabled 0)
manage_fallback=$(uci_get nginx_telego fallback manage 1)

desired_ingress=0
desired_fallback=0
enabled_profiles=0
is_enabled "$shared_enabled" && enabled_profiles=$((enabled_profiles + 1))
is_enabled "$cloudflare_enabled" && enabled_profiles=$((enabled_profiles + 1))
is_enabled "$direct_https_enabled" && enabled_profiles=$((enabled_profiles + 1))

[ "$enabled_profiles" -le 1 ] ||
    fail 'choose exactly one managed ingress profile: native shared-port, Cloudflare, or Direct HTTPS'

if [ "$enabled_profiles" -eq 1 ]; then
    desired_ingress=1
    if is_enabled "$manage_fallback"; then
        desired_fallback=1
    fi
fi

web_hostname=$(uci_get telego web_proxy hostname '')
shared_hostname=$(uci_get nginx_telego shared hostname "$web_hostname")
cloudflare_hostname=$(uci_get nginx_telego cloudflare hostname "$web_hostname")
direct_https_hostname=$(uci_get nginx_telego direct_https hostname "$web_hostname")

if is_enabled "$shared_enabled"; then
    validate_hostname "$shared_hostname" 'shared hostname'
    validate_shared_contract "$shared_hostname"
    shared_certificate=$(uci_get nginx_telego shared certificate '')
    shared_certificate_key=$(uci_get nginx_telego shared certificate_key '')
    validate_tls_material "$shared_certificate" "$shared_certificate_key" 'shared'
    check_port_free 8443 'shared TLS ingress'
    check_port_free 8444 'certificate source'
fi

if is_enabled "$cloudflare_enabled"; then
    validate_hostname "$cloudflare_hostname" 'Cloudflare hostname'
    validate_web_contract "$cloudflare_hostname" 'Cloudflare ingress'
    check_port_free 18080 'Cloudflare ingress'
fi

if is_enabled "$direct_https_enabled"; then
    validate_hostname "$direct_https_hostname" 'Direct HTTPS hostname'
    validate_direct_https_contract "$direct_https_hostname"
    direct_https_certificate=$(uci_get nginx_telego direct_https certificate '')
    direct_https_certificate_key=$(uci_get nginx_telego direct_https certificate_key '')
    direct_https_hsts_max_age=$(uci_get nginx_telego direct_https hsts_max_age 604800)
    validate_tls_material "$direct_https_certificate" "$direct_https_certificate_key" 'Direct HTTPS'
    validate_hsts_max_age "$direct_https_hsts_max_age"
    check_port_free 443 'Direct HTTPS ingress'
fi

if [ "$desired_fallback" -eq 1 ]; then
    check_port_free 8090 'fallback'
fi

ingress_candidate="$work/ingress.conf"
fallback_candidate="$work/fallback.conf"

cat >"$ingress_candidate" <<'EOF_HEADER'
# Generated by /usr/libexec/nginx-telego-render from /etc/config/nginx_telego.
# nginx-telego-role: ingress
# Do not edit this file directly.
EOF_HEADER

if is_enabled "$shared_enabled"; then
    cat >>"$ingress_candidate" <<EOF_SHARED

# Native shared-port ingress: telEgo :443 -> Nginx TLS :8443 -> telEgo WEB :8080.
# Unknown SNI is rejected before it can reach the WEB fallback.
server {
    listen 127.0.0.1:8443 ssl proxy_protocol default_server;
    server_tokens off;
    ssl_reject_handshake on;
}

server {
    listen 127.0.0.1:8443 ssl proxy_protocol;
    http2 on;
    server_name $shared_hostname;
    client_max_body_size 16m;
    server_tokens off;

    ssl_certificate $shared_certificate;
    ssl_certificate_key $shared_certificate_key;
    ssl_protocols TLSv1.2 TLSv1.3;

    include /etc/nginx/snippets/telego.locations;
}

# Separate certificate source used by telEgo's FakeTLS certificate fetcher.
server {
    listen 127.0.0.1:8444 ssl default_server;
    server_tokens off;
    ssl_reject_handshake on;
}

server {
    listen 127.0.0.1:8444 ssl;
    server_name $shared_hostname;
    server_tokens off;

    ssl_certificate $shared_certificate;
    ssl_certificate_key $shared_certificate_key;
    ssl_protocols TLSv1.2 TLSv1.3;

    location / {
        return 204;
    }
}
EOF_SHARED
fi

if is_enabled "$direct_https_enabled"; then
    cat >>"$ingress_candidate" <<EOF_DIRECT_HTTPS

# Direct HTTPS dedicated endpoint: Nginx owns TCP/443 on all local addresses.
# nginx-telego-platform moves only LuCI/uhttpd HTTPS listeners that occupied
# TCP/443; administrator-managed plain HTTP (commonly :80) is left untouched.
# nginx-telego-firewall separately opens WAN TCP/443 without NAT/REDIRECT.
server {
    listen 0.0.0.0:443 ssl default_server;
    listen [::]:443 ssl default_server;
    server_tokens off;
    ssl_reject_handshake on;
}

server {
    listen 0.0.0.0:443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name $direct_https_hostname;
    client_max_body_size 16m;
    server_tokens off;

    ssl_certificate $direct_https_certificate;
    ssl_certificate_key $direct_https_certificate_key;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Staged HSTS: default is seven days. Deliberately no includeSubDomains
    # and no preload; raise max-age only after deployment acceptance.
    add_header Strict-Transport-Security "max-age=$direct_https_hsts_max_age" always;

    include /etc/nginx/snippets/telego.locations;
}
EOF_DIRECT_HTTPS
fi

if is_enabled "$cloudflare_enabled"; then
    cat >>"$ingress_candidate" <<EOF_CLOUDFLARE

# Cloudflare Tunnel ingress: cloudflared -> Nginx :18080 -> telEgo WEB :8080.
# Binding to loopback means only local processes can supply CF-Connecting-IP.
map \$http_cf_connecting_ip \$telego_cf_client_ip {
    default \$http_cf_connecting_ip;
    ''      \$remote_addr;
}

server {
    listen 127.0.0.1:18080;
    server_name $cloudflare_hostname;
    access_log off;
    server_tokens off;

    location / {
        proxy_pass http://telego_web;
        proxy_http_version 1.1;
        proxy_request_buffering on;
        proxy_buffering off;
        proxy_read_timeout 40s;
        proxy_send_timeout 40s;
        proxy_intercept_errors on;
        recursive_error_pages off;

        proxy_set_header Host \$http_host;
        proxy_set_header X-Real-IP \$telego_cf_client_ip;
        proxy_set_header X-Forwarded-For \$telego_cf_client_ip;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Forwarded "";
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection \$telego_connection_upgrade;

        error_page 418 = @telego_cf_ordinary;
        error_page 419 = @telego_cf_sanitized;
    }

    location @telego_cf_ordinary {
        internal;
        proxy_pass http://127.0.0.1:8090;
        proxy_http_version 1.1;
        proxy_set_header Host \$http_host;
        proxy_set_header X-Real-IP \$telego_cf_client_ip;
        proxy_set_header X-Forwarded-For \$telego_cf_client_ip;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection \$telego_connection_upgrade;
    }

    location @telego_cf_sanitized {
        internal;
        set \$args "";
        proxy_pass http://127.0.0.1:8090;
        proxy_http_version 1.1;
        proxy_method GET;
        proxy_pass_request_body off;

        proxy_set_header Host \$http_host;
        proxy_set_header Content-Length "";
        proxy_set_header Content-Type "";
        proxy_set_header Transfer-Encoding "";
        proxy_set_header Authorization "";
        proxy_set_header Cookie "";
        proxy_set_header X-Up-Seq "";
        proxy_set_header X-Down-Cursor "";
        proxy_set_header X-Session-Token "";
        proxy_set_header X-Carrier-Mode "";
        proxy_set_header X-Up-Ack "";
        proxy_set_header X-Lane-ID "";
        proxy_set_header Sec-WebSocket-Key "";
        proxy_set_header Sec-WebSocket-Protocol "";
        proxy_set_header Sec-WebSocket-Version "";
        proxy_set_header Sec-WebSocket-Extensions "";
        proxy_set_header CF-Connecting-IP "";
        proxy_set_header X-Real-IP "";
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Forwarded-Proto "";
        proxy_set_header Forwarded "";
        proxy_set_header Upgrade "";
        proxy_set_header Connection "";
    }
}
EOF_CLOUDFLARE
fi

cat >"$fallback_candidate" <<'EOF_FALLBACK'
# Generated by /usr/libexec/nginx-telego-render from /etc/config/nginx_telego.
# nginx-telego-role: fallback
# Do not edit this file directly.

# Minimal ordinary-site fallback used by telEgo status 418/419 handling.
server {
    listen 127.0.0.1:8090;
    server_name _;
    access_log off;
    server_tokens off;

    # These headers belong only to the ordinary fallback response. They are
    # intentionally not injected into telEgo carrier responses.
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Cache-Control "no-store" always;

    location / {
        default_type text/plain;
        return 200 "OK\n";
    }
}
EOF_FALLBACK

TX_ACTIVE=1
apply_desired "$INGRESS_OUTPUT" "$ingress_candidate" "$desired_ingress" ingress
apply_desired "$FALLBACK_OUTPUT" "$fallback_candidate" "$desired_fallback" fallback

if ! nginx_test; then
    echo 'nginx-telego: generated configuration failed nginx -t' >&2
    exit 1
fi

if [ "$CHANGED" -eq 1 ] && ! reload_nginx; then
    echo 'nginx-telego: nginx reload failed after generated configuration update' >&2
    exit 1
fi

TX_ACTIVE=0

if [ "$CHANGED" -eq 1 ]; then
    echo "nginx-telego: managed Nginx files updated: $INGRESS_OUTPUT $FALLBACK_OUTPUT"
else
    echo 'nginx-telego: managed Nginx files already match desired state'
fi

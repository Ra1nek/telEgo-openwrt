#!/bin/sh
# Render optional telEgo Nginx ingress profiles from /etc/config/nginx_telego.
# Existing hand-written files are never modified.
set -eu

UCI_BIN=${UCI_BIN:-/sbin/uci}
NGINX_BIN=${NGINX_BIN:-/usr/sbin/nginx}
NGINX_CONF=${NGINX_CONF:-/etc/nginx/uci.conf}
NGINX_INIT=${NGINX_INIT:-/etc/init.d/nginx}
NGINX_UCI_CONFIG=${NGINX_UCI_CONFIG:-/etc/config/nginx}
CONF_DIR=${NGINX_TELEGO_CONF_DIR:-/etc/nginx/conf.d}
OUTPUT=${NGINX_TELEGO_OUTPUT:-$CONF_DIR/zz-telego-managed.conf}
MANAGED_MARKER='# Generated by /usr/libexec/nginx-telego-render from /etc/config/nginx_telego.'
RELOAD=1
MODE=apply

case "${1:-apply}" in
    apply) ;;
    --no-reload) RELOAD=0 ;;
    remove) MODE=remove ;;
    *)
        echo "Usage: $0 [apply|--no-reload|remove]" >&2
        exit 2
        ;;
esac

fail() {
    echo "nginx-telego: $*" >&2
    exit 1
}

uci_get() {
    package=$1
    section=$2
    option=$3
    default=$4
    value=$($UCI_BIN -q get "$package.$section.$option" 2>/dev/null || true)
    [ -n "$value" ] || value=$default
    printf '%s' "$value"
}

is_enabled() {
    case "$1" in
        1|true|yes|on) return 0 ;;
        *) return 1 ;;
    esac
}

is_managed_output() {
    [ -f "$OUTPUT" ] && grep -Fqx "$MANAGED_MARKER" "$OUTPUT" 2>/dev/null
}

validate_hostname() {
    value=$1
    label=$2
    [ -n "$value" ] || fail "$label is required"
    [ "${#value}" -le 253 ] || fail "$label is too long"
    case "$value" in
        .*|*..*|*.) fail "$label must be a DNS hostname" ;;
    esac

    old_ifs=$IFS
    IFS=.
    set -- $value
    IFS=$old_ifs
    [ "$#" -gt 0 ] || fail "$label must be a DNS hostname"
    for dns_label in "$@"; do
        [ -n "$dns_label" ] || fail "$label contains an empty DNS label"
        [ "${#dns_label}" -le 63 ] || fail "$label contains a DNS label longer than 63 characters"
        case "$dns_label" in
            *[!A-Za-z0-9-]*|-*|*-) fail "$label must be a DNS hostname" ;;
        esac
    done
}

validate_path() {
    value=$1
    label=$2
    case "$value" in
        /*) ;;
        *) fail "$label must be an absolute path" ;;
    esac
    case "$value" in
        *[!A-Za-z0-9_./+-]*) fail "$label contains unsupported characters" ;;
    esac
    [ -r "$value" ] || fail "$label is not readable: $value"
}

list_has_word() {
    list=" $1 "
    word=$2
    case "$list" in
        *" $word "*) return 0 ;;
        *) return 1 ;;
    esac
}

validate_web_contract() {
    expected_hostname=$1
    profile=$2

    web_enabled=$(uci_get telego web_proxy enabled 0)
    is_enabled "$web_enabled" || fail "$profile requires telego.web_proxy.enabled=1"

    web_hostname=$(uci_get telego web_proxy hostname '')
    [ "$web_hostname" = "$expected_hostname" ] ||
        fail "$profile hostname must match telego.web_proxy.hostname ($expected_hostname)"

    web_bind=$(uci_get telego web_proxy bind_to '127.0.0.1:8080')
    case "$web_bind" in
        127.0.0.1:8080|tcp://127.0.0.1:8080) ;;
        *) fail "$profile requires telego.web_proxy.bind_to=127.0.0.1:8080" ;;
    esac

    trusted=$(uci_get telego web_proxy trusted_proxy_cidrs '')
    list_has_word "$trusted" '127.0.0.1/32' ||
        fail "$profile requires 127.0.0.1/32 in telego.web_proxy.trusted_proxy_cidrs"
}

validate_shared_contract() {
    hostname=$1
    validate_web_contract "$hostname" 'native shared-port ingress'

    public_bind=$(uci_get telego general bind_to '0.0.0.0:443')
    case "$public_bind" in
        *:443) ;;
        *) fail 'native shared-port ingress requires the public telEgo listener on TCP port 443' ;;
    esac

    mask_host=$(uci_get telego tls_fronting mask_host '')
    [ "$mask_host" = "$hostname" ] ||
        fail 'native shared-port ingress requires tls_fronting.mask_host to match the WEB hostname'

    cert_host=$(uci_get telego tls_fronting cert_host '')
    cert_port=$(uci_get telego tls_fronting cert_port '')
    splice_host=$(uci_get telego tls_fronting splice_host '')
    splice_port=$(uci_get telego tls_fronting splice_port '')
    splice_proxy=$(uci_get telego tls_fronting splice_proxy_protocol 0)

    [ "$cert_host" = '127.0.0.1' ] ||
        fail 'native shared-port ingress requires tls_fronting.cert_host=127.0.0.1'
    [ "$cert_port" = '8444' ] ||
        fail 'native shared-port ingress requires tls_fronting.cert_port=8444'
    [ "$splice_host" = '127.0.0.1' ] ||
        fail 'native shared-port ingress requires tls_fronting.splice_host=127.0.0.1'
    [ "$splice_port" = '8443' ] ||
        fail 'native shared-port ingress requires tls_fronting.splice_port=8443'
    [ "$splice_proxy" = '2' ] ||
        fail 'native shared-port ingress requires tls_fronting.splice_proxy_protocol=2'
}

port_conflict() {
    port=$1
    for file in "$CONF_DIR"/*.conf; do
        [ -e "$file" ] || continue
        if [ "$file" = "$OUTPUT" ]; then
            is_managed_output && continue
            echo "$file"
            return 0
        fi
        if grep -Eq "listen[[:space:]]+([^;[:space:]]*:)?${port}([[:space:]]|;)" "$file"; then
            echo "$file"
            return 0
        fi
    done

    # OpenWrt may also declare Nginx listeners through /etc/config/nginx. Those
    # are expanded into /etc/nginx/uci.conf before conf.d/*.conf is included.
    if [ -r "$NGINX_UCI_CONFIG" ] &&
       grep -Eq "^[[:space:]]*(option|list)[[:space:]]+listen[[:space:]].*(:|[[:space:]'\"])[[]?[^'\"]*:?${port}([[:space:]'\"]|$)" "$NGINX_UCI_CONFIG"; then
        echo "$NGINX_UCI_CONFIG"
        return 0
    fi
    return 1
}

check_port_free() {
    port=$1
    purpose=$2
    conflict=$(port_conflict "$port" || true)
    [ -z "$conflict" ] || fail "$purpose port 127.0.0.1:$port is already configured in $conflict; keep either the existing listener or the managed profile, not both"
}

nginx_test() {
    [ -x "$NGINX_BIN" ] || fail "nginx executable not found: $NGINX_BIN"
    [ -r "$NGINX_CONF" ] || fail "nginx configuration not found: $NGINX_CONF"
    "$NGINX_BIN" -t -c "$NGINX_CONF"
}

reload_nginx() {
    [ "$RELOAD" -eq 1 ] || return 0
    [ -x "$NGINX_INIT" ] || return 0
    if "$NGINX_INIT" status >/dev/null 2>&1; then
        "$NGINX_INIT" reload
    fi
}

restore_output() {
    backup=$1
    if [ -n "$backup" ] && [ -f "$backup" ]; then
        cp "$backup" "$OUTPUT"
        chmod 0644 "$OUTPUT"
    else
        rm -f "$OUTPUT"
    fi
}

apply_candidate() {
    candidate=$1
    mkdir -p "$CONF_DIR"

    if [ -e "$OUTPUT" ] && ! is_managed_output; then
        fail "$OUTPUT already exists but is not owned by nginx-telego; it was left unchanged"
    fi

    # A reload trigger may fire for an unrelated telEgo option. If the rendered
    # Nginx configuration is byte-for-byte unchanged, validate it but avoid a
    # needless Nginx reload and connection churn.
    if is_managed_output && cmp -s "$candidate" "$OUTPUT"; then
        nginx_test
        return 0
    fi

    backup=''
    if is_managed_output; then
        backup=$(mktemp /tmp/nginx-telego-backup.XXXXXX)
        cp "$OUTPUT" "$backup"
    fi

    staged="${OUTPUT}.new.$$"
    cp "$candidate" "$staged"
    chmod 0644 "$staged"
    mv "$staged" "$OUTPUT"

    if ! nginx_test; then
        restore_output "$backup"
        rm -f "$backup"
        echo 'nginx-telego: generated configuration failed nginx -t; previous configuration restored' >&2
        exit 1
    fi

    rm -f "$backup"
    reload_nginx
}

remove_managed_output() {
    [ -e "$OUTPUT" ] || return 0
    # A file without our marker belongs to the administrator, even if it happens
    # to use the reserved filename. Disabled profiles must never remove it.
    is_managed_output || return 0

    backup=$(mktemp /tmp/nginx-telego-backup.XXXXXX)
    cp "$OUTPUT" "$backup"
    rm -f "$OUTPUT"
    if ! nginx_test; then
        cp "$backup" "$OUTPUT"
        chmod 0644 "$OUTPUT"
        rm -f "$backup"
        fail 'could not remove the managed configuration because nginx -t failed; previous configuration restored'
    fi
    rm -f "$backup"
    reload_nginx
}

if [ "$MODE" = remove ]; then
    remove_managed_output
    exit 0
fi

shared_enabled=$(uci_get nginx_telego shared enabled 0)
cloudflare_enabled=$(uci_get nginx_telego cloudflare enabled 0)
manage_fallback=$(uci_get nginx_telego fallback manage 1)

if is_enabled "$shared_enabled" && is_enabled "$cloudflare_enabled"; then
    fail 'choose either native shared-port or Cloudflare ingress; both managed profiles cannot be enabled at the same time'
fi

if ! is_enabled "$shared_enabled" && ! is_enabled "$cloudflare_enabled"; then
    remove_managed_output
    exit 0
fi

web_hostname=$(uci_get telego web_proxy hostname '')
shared_hostname=$(uci_get nginx_telego shared hostname "$web_hostname")
cloudflare_hostname=$(uci_get nginx_telego cloudflare hostname "$web_hostname")

if is_enabled "$shared_enabled"; then
    validate_hostname "$shared_hostname" 'shared hostname'
    validate_shared_contract "$shared_hostname"
    shared_certificate=$(uci_get nginx_telego shared certificate '')
    shared_certificate_key=$(uci_get nginx_telego shared certificate_key '')
    validate_path "$shared_certificate" 'shared TLS certificate'
    validate_path "$shared_certificate_key" 'shared TLS private key'
    check_port_free 8443 'shared TLS ingress'
    check_port_free 8444 'certificate source'
fi

if is_enabled "$cloudflare_enabled"; then
    validate_hostname "$cloudflare_hostname" 'Cloudflare hostname'
    validate_web_contract "$cloudflare_hostname" 'Cloudflare ingress'
    check_port_free 18080 'Cloudflare ingress'
fi

if is_enabled "$manage_fallback"; then
    check_port_free 8090 'fallback'
fi

candidate=$(mktemp /tmp/nginx-telego-managed.XXXXXX)
trap 'rm -f "$candidate"' EXIT INT TERM

cat >"$candidate" <<'EOF_HEADER'
# Generated by /usr/libexec/nginx-telego-render from /etc/config/nginx_telego.
# Do not edit this file directly. Disable the managed profile before using a
# hand-written listener on the same loopback ports.
EOF_HEADER

if is_enabled "$manage_fallback"; then
    cat >>"$candidate" <<'EOF_FALLBACK'

# Minimal ordinary-site fallback used by telEgo status 418/419 handling.
server {
    listen 127.0.0.1:8090;
    server_name _;
    access_log off;

    location / {
        default_type text/plain;
        return 200 "OK\n";
    }
}
EOF_FALLBACK
fi

if is_enabled "$shared_enabled"; then
    cat >>"$candidate" <<EOF_SHARED

# Native shared-port ingress: telEgo :443 -> Nginx TLS :8443 -> telEgo WEB :8080.
# Unknown SNI is rejected before it can reach the WEB fallback.
server {
    listen 127.0.0.1:8443 ssl proxy_protocol default_server;
    ssl_reject_handshake on;
}

server {
    listen 127.0.0.1:8443 ssl proxy_protocol;
    http2 on;
    server_name $shared_hostname;
    client_max_body_size 16m;

    ssl_certificate $shared_certificate;
    ssl_certificate_key $shared_certificate_key;
    ssl_protocols TLSv1.2 TLSv1.3;

    include /etc/nginx/snippets/telego.locations;
}

# Separate certificate source used by telEgo's FakeTLS certificate fetcher.
server {
    listen 127.0.0.1:8444 ssl default_server;
    ssl_reject_handshake on;
}

server {
    listen 127.0.0.1:8444 ssl;
    server_name $shared_hostname;

    ssl_certificate $shared_certificate;
    ssl_certificate_key $shared_certificate_key;
    ssl_protocols TLSv1.2 TLSv1.3;

    location / {
        return 204;
    }
}
EOF_SHARED
fi

if is_enabled "$cloudflare_enabled"; then
    cat >>"$candidate" <<EOF_CLOUDFLARE

# Cloudflare Tunnel ingress: cloudflared -> Nginx :18080 -> telEgo WEB :8080.
# Binding to loopback means only local processes can supply CF-Connecting-IP.
map \$http_cf_connecting_ip \$telego_cf_client_ip {
    default \$http_cf_connecting_ip;
    ''      \$remote_addr;
}

server {
    listen 127.0.0.1:18080;
    server_name $cloudflare_hostname;
    access_log off;

    location / {
        proxy_pass http://telego_web;
        proxy_http_version 1.1;
        proxy_request_buffering on;
        proxy_buffering off;
        proxy_read_timeout 40s;
        proxy_send_timeout 40s;
        proxy_intercept_errors on;
        recursive_error_pages off;

        proxy_set_header Host \$http_host;
        proxy_set_header X-Real-IP \$telego_cf_client_ip;
        proxy_set_header X-Forwarded-For \$telego_cf_client_ip;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Forwarded "";
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection \$telego_connection_upgrade;

        error_page 418 = @telego_cf_ordinary;
        error_page 419 = @telego_cf_sanitized;
    }

    location @telego_cf_ordinary {
        internal;
        proxy_pass http://127.0.0.1:8090;
        proxy_http_version 1.1;
        proxy_set_header Host \$http_host;
        proxy_set_header X-Real-IP \$telego_cf_client_ip;
        proxy_set_header X-Forwarded-For \$telego_cf_client_ip;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Upgrade \$http_upgrade;
        proxy_set_header Connection \$telego_connection_upgrade;
    }

    location @telego_cf_sanitized {
        internal;
        set \$args "";
        proxy_pass http://127.0.0.1:8090;
        proxy_http_version 1.1;
        proxy_method GET;
        proxy_pass_request_body off;

        proxy_set_header Host \$http_host;
        proxy_set_header Content-Length "";
        proxy_set_header Content-Type "";
        proxy_set_header Transfer-Encoding "";
        proxy_set_header Authorization "";
        proxy_set_header Cookie "";
        proxy_set_header X-Up-Seq "";
        proxy_set_header X-Down-Cursor "";
        proxy_set_header X-Session-Token "";
        proxy_set_header X-Carrier-Mode "";
        proxy_set_header X-Up-Ack "";
        proxy_set_header X-Lane-ID "";
        proxy_set_header Sec-WebSocket-Key "";
        proxy_set_header Sec-WebSocket-Protocol "";
        proxy_set_header Sec-WebSocket-Version "";
        proxy_set_header Sec-WebSocket-Extensions "";
        proxy_set_header CF-Connecting-IP "";
        proxy_set_header X-Real-IP "";
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Forwarded-Proto "";
        proxy_set_header Forwarded "";
        proxy_set_header Upgrade "";
        proxy_set_header Connection "";
    }
}
EOF_CLOUDFLARE
fi

apply_candidate "$candidate"
echo "nginx-telego: managed Nginx configuration is valid: $OUTPUT"

msgid "telEgo Configuration"
msgstr "Конфигурация telEgo"
msgid "Configure Telegram MTProxy, WEB Proxy, TLS fronting and Middle-End settings."
msgstr "Настройка Telegram MTProxy, WEB-прокси, TLS-фронтинга и Middle-End."
msgid "General Settings"
msgstr "Общие настройки"
msgid "Enable telEgo"
msgstr "Включить telEgo"
msgid "Bind Address"
msgstr "Адрес привязки"
msgid "Address and port to listen on."
msgstr "Адрес и порт для прослушивания."
msgid "Log Level"
msgstr "Уровень логирования"
msgid "Trace"
msgstr "Трассировка"
msgid "Debug"
msgstr "Отладка"
msgid "Info"
msgstr "Информация"
msgid "Warning"
msgstr "Предупреждение"
msgid "Error"
msgstr "Ошибка"
msgid "Enable PROXY Protocol"
msgstr "Включить PROXY Protocol"
msgid "Accept incoming PROXY protocol headers from a trusted reverse proxy."
msgstr "Принимать заголовки PROXY Protocol от доверенного обратного прокси."
msgid "Max Connections Per IP"
msgstr "Максимум соединений на IP"
msgid "Max Unique IPs Per User"
msgstr "Максимум уникальных IP на пользователя"
msgid "IP Block Timeout"
msgstr "Таймаут блокировки IP"
msgid "Handshake Timeout"
msgstr "Таймаут рукопожатия"
msgid "User Secrets"
msgstr "Секреты пользователей"
msgid "Username"
msgstr "Имя пользователя"
msgid "Identifier used in generated proxy links."
msgstr "Идентификатор, используемый в сгенерированных ссылках прокси."
msgid "Secret"
msgstr "Секрет"
msgid "Exactly 32 hexadecimal characters."
msgstr "Ровно 32 шестнадцатеричных символа."
msgid "Secret must contain exactly 32 hexadecimal characters."
msgstr "Секрет должен содержать ровно 32 шестнадцатеричных символа."
msgid "Description"
msgstr "Описание"
msgid "TLS Fronting"
msgstr "TLS-фронтинг"
msgid "Mask Host"
msgstr "Маскирующий хост"
msgid "Domain to mimic for TLS fronting."
msgstr "Домен для имитации при TLS-фронтинге."
msgid "Mask Port"
msgstr "Порт маскировки"
msgid "Certificate Host"
msgstr "Хост сертификата"
msgid "Optional certificate fetch override."
msgstr "Необязательное переопределение хоста получения сертификата."
msgid "Certificate Port"
msgstr "Порт сертификата"
msgid "Fake Certificate Size"
msgstr "Размер фиктивного сертификата"
msgid "Mask SNI Safelist"
msgstr "Белый список SNI для маскировки"
msgid "Splice Host"
msgstr "Хост splice"
msgid "Splice Port"
msgstr "Порт splice"
msgid "Splice PROXY Protocol"
msgstr "PROXY Protocol для splice"
msgid "Disabled"
msgstr "Отключено"
msgid "PROXY protocol v1"
msgstr "PROXY protocol v1"
msgid "PROXY protocol v2"
msgstr "PROXY protocol v2"
msgid "Splice Idle Timeout"
msgstr "Таймаут простоя splice"
msgid "Enable DRS"
msgstr "Включить DRS"
msgid "Enable Split TLS"
msgstr "Включить Split TLS"
msgid "WEB Proxy"
msgstr "WEB-прокси"
msgid "Enable WEB Proxy"
msgstr "Включить WEB-прокси"
msgid "Expose the native WEB proxy through the configured local listener."
msgstr "Включить встроенный WEB-прокси через настроенный локальный слушатель."
msgid "Carrier Mode"
msgstr "Режим транспорта"
msgid "WEB Proxy Bind"
msgstr "Адрес WEB-прокси"
msgid "WEB Proxy Hostname"
msgstr "Имя хоста WEB-прокси"
msgid "WEB Proxy Backend"
msgstr "Бэкенд WEB-прокси"
msgid "Trusted Proxy CIDRs"
msgstr "CIDR доверенных прокси"
msgid "WEB Event Loops"
msgstr "Циклы событий WEB"
msgid "Telegram Middle-End"
msgstr "Telegram Middle-End"
msgid "Enable Middle-End"
msgstr "Включить Middle-End"
msgid "Use Telegram Middle-End relay transport."
msgstr "Использовать транспорт ретрансляции Telegram Middle-End."
msgid "Proxy Tag"
msgstr "Тег прокси"
msgid "Telegram promo tag for Middle-End identification."
msgstr "Промо-тег Telegram для идентификации Middle-End."
msgid "SOCKS5 Proxy"
msgstr "SOCKS5-прокси"
msgid "Route Middle-End traffic through SOCKS5."
msgstr "Маршрутизировать трафик Middle-End через SOCKS5."
msgid "SOCKS5 Username"
msgstr "Имя пользователя SOCKS5"
msgid "SOCKS5 Password"
msgstr "Пароль SOCKS5"
msgid "Artifact Proxy"
msgstr "Прокси артефактов"
msgid "STUN NAT IP"
msgstr "NAT IP для STUN"
msgid "Custom external IP used for STUN discovery behind NAT."
msgstr "Внешний IP, используемый STUN для обнаружения адреса за NAT."
msgid "Middle-End Max Connections"
msgstr "Максимум соединений Middle-End"
msgid "Middle-End Queue Budget (MB)"
msgstr "Лимит очереди Middle-End (МБ)"
msgid "Performance"
msgstr "Производительность"
msgid "TCP Buffer (KB)"
msgstr "TCP-буфер (КБ)"
msgid "Event Loops"
msgstr "Циклы событий"
msgid "Prefer IP Version"
msgstr "Предпочтительная версия IP"
msgid "Prefer IPv4"
msgstr "Предпочитать IPv4"
msgid "Prefer IPv6"
msgstr "Предпочитать IPv6"
msgid "IPv4 only"
msgstr "Только IPv4"
msgid "IPv6 only"
msgstr "Только IPv6"
msgid "Idle Timeout"
msgstr "Таймаут простоя"
msgid "Max Write Buffer (MB)"
msgstr "Максимальный буфер записи (МБ)"
msgid "Client Silence Close"
msgstr "Закрытие при отсутствии ответа клиенту"
msgid "Upstream"
msgstr "Восходящий прокси"
msgid "Metrics"
msgstr "Метрики"
msgid "Metrics Address"
msgstr "Адрес метрик"
msgid "Keep metrics bound to the router by default and are not fetched directly from the administrator browser."
msgstr "По умолчанию метрики доступны только на роутере и не запрашиваются напрямую из браузера администратора."
msgid "Metrics Path"
msgstr "Путь метрик"
msgid "Invalid secret format. Use exactly 32 hexadecimal characters."
msgstr "Неверный формат секрета. Используйте ровно 32 шестнадцатеричных символа."
msgid "Invalid bind address. Use IP:port, [IPv6]:port, or unix://path."
msgstr "Неверный адрес привязки. Используйте IP:порт, [IPv6]:порт или unix://путь."
msgid "Invalid duration. Example: 5s, 1m, 2h."
msgstr "Неверная длительность. Пример: 5s, 1m, 2h."
msgid "Invalid CIDR notation."
msgstr "Неверная запись CIDR."
msgid "Invalid hostname."
msgstr "Неверное имя хоста."
msgid "telEgo Status"
msgstr "Статус telEgo"
msgid "Service Status"
msgstr "Состояние службы"
msgid "Running"
msgstr "Работает"
msgid "Stopped"
msgstr "Остановлена"
msgid "Disabled"
msgstr "Отключена"
msgid "Enabled"
msgstr "Включена"
msgid "Yes"
msgstr "Да"
msgid "No"
msgstr "Нет"
msgid "MTProxy Bind Address"
msgstr "Адрес MTProxy"
msgid "Prometheus Metrics"
msgstr "Метрики Prometheus"
msgid "Metrics remain bound to the router by default and are not fetched directly from the administrator browser."
msgstr "По умолчанию метрики доступны только на роутере и не запрашиваются напрямую из браузера администратора."
msgid "Open Configuration"
msgstr "Открыть конфигурацию"

msgstr "Неверный формат длительности. Используйте число + единицу (с/м/ч/д). Пример: 5с, 1м, 2ч"
msgid "Invalid CIDR format. Use IP/mask (e.g., 192.168.1.0/24)"
msgstr "Неверный формат CIDR. Используйте IP/маска (например, 192.168.1.0/24)"
msgid "Invalid hostname format"
msgstr "Неверный формат имени хоста"

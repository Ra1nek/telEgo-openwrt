function captured_at() {
	return int(time());
}

function stable_failure(error, truncated) {
	return {
		ok: false,
		error: error,
		content: '',
		redacted: true,
		truncated: !!truncated,
		omitted_entries: 0,
		captured_at: captured_at()
	};
}

function read_bounded(handle, max_bytes) {
	let output = '';
	let truncated = false;

	while (true) {
		const chunk = handle.read(4096);
		if (!chunk || !length(chunk))
			break;

		const remaining = max_bytes - length(output);
		if (remaining > 0)
			output += substr(chunk, 0, remaining);
		if (length(chunk) > remaining)
			truncated = true;
	}

	return { output: output, truncated: truncated };
}

function capture(command, max_bytes) {
	const proc = popen(command, 'r');
	if (!proc)
		return { ok: false, output: '', truncated: false };

	const captured = read_bounded(proc, max_bytes);
	const exit_code = proc.close();
	return {
		ok: exit_code == 0,
		output: captured.output,
		truncated: captured.truncated
	};
}

function read_bounded_regular(path, max_bytes) {
	const info = lstat(path);
	if (!info)
		return { ok: false, error: 'unavailable', data: '', truncated: false };
	if (info.type != 'file')
		return { ok: false, error: 'unsafe', data: '', truncated: false };
	if (+info.size > max_bytes)
		return { ok: false, error: 'too-large', data: '', truncated: true };

	const file = open(path, 'r');
	if (!file)
		return { ok: false, error: 'unavailable', data: '', truncated: false };

	const captured = read_bounded(file, max_bytes);
	file.close();

	if (captured.truncated)
		return { ok: false, error: 'too-large', data: '', truncated: true };

	return { ok: true, error: '', data: captured.output, truncated: false };
}

function release_value(text, key) {
	const prefix = key == 'description'
		? 'DISTRIB_DESCRIPTION='
		: key == 'release'
			? 'DISTRIB_RELEASE='
			: key == 'arch'
				? 'DISTRIB_ARCH='
				: '';
	if (!prefix)
		return '';

	for (let line in split(text || '', '\n')) {
		line = rtrim(line, '\r');
		if (substr(line, 0, length(prefix)) != prefix)
			continue;

		const raw = substr(line, length(prefix));
		if (length(raw) >= 2 && substr(raw, 0, 1) == "'" && substr(raw, length(raw) - 1, 1) == "'")
			return substr(raw, 1, length(raw) - 2);
	}

	return '';
}

function package_version(package_name) {
	let allowed = false;
	for (let item in PACKAGE_NAMES) {
		if (item == package_name) {
			allowed = true;
			break;
		}
	}
	if (!allowed)
		return null;

	let result = capture('/usr/bin/apk info -e -v ' + package_name, 512);
	if (!result.ok)
		result = capture('/sbin/apk info -e -v ' + package_name, 512);
	if (!result.ok)
		return null;

	const line = trim(split(result.output, '\n')[0] || '');
	const prefix = package_name + '-';
	if (!length(line) || substr(line, 0, length(prefix)) != prefix)
		return null;

	const version = substr(line, length(prefix));
	return match(version, /^[A-Za-z0-9._+~:-]+$/) ? version : null;
}

function core_build_info() {
	const result = capture('/usr/bin/telego version 2>&1', 4096);
	if (!result.ok)
		return { version: null, go_version: null };

	const version_match = match(result.output, /(^|[ \t])version=([A-Za-z0-9._+~:-]+)/);
	const go_match = match(result.output, /(^|[ \t])go(_version)?=([A-Za-z0-9._+~:-]+)/);

	return {
		version: version_match ? version_match[2] : null,
		go_version: go_match ? go_match[3] : null
	};
}

function capabilities() {
	return {
		ok: true,
		error: '',
		api_version: API_VERSION,
		features: {
			serviceLifecycle: true,
			ingressWizard: true,
			redactedLogs: true,
			redactedRuntimeConfig: true,
			componentVersions: true,
			candidateIngressPreflight: true,
			candidateNginxValidation: false
		}
	};
}

function system_info() {
	const release = read_bounded_regular('/etc/openwrt_release', 8192);
	const release_text = release.ok ? release.data : '';
	let architecture = release_value(release_text, 'arch');

	if (!architecture) {
		const uname = capture('/bin/uname -m', 128);
		if (uname.ok)
			architecture = trim(uname.output);
	}

	const packages = {};
	for (let package_name in PACKAGE_NAMES)
		packages[package_name] = package_version(package_name);

	const core = core_build_info();
	return {
		ok: true,
		error: '',
		openwrt_release: release_value(release_text, 'description') || release_value(release_text, 'release'),
		architecture: architecture || '',
		packages: packages,
		core_version: core.version,
		build_go_version: core.go_version
	};
}

function safe_log_line(line) {
	if (!length(line))
		return null;

	let selected = null;
	for (let message in SAFE_LOG_MESSAGES) {
		if (index(line, message) >= 0) {
			selected = message;
			break;
		}
	}
	if (!selected)
		return null;

	const level_match = match(line, /(^|[ \t])(TRC|DBG|INF|WRN|ERR|FTL)([ \t]|$)/);
	return (level_match ? level_match[2] + ' ' : '') + selected;
}

function logs(limit) {
	if (type(limit) != 'int' || limit < 1 || limit > 200)
		return stable_failure('invalid-limit', false);

	const result = capture('/sbin/logread -e telego -l ' + limit, LOG_MAX_BYTES);
	if (!result.ok)
		return stable_failure('logread-failed', result.truncated);

	const entries = [];
	let omitted = 0;
	for (let line in split(result.output, '\n')) {
		line = rtrim(line, '\r');
		if (!length(line))
			continue;

		const safe = safe_log_line(line);
		if (!safe) {
			omitted++;
			continue;
		}

		if (length(entries) < limit)
			push(entries, safe);
		else
			omitted++;
	}

	return {
		ok: true,
		error: '',
		content: join('\n', entries),
		redacted: true,
		truncated: result.truncated,
		omitted_entries: omitted,
		captured_at: captured_at()
	};
}

function generated_value_valid(value) {
	value = trim(value || '');
	if (!length(value))
		return false;

	if (value == 'true' || value == 'false' || match(value, /^[0-9]+$/))
		return true;

	if (substr(value, 0, 1) == '"' && substr(value, length(value) - 1, 1) == '"')
		return true;

	if (substr(value, 0, 1) == '[' && substr(value, length(value) - 1, 1) == ']')
		return true;

	return false;
}

function sensitive_value(section, key, value) {
	if (ALWAYS_REDACT[section + '.' + key])
		return true;

	if (match(value || '', /[0-9A-Fa-f]{32}/))
		return true;

	if (match(value || '', /:\/\/[^\/ \t]+@/))
		return true;

	return false;
}

function sanitize_runtime_config(data) {
	const lines = split(data || '', '\n');
	const output = [];
	let current = '';
	let known_section = false;
	let saw_header = false;
	let omitted = 0;
	let secret_index = 0;

	for (let raw in lines) {
		let line = rtrim(raw, '\r');
		if (!length(trim(line))) {
			if (saw_header)
				push(output, '');
			continue;
		}

		if (!saw_header) {
			if (line != '# Generated from /etc/config/telego. Do not edit.')
				return { ok: false, content: '', omitted: 0 };
			saw_header = true;
			push(output, line);
			continue;
		}

		if (substr(line, 0, 1) == '#') {
			omitted++;
			continue;
		}

		const section_match = match(line, /^\[([A-Za-z0-9-]+)\]$/);
		if (section_match) {
			current = section_match[1];
			known_section = RUNTIME_KEYS[current] != null;
			if (known_section)
				push(output, line);
			else
				omitted++;
			continue;
		}

		if (!current)
			return { ok: false, content: '', omitted: 0 };

		if (!known_section) {
			omitted++;
			continue;
		}

		if (current == 'secrets') {
			const secret_match = match(line, /^"[^"]*"[ \t]*=[ \t]*".*"$/);
			if (!secret_match)
				return { ok: false, content: '', omitted: 0 };
			secret_index++;
			push(output, '"secret-' + secret_index + '" = "[REDACTED]"');
			continue;
		}

		const assignment = match(line, /^([A-Za-z0-9-]+)[ \t]*=[ \t]*(.+)$/);
		if (!assignment)
			return { ok: false, content: '', omitted: 0 };

		const key = assignment[1];
		const value = assignment[2];
		if (!RUNTIME_KEYS[current][key]) {
			omitted++;
			continue;
		}
		if (!generated_value_valid(value))
			return { ok: false, content: '', omitted: 0 };

		if (sensitive_value(current, key, value))
			push(output, key + ' = "[REDACTED]"');
		else
			push(output, key + ' = ' + value);
	}

	if (!saw_header)
		return { ok: false, content: '', omitted: 0 };

	return {
		ok: true,
		content: join('\n', output),
		omitted: omitted
	};
}

function runtime_config() {
	const source = read_bounded_regular(RUNTIME_PATH, RUNTIME_MAX_BYTES);
	if (!source.ok) {
		if (source.error == 'unsafe')
			return stable_failure('runtime-config-unsafe', false);
		if (source.error == 'too-large')
			return stable_failure('runtime-config-too-large', true);
		return stable_failure('runtime-config-unavailable', false);
	}

	const sanitized = sanitize_runtime_config(source.data);
	if (!sanitized.ok)
		return stable_failure('runtime-config-parse-failed', false);

	return {
		ok: true,
		error: '',
		content: sanitized.content,
		redacted: true,
		truncated: false,
		omitted_entries: sanitized.omitted,
		captured_at: captured_at()
	};
}

const LIFECYCLE_ACTIONS = {
	start: true,
	restart: true,
	stop: true,
	enable_autostart: true,
	disable_autostart: true
};

const LIFECYCLE_STATES = {
	queued: true,
	running: true,
	completed: true,
	failed: true,
	unknown: true
};

const LIFECYCLE_ERRORS = {
	'': true,
	'request-id-conflict': true,
	'operation-corrupt': true,
	'state-unavailable': true,
	'lock-unavailable': true,
	'busy': true,
	'state-revision-unavailable': true,
	'revision-conflict': true,
	'config-disabled': true,
	'start-failed': true,
	'restart-failed': true,
	'stop-failed': true,
	'enable-autostart-failed': true,
	'disable-autostart-failed': true,
	'action-failed': true
};

const LIFECYCLE_MESSAGES = {
	'': true,
	'service-started': true,
	'service-restarted': true,
	'service-stopped': true,
	'autostart-enabled': true,
	'autostart-disabled': true,
	'config-disabled': true,
	'start-failed': true,
	'restart-failed': true,
	'stop-failed': true,
	'enable-autostart-failed': true,
	'disable-autostart-failed': true,
	'action-failed': true,
	'revision-conflict': true,
	'operation-failed': true
};

function lifecycle_request_id_valid(value) {
	return type(value) == 'string' &&
		length(value) >= 8 &&
		length(value) <= 64 &&
		!!match(value, /^[A-Za-z0-9._:-]+$/);
}

function lifecycle_revision_valid(value) {
	return type(value) == 'string' && !!match(value, /^[0-9a-f]{64}$/);
}

function lifecycle_fields(output) {
	const fields = {};
	for (let line in split(output || '', '\n')) {
		line = rtrim(line, '\r');
		if (!length(line))
			continue;

		const item = match(line, /^([a-z_]+)=(.*)$/);
		if (!item)
			return null;
		fields[item[1]] = item[2];
	}
	return fields;
}

function lifecycle_capture(args) {
	const result = capture(LIFECYCLE_HELPER + ' ' + args + ' 2>/dev/null', 4096);
	return result.ok && !result.truncated ? lifecycle_fields(result.output) : null;
}

function service_status() {
	const fields = lifecycle_capture('status');
	if (!fields || fields.ok != '1' || !lifecycle_revision_valid(fields.state_revision))
		return { ok: false, error: 'service-status-unavailable' };

	for (let key in ['running', 'autostart', 'config_enabled', 'busy'])
		if (fields[key] != '0' && fields[key] != '1')
			return { ok: false, error: 'service-status-unavailable' };

	return {
		ok: true,
		error: '',
		running: fields.running == '1',
		autostart: fields.autostart == '1',
		config_enabled: fields.config_enabled == '1',
		state_revision: fields.state_revision,
		busy: fields.busy == '1'
	};
}

function service_action(action, request_id, expected_revision) {
	if (type(action) != 'string' || !LIFECYCLE_ACTIONS[action])
		return { ok: false, error: 'invalid-action' };
	if (!lifecycle_request_id_valid(request_id))
		return { ok: false, error: 'invalid-request-id' };
	if (!lifecycle_revision_valid(expected_revision))
		return { ok: false, error: 'invalid-revision' };

	const fields = lifecycle_capture('action ' + action + ' ' + request_id + ' ' + expected_revision);
	if (!fields)
		return {
			ok: false,
			error: 'lifecycle-helper-unavailable',
			operation_id: request_id,
			state: 'unknown'
		};

	const state = fields.state;
	const operation_id = fields.operation_id;
	const error = fields.error || '';
	if ((fields.ok != '0' && fields.ok != '1') ||
	    !lifecycle_request_id_valid(operation_id) ||
	    !LIFECYCLE_STATES[state] || state == 'unknown' ||
	    !LIFECYCLE_ERRORS[error])
		return {
			ok: false,
			error: 'lifecycle-helper-invalid-response',
			operation_id: request_id,
			state: 'unknown'
		};

	return {
		ok: fields.ok == '1',
		error: error,
		operation_id: operation_id,
		state: state
	};
}

function operation_status(operation_id) {
	if (!lifecycle_request_id_valid(operation_id))
		return {
			ok: false,
			error: 'invalid-operation-id',
			state: 'unknown',
			message: ''
		};

	const fields = lifecycle_capture('operation-status ' + operation_id);
	if (!fields)
		return {
			ok: false,
			error: 'lifecycle-helper-unavailable',
			state: 'unknown',
			message: ''
		};

	const state = fields.state;
	const message = fields.message || '';
	const error = fields.error || '';
	if ((fields.ok != '0' && fields.ok != '1') ||
	    !LIFECYCLE_STATES[state] || !LIFECYCLE_MESSAGES[message] ||
	    !LIFECYCLE_ERRORS[error])
		return {
			ok: false,
			error: 'lifecycle-helper-invalid-response',
			state: 'unknown',
			message: ''
		};

	return {
		ok: fields.ok == '1',
		error: error,
		state: state,
		message: message
	};
}

const methods = {
	capabilities: {
		call: function () { return capabilities(); }
	},
	system_info: {
		call: function () { return system_info(); }
	},
	logs: {
		args: { limit: 0 },
		call: function (request) { return logs(request.args.limit); }
	},
	runtime_config: {
		call: function () { return runtime_config(); }
	}
};

const admin_methods = {
	service_status: {
		call: function () { return service_status(); }
	},
	service_action: {
		args: { action: '', request_id: '', expected_revision: '' },
		call: function (request) {
			return service_action(
				request.args.action,
				request.args.request_id,
				request.args.expected_revision
			);
		}
	},
	operation_status: {
		args: { operation_id: '' },
		call: function (request) { return operation_status(request.args.operation_id); }
	}
};

return {
	'telego.ui': methods,
	'telego.admin': admin_methods
};

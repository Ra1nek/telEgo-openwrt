'use strict';

import { cursor } from 'uci';
import { open, popen } from 'fs';
import { connect } from 'ubus';

function readfile(path) {
	const file = open(path, 'r');
	if (!file)
		return '';

	const data = file.read('all') || '';
	file.close();
	return data;
}

function service_info() {
	const info = { running: false, pid: 0 };
	const ubus = connect();
	if (!ubus)
		return info;

	try {
		const result = ubus.call('service', 'list', { name: 'telego' });
		const instances = result?.telego?.instances || {};
		for (let name in instances) {
			const instance = instances[name];
			if (instance?.running === true) {
				info.running = true;
				info.pid = +(instance.pid || 0);
				break;
			}
		}
	}
	catch (e) {}
	ubus.disconnect();

	return info;
}

function process_uptime(pid) {
	if (!pid)
		return 0;

	const uptime = readfile('/proc/uptime');
	const uptime_match = match(uptime, /^([0-9]+(\.[0-9]+)?)/);
	if (!uptime_match)
		return 0;

	const stat = readfile('/proc/' + pid + '/stat');
	const close = rindex(stat, ')');
	if (close < 0)
		return 0;

	const fields = split(trim(substr(stat, close + 1)), /[ \t]+/);
	if (length(fields) < 20)
		return 0;

	const start_ticks = +fields[19];
	if (!(start_ticks >= 0 && start_ticks <= 9007199254740991))
		return 0;

	/* Linux clock tick is normally 100 Hz on OpenWrt. */
	const hz = 100;
	return max(0, int(+uptime_match[1] - start_ticks / hz));
}

function runtime_flags() {
	const uci = cursor();
	uci.load('telego');

	return {
		web_enabled: uci.get('telego', 'web_proxy', 'enabled') == '1',
		web_carrier: uci.get('telego', 'web_proxy', 'carrier') || 'https',
		middleend_enabled: uci.get('telego', 'middle_end', 'enabled') == '1'
	};
}

function metrics_endpoint() {
	const uci = cursor();
	uci.load('telego');

	const bind = uci.get('telego', 'metrics', 'bind_to') || '127.0.0.1:9090';
	const path = uci.get('telego', 'metrics', 'path') || '/metrics';

	/* RPC must never fetch an arbitrary administrator-supplied endpoint. */
	const bind_match = match(bind, /^(127\.0\.0\.1|\[::1\]):[1-9][0-9]{0,4}$/);
	if (!bind_match || bind_match[0] != bind)
		return null;

	if (+substr(bind, rindex(bind, ':') + 1) > 65535)
		return null;

	const path_match = match(path, /^\/[A-Za-z0-9._~!$&'()*+,;=:@%\/-]*$/);
	if (!path_match || path_match[0] != path)
		return null;

	return 'http://' + bind + path;
}

function parse_number(value) {
	const number = +value;
	// Bounds reject NaN/infinity and preserve exact integer values in LuCI.
	return number >= 0 && number <= 9007199254740991 ? number : 0;
}

function metric_label(labels, key) {
	if (!labels)
		return '';

	/* Metrics used here have simple quoted Prometheus labels. */
	const pattern = key == 'state'
		? /state="([^"]+)"/
		: key == 'result'
			? /result="([^"]+)"/
			: null;
	if (!pattern)
		return '';

	const value = match(labels, pattern);
	return value ? value[1] : '';
}

function read_metrics() {
	const result = {
		connections: 0,
		ips_active: 0,
		ips_tracked: 0,
		ips_blocked: 0,
		rx_bytes: 0,
		tx_bytes: 0,

		web_sessions_active: 0,
		web_streams_active: 0,
		web_websockets_active: 0,
		web_backend_dials_active: 0,
		web_pending_bytes: 0,
		web_pending_items: 0,
		web_sessions_created_total: 0,
		web_sessions_closed_total: 0,
		web_carrier_retries_total: 0,
		web_backpressure_total: 0,

		middleend_admitting: 0,
		middleend_repairing: 0,
		middleend_links: 0,
		middleend_bindings: 0,
		middleend_repairs_active: 0,
		middleend_slot_failures_total: 0,
		middleend_artifact_applied: 0,
		middleend_artifact_pending: 0,
		middleend_artifact_refresh_failures: 0
	};

	const endpoint = metrics_endpoint();
	if (!endpoint)
		return result;

	// OpenWrt's pinned ucode accepts a shell command, not an argv array.
	// Quote the entire URL, including any literal apostrophes in its path.
	const quoted = "'" + replace(endpoint, /'/g, function() { return "'\\''"; }) + "'";
	const proc = popen('/usr/bin/uclient-fetch -q -T 2 -O - ' + quoted, 'r');

	if (!proc)
		return result;

	for (let line = proc.read('line'); length(line); line = proc.read('line')) {
		line = rtrim(line, '\r\n');
		if (!length(line) || substr(line, 0, 1) === '#')
			continue;

		const m = match(line, /^([a-zA-Z_:][a-zA-Z0-9_:]*)(\{[^}]*\})?[ \t]+([-+0-9.eE]+)$/);
		if (!m)
			continue;

		const name = m[1];
		const labels = m[2] || '';
		const value = parse_number(m[3]);

		switch (name) {
		case 'telego_connections_active':
			result.connections += value;
			break;
		case 'telego_ips_active':
			result.ips_active += value;
			break;
		case 'telego_ips_tracked':
			result.ips_tracked += value;
			break;
		case 'telego_ips_blocked':
			result.ips_blocked += value;
			break;
		case 'telego_traffic_in_bytes_total':
			result.rx_bytes += value;
			break;
		case 'telego_traffic_out_bytes_total':
			result.tx_bytes += value;
			break;

		case 'telego_web_sessions_active':
			result.web_sessions_active += value;
			break;
		case 'telego_web_streams_active':
			result.web_streams_active += value;
			break;
		case 'telego_web_websocket_connections_active':
			result.web_websockets_active += value;
			break;
		case 'telego_web_backend_dials_active':
			result.web_backend_dials_active += value;
			break;
		case 'telego_web_pending_bytes':
			result.web_pending_bytes += value;
			break;
		case 'telego_web_pending_items':
			result.web_pending_items += value;
			break;
		case 'telego_web_sessions_created_total':
			result.web_sessions_created_total += value;
			break;
		case 'telego_web_sessions_closed_total':
			result.web_sessions_closed_total += value;
			break;
		case 'telego_web_carrier_retries_total':
			result.web_carrier_retries_total += value;
			break;
		case 'telego_web_backpressure_total':
			result.web_backpressure_total += value;
			break;

		case 'telego_middleend_admitting':
			result.middleend_admitting += value;
			break;
		case 'telego_middleend_repairing':
			result.middleend_repairing += value;
			break;
		case 'telego_middleend_links':
			result.middleend_links += value;
			break;
		case 'telego_middleend_bindings_active':
			result.middleend_bindings += value;
			break;
		case 'telego_middleend_slot_repairs_active':
			result.middleend_repairs_active += value;
			break;
		case 'telego_middleend_slot_failure_total':
			result.middleend_slot_failures_total += value;
			break;
		case 'telego_middleend_artifact_state':
			if (metric_label(labels, 'state') == 'applied')
				result.middleend_artifact_applied += value;
			else if (metric_label(labels, 'state') == 'pending')
				result.middleend_artifact_pending += value;
			break;
		case 'telego_middleend_artifact_refresh_total':
			if (metric_label(labels, 'result') == 'failure')
				result.middleend_artifact_refresh_failures += value;
			break;
		}
	}

	proc.close();
	return result;
}

const methods = {
	status: {
		call: function () {
			const service = service_info();
			const flags = runtime_flags();
			const metrics = read_metrics();

			return {
				running: service.running,
				pid: service.pid,
				uptime: process_uptime(service.pid),
				connections: int(metrics.connections),
				ips_active: int(metrics.ips_active),
				ips_tracked: int(metrics.ips_tracked),
				ips_blocked: int(metrics.ips_blocked),
				rx_bytes: int(metrics.rx_bytes),
				tx_bytes: int(metrics.tx_bytes),

				web_enabled: flags.web_enabled,
				web_carrier: flags.web_carrier,
				web_sessions_active: int(metrics.web_sessions_active),
				web_streams_active: int(metrics.web_streams_active),
				web_websockets_active: int(metrics.web_websockets_active),
				web_backend_dials_active: int(metrics.web_backend_dials_active),
				web_pending_bytes: int(metrics.web_pending_bytes),
				web_pending_items: int(metrics.web_pending_items),
				web_sessions_created_total: int(metrics.web_sessions_created_total),
				web_sessions_closed_total: int(metrics.web_sessions_closed_total),
				web_carrier_retries_total: int(metrics.web_carrier_retries_total),
				web_backpressure_total: int(metrics.web_backpressure_total),

				middleend_enabled: flags.middleend_enabled,
				middleend_admitting: int(metrics.middleend_admitting),
				middleend_repairing: int(metrics.middleend_repairing),
				middleend_links: int(metrics.middleend_links),
				middleend_bindings: int(metrics.middleend_bindings),
				middleend_repairs_active: int(metrics.middleend_repairs_active),
				middleend_slot_failures_total: int(metrics.middleend_slot_failures_total),
				middleend_artifact_applied: int(metrics.middleend_artifact_applied),
				middleend_artifact_pending: int(metrics.middleend_artifact_pending),
				middleend_artifact_refresh_failures: int(metrics.middleend_artifact_refresh_failures)
			};
		}
	}
};

return { 'telego': methods };

'use strict';

import { popen } from 'fs';

const ADMIN = '/usr/libexec/nginx-telego-admin';
const EDITOR = '/usr/libexec/nginx-telego-editor';
const MAX_EDIT_BYTES = 65536;

function shell_quote(value) {
	return "'" + replace(value || '', /'/g, function() { return "'\\''"; }) + "'";
}

function run_admin(args) {
	let command = ADMIN;
	for (let arg in args)
		command += ' ' + shell_quote(arg);
	command += ' 2>&1';

	const proc = popen(command, 'r');
	if (!proc)
		return { ok: false, output: '', error: 'admin-helper-unavailable' };

	const output = proc.read('all') || '';
	const exit_code = proc.close();
	if (exit_code != 0)
		return { ok: false, output: '', error: trim(output) || 'admin-operation-failed' };

	return { ok: true, output: output, error: '' };
}

function valid_name(name) {
	return !!match(name || '', /^[A-Za-z0-9_+-][A-Za-z0-9._+-]*\.conf$/);
}

function editor_command(args) {
	const command = [ EDITOR ];
	for (let arg in args)
		push(command, arg);
	return command;
}

function run_editor_read(args) {
	const proc = popen(editor_command(args), 'r');
	if (!proc)
		return { ok: false, output: '', error: 'editor-helper-unavailable' };

	const output = proc.read('all') || '';
	const exit_code = proc.close();
	if (exit_code != 0)
		return {
			ok: false,
			output: '',
			error: exit_code == 4 ? 'content-too-large' : 'editor-operation-failed'
		};

	return { ok: true, output: output, error: '' };
}

function inventory() {
	const result = run_admin(['inventory']);
	if (!result.ok)
		return { ok: false, files: [], unsafe_count: 0, error: result.error };

	const files = [];
	let unsafe_count = 0;

	for (let line in split(result.output, '\n')) {
		line = rtrim(line, '\r');
		if (!length(line))
			continue;

		const fields = split(line, '\t');
		if (length(fields) != 7)
			return { ok: false, files: [], unsafe_count: 0, error: 'invalid-admin-response' };

		if (fields[0] == 'meta') {
			if (fields[5] == 'unsafe-name')
				unsafe_count += int(+fields[6]);
			continue;
		}

		if (fields[0] != 'managed' && fields[0] != 'foreign' && fields[0] != 'quarantined')
			return { ok: false, files: [], unsafe_count: 0, error: 'invalid-admin-response' };

		push(files, {
			kind: fields[0],
			name: fields[1],
			path: fields[2],
			role: fields[3],
			ownership: fields[4],
			state: fields[5],
			source: fields[6]
		});
	}

	return { ok: true, files: files, unsafe_count: unsafe_count, error: '' };
}

function mutation(command, name) {
	const result = run_admin([command, name]);
	return result.ok
		? { ok: true, message: trim(result.output), error: '' }
		: { ok: false, message: '', error: result.error };
}

function managed_content(role, side) {
	if (role != 'core' && role != 'locations')
		return { ok: false, content: '', error: 'invalid-managed-role' };
	if (side != 'active' && side != 'source')
		return { ok: false, content: '', error: 'invalid-managed-side' };

	const result = run_admin(['inspect-managed', role, side]);
	return result.ok
		? { ok: true, content: result.output, error: '' }
		: { ok: false, content: '', error: result.error };
}

function foreign_content(name) {
	if (!valid_name(name))
		return { ok: false, content: '', revision: '', size: 0, error: 'invalid-name' };

	const result = run_editor_read(['inspect', name]);
	if (!result.ok)
		return { ok: false, content: '', revision: '', size: 0, error: result.error };

	const separator = index(result.output, '\n');
	if (separator < 0)
		return { ok: false, content: '', revision: '', size: 0, error: 'invalid-editor-response' };

	const header = substr(result.output, 0, separator);
	const fields = split(header, '\t');
	if (length(fields) != 2 || !match(fields[0], /^[0-9a-f]{64}$/))
		return { ok: false, content: '', revision: '', size: 0, error: 'invalid-editor-response' };

	const size = int(+fields[1]);
	if (size < 0 || size > MAX_EDIT_BYTES)
		return { ok: false, content: '', revision: '', size: 0, error: 'invalid-editor-response' };

	const content = substr(result.output, separator + 1);
	if (length(content) != size)
		return { ok: false, content: '', revision: '', size: 0, error: 'invalid-editor-response' };

	return { ok: true, content: content, revision: fields[0], size: size, error: '' };
}

function replace_active(name, revision, content) {
	if (!valid_name(name))
		return { ok: false, changed: false, error: 'invalid-name' };
	if (length(content) > MAX_EDIT_BYTES)
		return { ok: false, changed: false, error: 'content-too-large' };
	if (!match(revision || '', /^[0-9a-f]{64}$/))
		return { ok: false, changed: false, error: 'invalid-revision' };

	const proc = popen(editor_command(['replace', name, revision]), 'w');
	if (!proc)
		return { ok: false, changed: false, error: 'editor-helper-unavailable' };

	const written = proc.write(content);
	const exit_code = proc.close();

	if (exit_code == 3)
		return { ok: false, changed: false, error: 'stale-content' };
	if (exit_code == 4)
		return { ok: false, changed: false, error: 'content-too-large' };
	if (exit_code != 0 || written == null || written != length(content))
		return { ok: false, changed: false, error: 'editor-operation-failed' };

	return { ok: true, changed: true, error: '' };
}

const methods = {
	inventory: { call: function () { return inventory(); } },
	managed_content: {
		args: { role: '', side: '' },
		call: function (request) { return managed_content(request.args.role, request.args.side); }
	},
	foreign_content: {
		args: { name: '' },
		call: function (request) { return foreign_content(request.args.name); }
	},
	quarantine: {
		args: { name: '' },
		call: function (request) { return mutation('quarantine', request.args.name); }
	},
	restore: {
		args: { name: '' },
		call: function (request) { return mutation('restore', request.args.name); }
	},
	delete_active: {
		args: { name: '' },
		call: function (request) { return mutation('delete-active', request.args.name); }
	},
	delete_quarantined: {
		args: { name: '' },
		call: function (request) { return mutation('delete-quarantined', request.args.name); }
	},
	replace_active: {
		args: { name: '', revision: '', content: '' },
		call: function (request) { return replace_active(request.args.name, request.args.revision, request.args.content); }
	},
	repair: {
		call: function () {
			const result = run_admin(['repair']);
			return result.ok
				? { ok: true, message: trim(result.output), error: '' }
				: { ok: false, message: '', error: result.error };
		}
	}
};

return { 'telego.nginx': methods };

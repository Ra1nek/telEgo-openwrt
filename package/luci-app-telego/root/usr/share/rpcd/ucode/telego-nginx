'use strict';

import { popen } from 'fs';

const ADMIN = '/usr/libexec/nginx-telego-admin';
const EDITOR = '/usr/libexec/nginx-telego-editor';
const FIREWALL = '/usr/libexec/nginx-telego-firewall';
const CERTIFICATE = '/usr/libexec/nginx-telego-cert';
const MAX_EDIT_BYTES = 65536;

function shell_quote(value) {
	return "'" + replace(value || '', /'/g, function() { return "'\\''"; }) + "'";
}

function run_admin(args) {
	let command = ADMIN;
	for (let arg in args)
		command += ' ' + shell_quote(arg);
	command += ' 2>&1';

	const proc = popen(command, 'r');
	if (!proc)
		return { ok: false, output: '', error: 'admin-helper-unavailable' };

	const output = proc.read('all') || '';
	const exit_code = proc.close();
	if (exit_code != 0)
		return { ok: false, output: '', error: trim(output) || 'admin-operation-failed' };

	return { ok: true, output: output, error: '' };
}

function run_firewall(args) {
	let command = FIREWALL;
	for (let arg in args)
		command += ' ' + shell_quote(arg);
	command += ' 2>&1';

	const proc = popen(command, 'r');
	if (!proc)
		return { ok: false, output: '', error: 'firewall-helper-unavailable' };

	const output = proc.read('all') || '';
	const exit_code = proc.close();
	if (exit_code != 0)
		return { ok: false, output: '', error: trim(output) || 'firewall-operation-failed' };

	return { ok: true, output: output, error: '' };
}

function firewall_status() {
	const result = run_firewall(['status']);
	if (!result.ok)
		return {
			ok: false,
			profile_enabled: false,
			section_state: 'unknown',
			managed_match: false,
			wan_zone_count: 0,
			wan_input: 'unknown',
			foreign_wan443: '',
			foreign_wan18443: '',
			pending_changes: false,
			error: result.error
		};

	const values = {};
	for (let line in split(result.output, '\n')) {
		line = rtrim(line, '\r');
		if (!length(line))
			continue;

		const fields = split(line, '\t');
		if (length(fields) != 2)
			return { ok: false, error: 'invalid-firewall-status' };

		values[fields[0]] = fields[1];
	}

	const required = [
		'profile_enabled',
		'section_state',
		'managed_match',
		'wan_zone_count',
		'wan_input',
		'foreign_wan443',
		'foreign_wan18443',
		'pending_changes'
	];
	for (let key in required)
		if (!(key in values))
			return { ok: false, error: 'invalid-firewall-status' };

	if (!(values.section_state in ['absent', 'owned', 'foreign']))
		return { ok: false, error: 'invalid-firewall-status' };

	return {
		ok: true,
		profile_enabled: values.profile_enabled == '1',
		section_state: values.section_state,
		managed_match: values.managed_match == '1',
		wan_zone_count: int(+values.wan_zone_count),
		wan_input: values.wan_input,
		foreign_wan443: values.foreign_wan443 == '-' ? '' : values.foreign_wan443,
		foreign_wan18443: values.foreign_wan18443 == '-' ? '' : values.foreign_wan18443,
		pending_changes: values.pending_changes == '1',
		error: ''
	};
}

function firewall_preflight() {
	const result = run_firewall(['preflight']);
	return result.ok
		? { ok: true, message: trim(result.output), error: '' }
		: { ok: false, message: '', error: result.error };
}

function run_certificate(args) {
	let command = CERTIFICATE;
	for (let arg in args)
		command += ' ' + shell_quote(arg);
	command += ' 2>&1';

	const proc = popen(command, 'r');
	if (!proc)
		return { ok: false, output: '', error: 'certificate-helper-unavailable' };

	const output = proc.read('all') || '';
	const exit_code = proc.close();
	if (exit_code != 0)
		return { ok: false, output: '', error: trim(output) || 'certificate-operation-failed' };

	return { ok: true, output: output, error: '' };
}

function certificate_status() {
	const result = run_certificate(['status']);
	if (!result.ok)
		return {
			ok: false,
			profile: 'unknown',
			managed_tls: false,
			error: result.error
		};

	const values = {};
	for (let line in split(result.output, '\n')) {
		line = rtrim(line, '\r');
		if (!length(line))
			continue;

		const fields = split(line, '\t');
		if (length(fields) != 2)
			return { ok: false, profile: 'unknown', managed_tls: false, error: 'invalid-certificate-status' };

		values[fields[0]] = fields[1];
	}

	const required = [
		'profile',
		'profile_error',
		'managed_tls',
		'hostname',
		'certificate',
		'certificate_key',
		'certificate_state',
		'key_state',
		'key_match',
		'hostname_match',
		'expiry_state',
		'not_after',
		'fingerprint_sha256',
		'acme_managed',
		'openssl_available'
	];
	for (let key in required)
		if (!(key in values))
			return { ok: false, profile: 'unknown', managed_tls: false, error: 'invalid-certificate-status' };

	return {
		ok: true,
		profile: values.profile,
		profile_error: values.profile_error == '-' ? '' : values.profile_error,
		managed_tls: values.managed_tls == '1',
		hostname: values.hostname == '-' ? '' : values.hostname,
		certificate: values.certificate == '-' ? '' : values.certificate,
		certificate_key: values.certificate_key == '-' ? '' : values.certificate_key,
		certificate_state: values.certificate_state,
		key_state: values.key_state,
		key_match: values.key_match,
		hostname_match: values.hostname_match,
		expiry_state: values.expiry_state,
		not_after: values.not_after == '-' ? '' : values.not_after,
		fingerprint_sha256: values.fingerprint_sha256 == '-' ? '' : values.fingerprint_sha256,
		acme_managed: values.acme_managed == '1',
		openssl_available: values.openssl_available == '1',
		error: ''
	};
}

function certificate_preflight() {
	const result = run_certificate(['preflight']);
	return result.ok
		? { ok: true, message: trim(result.output), error: '' }
		: { ok: false, message: '', error: result.error };
}

function valid_name(name) {
	return !!match(name || '', /^[A-Za-z0-9_+-][A-Za-z0-9._+-]*\.conf$/);
}

function editor_command(args) {
	let command = EDITOR;
	for (let arg in args)
		command += ' ' + shell_quote(arg);
	return command;
}

function editor_error(exit_code) {
	if (exit_code == 3)
		return 'stale-content';
	if (exit_code == 4)
		return 'content-too-large';
	if (exit_code == 5)
		return 'target-exists';
	if (exit_code == 6)
		return 'managed-target';
	return 'editor-operation-failed';
}

function run_editor_read(args) {
	const proc = popen(editor_command(args), 'r');
	if (!proc)
		return { ok: false, output: '', error: 'editor-helper-unavailable' };

	const output = proc.read('all') || '';
	const exit_code = proc.close();
	if (exit_code != 0)
		return { ok: false, output: '', error: editor_error(exit_code) };

	return { ok: true, output: output, error: '' };
}

function run_editor_write(args, content) {
	const proc = popen(editor_command(args), 'w');
	if (!proc)
		return { ok: false, error: 'editor-helper-unavailable' };

	const written = proc.write(content);
	const exit_code = proc.close();
	if (exit_code != 0)
		return { ok: false, error: editor_error(exit_code) };
	if (written == null || written != length(content))
		return { ok: false, error: 'editor-operation-failed' };

	return { ok: true, error: '' };
}

function inventory() {
	const result = run_admin(['inventory']);
	if (!result.ok)
		return { ok: false, files: [], unsafe_count: 0, error: result.error };

	const files = [];
	let unsafe_count = 0;

	for (let line in split(result.output, '\n')) {
		line = rtrim(line, '\r');
		if (!length(line))
			continue;

		const fields = split(line, '\t');
		if (length(fields) != 7)
			return { ok: false, files: [], unsafe_count: 0, error: 'invalid-admin-response' };

		if (fields[0] == 'meta') {
			if (fields[5] == 'unsafe-name')
				unsafe_count += int(+fields[6]);
			continue;
		}

		if (fields[0] != 'managed' && fields[0] != 'foreign' && fields[0] != 'quarantined')
			return { ok: false, files: [], unsafe_count: 0, error: 'invalid-admin-response' };

		push(files, {
			kind: fields[0],
			name: fields[1],
			path: fields[2],
			role: fields[3],
			ownership: fields[4],
			state: fields[5],
			source: fields[6]
		});
	}

	return { ok: true, files: files, unsafe_count: unsafe_count, error: '' };
}

function mutation(command, name) {
	const result = run_admin([command, name]);
	return result.ok
		? { ok: true, message: trim(result.output), error: '' }
		: { ok: false, message: '', error: result.error };
}

function managed_content(role, side) {
	if (role != 'core' && role != 'locations')
		return { ok: false, content: '', error: 'invalid-managed-role' };
	if (side != 'active' && side != 'source')
		return { ok: false, content: '', error: 'invalid-managed-side' };

	const result = run_admin(['inspect-managed', role, side]);
	return result.ok
		? { ok: true, content: result.output, error: '' }
		: { ok: false, content: '', error: result.error };
}

function foreign_content(name) {
	if (!valid_name(name))
		return { ok: false, content: '', revision: '', size: 0, error: 'invalid-name' };

	const result = run_editor_read(['inspect', name]);
	if (!result.ok)
		return { ok: false, content: '', revision: '', size: 0, error: result.error };

	const separator = index(result.output, '\n');
	if (separator < 0)
		return { ok: false, content: '', revision: '', size: 0, error: 'invalid-editor-response' };

	const header = substr(result.output, 0, separator);
	const fields = split(header, '\t');
	if (length(fields) != 2 || !match(fields[0], /^[0-9a-f]{64}$/))
		return { ok: false, content: '', revision: '', size: 0, error: 'invalid-editor-response' };

	const size = int(+fields[1]);
	if (size < 0 || size > MAX_EDIT_BYTES)
		return { ok: false, content: '', revision: '', size: 0, error: 'invalid-editor-response' };

	const content = substr(result.output, separator + 1);
	if (length(content) != size)
		return { ok: false, content: '', revision: '', size: 0, error: 'invalid-editor-response' };

	return { ok: true, content: content, revision: fields[0], size: size, error: '' };
}

function foreign_revision(name) {
	if (!valid_name(name))
		return { ok: false, revision: '', error: 'invalid-name' };

	const result = run_editor_read(['revision', name]);
	if (!result.ok)
		return { ok: false, revision: '', error: result.error };

	const revision = trim(result.output);
	if (!match(revision, /^[0-9a-f]{64}$/))
		return { ok: false, revision: '', error: 'invalid-editor-response' };

	return { ok: true, revision: revision, error: '' };
}

function replace_active(name, revision, content) {
	if (!valid_name(name))
		return { ok: false, changed: false, error: 'invalid-name' };
	if (length(content) > MAX_EDIT_BYTES)
		return { ok: false, changed: false, error: 'content-too-large' };
	if (!match(revision || '', /^[0-9a-f]{64}$/))
		return { ok: false, changed: false, error: 'invalid-revision' };

	const result = run_editor_write(['replace', name, revision], content);
	return result.ok
		? { ok: true, changed: true, error: '' }
		: { ok: false, changed: false, error: result.error };
}

function create_foreign(name, content) {
	if (!valid_name(name))
		return { ok: false, created: false, error: 'invalid-name' };
	if (length(content) > MAX_EDIT_BYTES)
		return { ok: false, created: false, error: 'content-too-large' };

	const result = run_editor_write(['create', name], content);
	return result.ok
		? { ok: true, created: true, error: '' }
		: { ok: false, created: false, error: result.error };
}

function rename_active(name, new_name, revision) {
	if (!valid_name(name) || !valid_name(new_name) || name == new_name)
		return { ok: false, renamed: false, error: 'invalid-name' };
	if (!match(revision || '', /^[0-9a-f]{64}$/))
		return { ok: false, renamed: false, error: 'invalid-revision' };

	const result = run_editor_read(['rename', name, new_name, revision]);
	return result.ok
		? { ok: true, renamed: true, error: '' }
		: { ok: false, renamed: false, error: result.error };
}

const methods = {
	inventory: { call: function () { return inventory(); } },
	firewall_status: { call: function () { return firewall_status(); } },
	firewall_preflight: { call: function () { return firewall_preflight(); } },
	certificate_status: { call: function () { return certificate_status(); } },
	certificate_preflight: { call: function () { return certificate_preflight(); } },
	managed_content: {
		args: { role: '', side: '' },
		call: function (request) { return managed_content(request.args.role, request.args.side); }
	},
	foreign_content: {
		args: { name: '' },
		call: function (request) { return foreign_content(request.args.name); }
	},
	foreign_revision: {
		args: { name: '' },
		call: function (request) { return foreign_revision(request.args.name); }
	},
	quarantine: {
		args: { name: '' },
		call: function (request) { return mutation('quarantine', request.args.name); }
	},
	restore: {
		args: { name: '' },
		call: function (request) { return mutation('restore', request.args.name); }
	},
	delete_active: {
		args: { name: '' },
		call: function (request) { return mutation('delete-active', request.args.name); }
	},
	delete_quarantined: {
		args: { name: '' },
		call: function (request) { return mutation('delete-quarantined', request.args.name); }
	},
	replace_active: {
		args: { name: '', revision: '', content: '' },
		call: function (request) { return replace_active(request.args.name, request.args.revision, request.args.content); }
	},
	create_foreign: {
		args: { name: '', content: '' },
		call: function (request) { return create_foreign(request.args.name, request.args.content); }
	},
	rename_active: {
		args: { name: '', new_name: '', revision: '' },
		call: function (request) { return rename_active(request.args.name, request.args.new_name, request.args.revision); }
	},
	repair: {
		call: function () {
			const result = run_admin(['repair']);
			return result.ok
				? { ok: true, message: trim(result.output), error: '' }
				: { ok: false, message: '', error: result.error };
		}
	}
};

return { 'telego.nginx': methods };

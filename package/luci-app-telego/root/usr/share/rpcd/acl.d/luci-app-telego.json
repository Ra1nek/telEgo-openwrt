{
  "luci-app-telego": {
    "description": "Grant access to telEgo configuration and service status",
    "read": {
      "uci": ["telego"],
      "ubus": {
        "service": ["list"]
      },
      "file": {
        "/var/etc/telego.toml": ["read"]
      }
    },
    "write": {
      "uci": ["telego"]
    }
  }
}

{
  "luci-app-telego": {
    "description": "Grant access to telEgo configuration, Nginx ingress/file administration and service telemetry",
    "read": {
      "uci": ["telego", "nginx_telego"],
      "ubus": {
        "service": ["list"],
        "telego": ["status"],
        "telego.nginx": ["inventory", "managed_content", "foreign_content", "foreign_revision"]
      }
    },
    "write": {
      "uci": ["telego", "nginx_telego"],
      "ubus": {
        "telego.nginx": ["quarantine", "restore", "delete_active", "delete_quarantined", "replace_active", "create_foreign", "rename_active", "repair"]
      }
    }
  }
}

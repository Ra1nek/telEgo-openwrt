{
  "admin/services/telego": {
    "title": "telEgo",
    "order": 60,
    "action": {
      "type": "firstchild",
      "preferred": "configuration",
      "recurse": true
    },
    "depends": {
      "acl": [
        "luci-app-telego"
      ]
    }
  },
  "admin/services/telego/configuration": {
    "title": "Configuration",
    "order": 10,
    "action": {
      "type": "view",
      "path": "telego/config"
    },
    "depends": {
      "acl": [
        "luci-app-telego"
      ]
    }
  },
  "admin/services/telego/ingress": {
    "title": "WEB Ingress",
    "order": 20,
    "action": {
      "type": "view",
      "path": "telego/ingress"
    },
    "depends": {
      "acl": [
        "luci-app-telego"
      ],
      "fs": {
        "/etc/config/nginx_telego": "file",
        "/usr/libexec/nginx-telego-reconcile": "executable",
        "/usr/libexec/nginx-telego-firewall": "executable",
        "/usr/libexec/nginx-telego-cert": "executable"
      }
    }
  },
  "admin/services/telego/nginx-files": {
    "title": "Nginx Files",
    "order": 30,
    "action": {
      "type": "view",
      "path": "telego/nginx-files"
    },
    "depends": {
      "acl": [
        "luci-app-telego"
      ],
      "fs": {
        "/usr/libexec/nginx-telego-admin": "executable",
        "/usr/libexec/nginx-telego-editor": "executable",
        "/usr/share/nginx-telego/ownership.tsv": "file"
      }
    }
  },
  "admin/services/telego/advanced": {
    "title": "Advanced Settings",
    "order": 15,
    "action": {
      "type": "view",
      "path": "telego/advanced"
    },
    "depends": {
      "acl": [
        "luci-app-telego"
      ]
    }
  }
}

config general 'general'
	option enabled '0'
	option bind_to '0.0.0.0:443'
	option log_level 'info'
	option proxy_protocol '0'
	option max_connections_per_ip '100'
	option max_ips_per_user '10'
	option ip_block_timeout '5m'
	option handshake_timeout '5s'
	option clock_sync_url ''

config tls_fronting 'tls_fronting'
	option mask_host 'www.google.com'
	option mask_port '443'
	option cert_host ''
	option cert_port ''
	option fake_cert_size '0'
	option splice_host ''
	option splice_port ''
	option splice_proxy_protocol '0'
	option splice_idle_timeout '30s'
	option enable_drs '1'
	option enable_split_tls '1'

config web_proxy 'web_proxy'
	option enabled '0'
	option carrier 'https-lanes'
	option bind_to '127.0.0.1:8080'
	option hostname ''
	option backend ''
	option num_event_loops '0'
	list trusted_proxy_cidrs '127.0.0.1/32'

config middle_end 'middle_end'
	option enabled '0'
	option proxy_tag ''
	option socks5 ''
	option socks5_username ''
	option socks5_password ''
	option artifact_proxy ''
	option nat_ip ''
	option max_connections '0'
	option queue_budget_mb '0'

config performance 'performance'
	option tcp_buffer_kb '128'
	option num_event_loops '0'
	option prefer_ip 'prefer-ipv4'
	option idle_timeout '5m'
	option max_write_buffer_mb '0'
	option client_silence_close '0s'

config upstream 'upstream'
	option socks5 ''

config metrics 'metrics'
	option bind_to '127.0.0.1:9090'
	option path '/metrics'
	option diagnostics '0'

config secret 'default'
	option name 'default'
	option secret ''
	option description 'Default proxy secret'

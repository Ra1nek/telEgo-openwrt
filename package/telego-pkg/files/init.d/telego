#!/bin/sh /etc/rc.common

START=95
STOP=20
USE_PROCD=1

PROG=/usr/bin/telego
UCI_CONFIG=telego
UCI_FILE=/etc/config/telego
RUNTIME_CONFIG=/var/etc/telego.toml
CAPS=/etc/capabilities/telego.json

toml_quote() {
	printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g; s/	/\\t/g'
}

uci_get_default() {
	local section="$1" option="$2" default="$3" value
	value="$(uci -q get "${UCI_CONFIG}.${section}.${option}" 2>/dev/null)"
	[ -n "$value" ] && printf '%s' "$value" || printf '%s' "$default"
}

uci_bool() {
	case "$(uci_get_default "$1" "$2" "$3")" in
		1|true|yes|on) printf 'true' ;;
		*) printf 'false' ;;
	esac
}

write_toml_string() {
	printf '%s = "%s"\n' "$1" "$(toml_quote "$2")"
}

write_toml_int() {
	local value="$2"
	case "$value" in ''|*[!0-9-]*) value=0 ;; esac
	printf '%s = %s\n' "$1" "$value"
}

write_toml_bool() {
	printf '%s = %s\n' "$1" "$(uci_bool "$2" "$3" "$4")"
}

_emit_toml_list_item() {
	local value="$1"
	[ -n "$value" ] || return 0
	[ -n "$LIST_FIRST" ] && printf ', '
	printf '"%s"' "$(toml_quote "$value")"
	LIST_FIRST=1
}

_emit_secret() {
	local section="$1" name secret
	name="$(uci_get_default "$section" name "$section")"
	secret="$(uci_get_default "$section" secret '')"
	[ -n "$secret" ] || return 0
	printf '"%s" = "%s"\n' "$(toml_quote "$name")" "$(toml_quote "$secret")"
}

generate_config() {
	local tmp="${RUNTIME_CONFIG}.$$" value
	mkdir -p /var/etc || return 1
	umask 077

	{
		echo '# Generated from /etc/config/telego. Do not edit.'
		echo
		echo '[general]'
		write_toml_string 'bind-to' "$(uci_get_default general bind_to '0.0.0.0:443')"
		write_toml_string 'log-level' "$(uci_get_default general log_level 'info')"
		write_toml_bool 'proxy-protocol' general proxy_protocol 0
		write_toml_int 'max-connections-per-ip' "$(uci_get_default general max_connections_per_ip '100')"
		write_toml_int 'max-ips-per-user' "$(uci_get_default general max_ips_per_user '10')"
		write_toml_string 'ip-block-timeout' "$(uci_get_default general ip_block_timeout '5m')"
		write_toml_string 'handshake-timeout' "$(uci_get_default general handshake_timeout '5s')"
		value="$(uci_get_default general clock_sync_url '')"; [ -n "$value" ] && write_toml_string 'clock-sync-url' "$value"

		echo; echo '[tls-fronting]'
		write_toml_string 'mask-host' "$(uci_get_default tls_fronting mask_host 'www.google.com')"
		write_toml_int 'mask-port' "$(uci_get_default tls_fronting mask_port '443')"
		value="$(uci_get_default tls_fronting cert_host '')"; [ -n "$value" ] && write_toml_string 'cert-host' "$value"
		value="$(uci_get_default tls_fronting cert_port '0')"; [ "$value" != 0 ] && write_toml_int 'cert-port' "$value"
		value="$(uci_get_default tls_fronting fake_cert_size '0')"; [ "$value" != 0 ] && write_toml_int 'fake-cert-size' "$value"
		value="$(uci_get_default tls_fronting splice_host '')"; [ -n "$value" ] && write_toml_string 'splice-host' "$value"
		value="$(uci_get_default tls_fronting splice_port '0')"; [ "$value" != 0 ] && write_toml_int 'splice-port' "$value"
		write_toml_int 'splice-proxy-protocol' "$(uci_get_default tls_fronting splice_proxy_protocol '0')"
		write_toml_string 'splice-idle-timeout' "$(uci_get_default tls_fronting splice_idle_timeout '30s')"
		write_toml_bool 'enable-drs' tls_fronting enable_drs 1
		write_toml_bool 'enable-split-tls' tls_fronting enable_split_tls 1
		printf 'mask-sni-safelist = ['; LIST_FIRST=; config_load "$UCI_CONFIG"; config_list_foreach tls_fronting mask_sni_safelist _emit_toml_list_item; printf ']\n'

		echo; echo '[performance]'
		write_toml_int 'tcp-buffer-kb' "$(uci_get_default performance tcp_buffer_kb '128')"
		write_toml_int 'num-event-loops' "$(uci_get_default performance num_event_loops '0')"
		write_toml_string 'prefer-ip' "$(uci_get_default performance prefer_ip 'prefer-ipv4')"
		write_toml_string 'idle-timeout' "$(uci_get_default performance idle_timeout '5m')"
		write_toml_int 'max-write-buffer-mb' "$(uci_get_default performance max_write_buffer_mb '0')"
		write_toml_string 'client-silence-close' "$(uci_get_default performance client_silence_close '0s')"

		echo; echo '[upstream]'
		write_toml_string 'socks5' "$(uci_get_default upstream socks5 '')"

		echo; echo '[metrics]'
		write_toml_string 'bind-to' "$(uci_get_default metrics bind_to '127.0.0.1:9090')"
		write_toml_string 'path' "$(uci_get_default metrics path '/metrics')"

		echo; echo '[web-proxy]'
		write_toml_bool 'enabled' web_proxy enabled 0
		write_toml_string 'carrier' "$(uci_get_default web_proxy carrier 'https-lanes')"
		write_toml_string 'bind-to' "$(uci_get_default web_proxy bind_to '127.0.0.1:8443')"
		write_toml_string 'hostname' "$(uci_get_default web_proxy hostname '')"
		write_toml_string 'backend' "$(uci_get_default web_proxy backend '')"
		write_toml_int 'num-event-loops' "$(uci_get_default web_proxy num_event_loops '0')"
		printf 'trusted-proxy-cidrs = ['; LIST_FIRST=; config_load "$UCI_CONFIG"; config_list_foreach web_proxy trusted_proxy_cidrs _emit_toml_list_item; printf ']\n'

		echo; echo '[middle-end]'
		write_toml_bool 'enabled' middle_end enabled 0
		write_toml_string 'proxy-tag' "$(uci_get_default middle_end proxy_tag '')"
		write_toml_string 'socks5' "$(uci_get_default middle_end socks5 '')"
		write_toml_string 'socks5-username' "$(uci_get_default middle_end socks5_username '')"
		write_toml_string 'socks5-password' "$(uci_get_default middle_end socks5_password '')"
		write_toml_string 'artifact-proxy' "$(uci_get_default middle_end artifact_proxy '')"
		write_toml_string 'nat-ip' "$(uci_get_default middle_end nat_ip '')"
		write_toml_int 'max-connections' "$(uci_get_default middle_end max_connections '0')"
		write_toml_int 'queue-budget-mb' "$(uci_get_default middle_end queue_budget_mb '0')"

		echo; echo '[secrets]'
		config_load "$UCI_CONFIG"
		config_foreach _emit_secret secret
	} > "$tmp" || { rm -f "$tmp"; return 1; }

	chmod 0600 "$tmp" && mv -f "$tmp" "$RUNTIME_CONFIG"
}

service_triggers() {
	procd_add_reload_trigger "$UCI_CONFIG"
}

start_service() {
	local enabled
	config_load "$UCI_CONFIG"
	config_get_bool enabled general enabled 0
	[ "$enabled" -eq 1 ] || return 0

	generate_config || {
		echo 'telego: failed to generate TOML configuration' >&2
		return 1
	}
	[ -s "$RUNTIME_CONFIG" ] || return 1
	[ -x "$PROG" ] || { echo "telego: $PROG not found" >&2; return 1; }

	procd_open_instance
	procd_set_param command "$PROG" run --config "$RUNTIME_CONFIG"
	procd_set_param user telego
	procd_set_param group telego
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file "$RUNTIME_CONFIG"
	procd_set_param reload_signal HUP

	if [ -x /sbin/ujail ] && [ -r "$CAPS" ]; then
		procd_add_jail telego ronly log requirejail
		procd_add_jail_mount /etc/ssl/certs/ca-certificates.crt /etc/resolv.conf
		procd_add_jail_mount_rw /var/etc
		procd_set_param capabilities "$CAPS"
		procd_set_param no_new_privs 1
	fi

	procd_close_instance
}

reload_service() {
	generate_config || return 1
	procd_send_signal telego HUP
}

stop_service() {
	procd_kill telego
}

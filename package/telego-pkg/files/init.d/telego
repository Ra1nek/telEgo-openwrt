#!/bin/sh /etc/rc.common

START=95
STOP=20
USE_PROCD=1

PROG=/usr/bin/telego
UCI_CONFIG=telego
RUNTIME_CONFIG=/var/etc/telego.toml
CAPS=/etc/capabilities/telego.json
TELEGO_USER=telego
TELEGO_GROUP=telego

toml_quote() {
	printf '%s' "$1" |
		sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/	/\\t/g'
}

uci_get_default() {
	local section="$1" option="$2" default="$3" value
	value="$(uci -q get "${UCI_CONFIG}.${section}.${option}" 2>/dev/null)"
	[ -n "$value" ] && printf '%s' "$value" || printf '%s' "$default"
}

uci_bool() {
	case "$(uci_get_default "$1" "$2" "$3")" in
		1|true|yes|on) printf 'true' ;;
		*) printf 'false' ;;
	esac
}

write_toml_string() {
	printf '%s = "%s"\n' "$1" "$(toml_quote "$2")"
}

write_toml_int() {
	local value="$2"
	case "$value" in
		''|*[!0-9-]*) value=0 ;;
	esac
	printf '%s = %s\n' "$1" "$value"
}

write_toml_bool() {
	printf '%s = %s\n' "$1" "$(uci_bool "$2" "$3" "$4")"
}

emit_toml_list_item() {
	local value="$1"
	[ -n "$value" ] || return 0
	[ -n "$LIST_FIRST" ] && printf ', '
	printf '"%s"' "$(toml_quote "$value")"
	LIST_FIRST=1
}

emit_secret() {
	local section="$1" name secret
	name="$(uci_get_default "$section" name "$section")"
	secret="$(uci_get_default "$section" secret '')"

	[ -n "$secret" ] || return 0

	case "$secret" in
		????????????????????????????????) ;;
		*) echo "telego: invalid secret in UCI section $section" >&2; return 1 ;;
	esac

	case "$secret" in
		*[!0123456789abcdefABCDEF]*)
			echo "telego: secret in UCI section $section is not hexadecimal" >&2
			return 1
			;;
	esac

	printf '"%s" = "%s"\n' \
		"$(toml_quote "$name")" \
		"$(toml_quote "$secret")"
}

ensure_service_account() {
	local gid
	# rc.common loads /lib/functions.sh. USERID creates these at package install;
	# the fallback also repairs installations of older package revisions.
	gid="$(group_add_next "$TELEGO_GROUP")" || return 1
	[ -n "$gid" ] || return 1
	user_exists "$TELEGO_USER" ||
		user_add "$TELEGO_USER" "" "$gid" 'telEgo proxy' '/var/run/telego' '/bin/false'
}

generate_config() {
	local tmp="${RUNTIME_CONFIG}.$$" value

	mkdir -p /var/etc || return 1
	umask 077
	config_load "$UCI_CONFIG"

	{
		printf '%s\n\n' '# Generated from /etc/config/telego. Do not edit.'

		printf '%s\n' '[general]'
		write_toml_string 'bind-to' "$(uci_get_default general bind_to '0.0.0.0:443')"
		write_toml_string 'log-level' "$(uci_get_default general log_level 'info')"
		write_toml_bool 'proxy-protocol' general proxy_protocol 0
		write_toml_int 'max-connections-per-ip' "$(uci_get_default general max_connections_per_ip '100')"
		write_toml_int 'max-ips-per-user' "$(uci_get_default general max_ips_per_user '10')"
		write_toml_string 'ip-block-timeout' "$(uci_get_default general ip_block_timeout '5m')"
		write_toml_string 'handshake-timeout' "$(uci_get_default general handshake_timeout '5s')"
		value="$(uci_get_default general clock_sync_url '')"
		[ -n "$value" ] && write_toml_string 'clock-sync-url' "$value"

		printf '\n%s\n' '[tls-fronting]'
		write_toml_string 'mask-host' "$(uci_get_default tls_fronting mask_host 'www.google.com')"
		write_toml_int 'mask-port' "$(uci_get_default tls_fronting mask_port '443')"
		value="$(uci_get_default tls_fronting cert_host '')"
		[ -n "$value" ] && write_toml_string 'cert-host' "$value"
		value="$(uci_get_default tls_fronting cert_port '')"
		[ -n "$value" ] && write_toml_int 'cert-port' "$value"
		value="$(uci_get_default tls_fronting fake_cert_size '0')"
		[ "$value" != 0 ] && write_toml_int 'fake-cert-size' "$value"

		printf 'mask-sni-safelist = ['
		LIST_FIRST=
		config_list_foreach tls_fronting mask_sni_safelist emit_toml_list_item
		printf ']\n'

		value="$(uci_get_default tls_fronting splice_host '')"
		[ -n "$value" ] && write_toml_string 'splice-host' "$value"
		value="$(uci_get_default tls_fronting splice_port '')"
		[ -n "$value" ] && write_toml_int 'splice-port' "$value"
		write_toml_int 'splice-proxy-protocol' "$(uci_get_default tls_fronting splice_proxy_protocol '0')"
		write_toml_string 'splice-idle-timeout' "$(uci_get_default tls_fronting splice_idle_timeout '30s')"
		write_toml_bool 'enable-drs' tls_fronting enable_drs 1
		write_toml_bool 'enable-split-tls' tls_fronting enable_split_tls 1

		printf '\n%s\n' '[performance]'
		write_toml_int 'tcp-buffer-kb' "$(uci_get_default performance tcp_buffer_kb '128')"
		write_toml_int 'num-event-loops' "$(uci_get_default performance num_event_loops '0')"
		write_toml_string 'prefer-ip' "$(uci_get_default performance prefer_ip 'prefer-ipv4')"
		write_toml_string 'idle-timeout' "$(uci_get_default performance idle_timeout '5m')"
		write_toml_int 'max-write-buffer-mb' "$(uci_get_default performance max_write_buffer_mb '0')"
		write_toml_string 'client-silence-close' "$(uci_get_default performance client_silence_close '0s')"

		printf '\n%s\n' '[upstream]'
		write_toml_string 'socks5' "$(uci_get_default upstream socks5 '')"

		printf '\n%s\n' '[metrics]'
		write_toml_string 'bind-to' "$(uci_get_default metrics bind_to '127.0.0.1:9090')"
		write_toml_string 'path' "$(uci_get_default metrics path '/metrics')"
		write_toml_bool 'diagnostics' metrics diagnostics 0

		printf '\n%s\n' '[web-proxy]'
		write_toml_bool 'enabled' web_proxy enabled 0
		write_toml_string 'carrier' "$(uci_get_default web_proxy carrier 'https-lanes')"
		write_toml_string 'bind-to' "$(uci_get_default web_proxy bind_to '127.0.0.1:8080')"
		write_toml_string 'hostname' "$(uci_get_default web_proxy hostname '')"
		write_toml_string 'backend' "$(uci_get_default web_proxy backend '')"
		write_toml_int 'num-event-loops' "$(uci_get_default web_proxy num_event_loops '0')"

		printf 'trusted-proxy-cidrs = ['
		LIST_FIRST=
		config_list_foreach web_proxy trusted_proxy_cidrs emit_toml_list_item
		printf ']\n'

		printf '\n%s\n' '[middle-end]'
		write_toml_bool 'enabled' middle_end enabled 0
		write_toml_string 'proxy-tag' "$(uci_get_default middle_end proxy_tag '')"
		write_toml_string 'socks5' "$(uci_get_default middle_end socks5 '')"
		write_toml_string 'socks5-username' "$(uci_get_default middle_end socks5_username '')"
		write_toml_string 'socks5-password' "$(uci_get_default middle_end socks5_password '')"
		write_toml_string 'artifact-proxy' "$(uci_get_default middle_end artifact_proxy '')"
		write_toml_string 'nat-ip' "$(uci_get_default middle_end nat_ip '')"
		write_toml_int 'max-connections' "$(uci_get_default middle_end max_connections '0')"
		write_toml_int 'queue-budget-mb' "$(uci_get_default middle_end queue_budget_mb '0')"

		printf '\n%s\n' '[secrets]'
		config_foreach emit_secret secret
	} > "$tmp" || {
		rm -f "$tmp"
		return 1
	}

	chown "$TELEGO_USER:$TELEGO_GROUP" "$tmp" || {
		rm -f "$tmp"
		return 1
	}

	chmod 0600 "$tmp" || {
		rm -f "$tmp"
		return 1
	}

	mv -f "$tmp" "$RUNTIME_CONFIG"
}

service_triggers() {
	procd_add_reload_trigger "$UCI_CONFIG"
}

start_service() {
	local enabled

	ensure_service_account || {
		echo 'telego: unable to create service account' >&2
		return 1
	}

	config_load "$UCI_CONFIG"
	config_get_bool enabled general enabled 0
	[ "$enabled" -eq 1 ] || return 0

	[ -x "$PROG" ] || {
		echo "telego: missing $PROG" >&2
		return 1
	}

	[ -x /sbin/ujail ] || {
		echo 'telego: /sbin/ujail is required' >&2
		return 1
	}

	[ -r "$CAPS" ] || {
		echo "telego: missing $CAPS" >&2
		return 1
	}

	generate_config || {
		echo 'telego: failed to generate TOML configuration' >&2
		return 1
	}

	procd_open_instance telego
	procd_set_param command "$PROG" run --config "$RUNTIME_CONFIG"
	procd_set_param user "$TELEGO_USER"
	procd_set_param group "$TELEGO_GROUP"
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param file "$RUNTIME_CONFIG"

	# The Go binary is deliberately built as a static PIE. ujail's read-only
	# dependency scanner expects a PT_DYNAMIC section, so do not request ronly.
	# The jail still isolates namespaces/filesystem access and drops privileges.
	procd_add_jail telego log requirejail
	procd_add_jail_mount /etc/ssl/certs/ca-certificates.crt
	procd_add_jail_mount /etc/resolv.conf
	procd_add_jail_mount /etc/hosts
	procd_add_jail_mount /dev/urandom
	procd_add_jail_mount_rw /var/etc
	procd_set_param capabilities "$CAPS"
	procd_set_param no_new_privs 1

	procd_close_instance
}

# Use rc.common's default procd reload: rebuild the instance definition.
# A changed runtime-config checksum restarts the process (secrets and listeners
# are not hot-reloadable). An enabled=0 configuration removes the instance;
# enabled=1 creates it even when the service was previously stopped.

stop_service() {
	procd_kill telego
}

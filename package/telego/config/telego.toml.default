# After changes, run: /etc/init.d/telego reload
[general]
bind-to = "0.0.0.0:443"
log-level = "info"
proxy-protocol = false
max-connections-per-ip = 100
max-ips-per-user = 10
ip-block-timeout = "1h"
handshake-timeout = "5s"
[secrets]

# user1 = "0123456789abcdef0123456789abcdef"
[tls-fronting]
enabled = true
mask-host = "www.google.com"
mask-port = 443
cert-host = ""
cert-port = 0
[web-proxy]
enabled = false
carrier = "https-lanes"
bind-to = "127.0.0.1:8443"
hostname = ""
backend = ""
trusted-proxy-cidrs = ["127.0.0.0/8"]
[performance]
tcp-buffer-kb = 128
prefer-ip = "prefer-ipv4"
idle-timeout = "5m"
num-event-loops = 0
[upstream]
retry-delay = "1s"
connect-timeout = "10s"
[metrics]
enabled = false
bind-to = "127.0.0.1:9090"
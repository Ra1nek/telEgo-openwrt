#!/bin/sh /etc/rc.common

# =============================================================================
# telEgo Init Script - OpenWrt ProCD Service Management (SECURITY HARDENED)
# Supports SIGHUP hot-reload for configuration changes without restart
# Implements capability-based privilege dropping per security best practices
# =============================================================================
START=95
STOP=20
SERVICE_USE_PROCD=1
SERVICE_PIDFILE=/var/run/telego.pid
CONFIG_FILE=/etc/config/telego
DEFAULT_CONFIG=/etc/config/telego.default

# -----------------------------------------------------------------------------
service_triggers() {
	procd_add_reload_trigger "$CONFIG_FILE"
}

get_config_file() {
	if [ -f "$CONFIG_FILE" ]; then
		echo "$CONFIG_FILE"
	elif [ -f "$DEFAULT_CONFIG" ]; then
		cp "$DEFAULT_CONFIG" "$CONFIG_FILE" 2>/dev/null || true
		echo "$CONFIG_FILE"
	else
		echo "$DEFAULT_CONFIG"
	fi
}

# SECURITY: Create dedicated telego user/group if not exists (privilege separation)
create_service_user() {
	if ! grep -q "^telego:" /etc/passwd 2>/dev/null; then
		useradd -r -s /usr/sbin/nologin -M telego 2>/dev/null || true
	fi
}

cmd_start_service() {
	local config_file=$(get_config_file)
	
	# Ensure config directory exists
	mkdir -p "$(dirname "$config_file")" 2>/dev/null || true
	
	# SECURITY: Create dedicated user for privilege separation
	create_service_user
	
	procd_open_instance telego
		procd_set_param path /usr/bin/telego
		procd_set_param command run --config "$config_file"
		
		# SECURITY: Drop privileges to dedicated 'telego' user after binding
		# Binary starts as root (via setcap), then drops to 'telego' for security
		procd_set_param user telego
		procd_set_param group telego
		
		procd_set_param respawn true
		procd_set_param respawn_threshold 5
		procd_set_param pidfile "/var/run/telego.pid"
		procd_set_param stdout 1
		procd_set_param stderr 1
		procd_set_param reload_signal HUP
		
		# Health check - verify service is responding
		procd_set_param command_check "pgrep -f 'telego run' > /dev/null"
	procd_close_instance
}

cmd_stop_service() {
	local pid=$(cat /var/run/telego.pid 2>/dev/null)
	if [ -n "$pid" ] && ps -p "$pid" > /dev/null 2>&1; then
		kill "$pid" 2>/dev/null || true
	fi
}

cmd_reload_service() {
	local pid=$(cat /var/run/telego.pid 2>/dev/null)
	if [ -n "$pid" ] && ps -p "$pid" > /dev/null 2>&1; then
		kill -HUP "$pid" 2>/dev/null || true
		echo "Telego configuration reloaded (PID: $pid)"
		return 0
	else
		echo "Telego is not running, cannot reload"
		return 1
	fi
}

cmd_status() {
	local pid=$(cat /var/run/telego.pid 2>/dev/null)
	if [ -n "$pid" ] && ps -p "$pid" > /dev/null 2>&1; then
		echo "Running (PID: $pid)"
		return 0
	else
		echo "Stopped"
		return 1
	fi
}

cmd_status_json() {
	local pid=$(cat /var/run/telego.pid 2>/dev/null)
	if [ -n "$pid" ] && ps -p "$pid" > /dev/null 2>&1; then
		echo '{"running": true, "pid": '$pid'}'
		return 0
	else
		echo '{"running": false}'
		return 1
	fi
}

export_service_functions()
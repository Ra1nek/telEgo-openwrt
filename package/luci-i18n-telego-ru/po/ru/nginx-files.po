msgid "Nginx Files"
msgstr "Файлы Nginx"

msgid "Nginx File Inventory"
msgstr "Инвентаризация файлов Nginx"

msgid "Inspect nginx-telego managed files and administrator-owned .conf files. Foreign files are never adopted automatically. Create, rename, quarantine, restore, delete and restricted edit actions share the reconciliation lock and validate active changes with nginx -t."
msgstr "Просмотр файлов под управлением nginx-telego и файлов .conf, принадлежащих администратору. Чужие файлы никогда не принимаются под управление автоматически. Создание, переименование, карантин, восстановление, удаление и ограниченное редактирование используют общую блокировку reconciliation и проверяют активные изменения командой nginx -t."

msgid "Operation failed."
msgstr "Операция завершилась ошибкой."

msgid "The file changed after it was opened. Refresh it before continuing."
msgstr "Файл изменился после открытия. Обновите его перед продолжением."

msgid "Nginx file content is too large."
msgstr "Содержимое файла Nginx слишком велико."

msgid "The file revision is invalid. Refresh the inventory before continuing."
msgstr "Версия файла недействительна. Обновите инвентаризацию перед продолжением."

msgid "Nginx file backend is unavailable."
msgstr "Backend файлов Nginx недоступен."

msgid "Nginx file operation failed."
msgstr "Операция с файлом Nginx завершилась ошибкой."

msgid "The Nginx file name is not allowed."
msgstr "Имя файла Nginx недопустимо."

msgid "The destination Nginx file already exists."
msgstr "Файл Nginx с таким именем уже существует."

msgid "The destination name is reserved for telEgo-managed Nginx state."
msgstr "Это имя зарезервировано для файлов Nginx под управлением telEgo."

msgid "Foreign / quarantined"
msgstr "Чужой / в карантине"
msgid "Package-owned"
msgstr "Принадлежит пакету"
msgid "Foreign on reserved path"
msgstr "Чужой файл в зарезервированном пути"
msgid "Generated by telEgo"
msgstr "Сгенерирован telEgo"
msgid "Foreign / administrator-owned"
msgstr "Чужой / принадлежит администратору"
msgid "In sync"
msgstr "В порядке"
msgid "Modified"
msgstr "Изменён"
msgid "Missing"
msgstr "Отсутствует"
msgid "Managed"
msgstr "Управляется telEgo"
msgid "Absent"
msgstr "Отсутствует"
msgid "Foreign"
msgstr "Чужой"
msgid "Active"
msgstr "Активен"
msgid "Quarantined"
msgstr "В карантине"
msgid "Unsafe file type"
msgstr "Небезопасный тип файла"
msgid "Canonical source missing"
msgstr "Канонический источник отсутствует"
msgid "Canonical source unsafe"
msgstr "Канонический источник небезопасен"
msgid "Unknown"
msgstr "Неизвестно"
msgid "Cancel"
msgstr "Отмена"
msgid "Diff is unavailable because the file has too many lines."
msgstr "Сравнение недоступно: в файле слишком много строк."
msgid "Refresh"
msgstr "Обновить"
msgid "Create file"
msgstr "Создать файл"
msgid "Repair Managed State"
msgstr "Восстановить управляемое состояние"
msgid "Managed Nginx state repaired."
msgstr "Управляемое состояние Nginx восстановлено."
msgid "Some Nginx entries were hidden because their names or file types are unsafe for administration. Review them over SSH."
msgstr "Некоторые элементы Nginx скрыты, потому что их имена или типы файлов небезопасны для администрирования. Проверьте их через SSH."
msgid "File"
msgstr "Файл"
msgid "Ownership"
msgstr "Владелец"
msgid "State"
msgstr "Состояние"
msgid "Role"
msgstr "Роль"
msgid "Actions"
msgstr "Действия"
msgid "—"
msgstr "—"
msgid "Diff"
msgstr "Различия"
msgid "Edit"
msgstr "Редактировать"
msgid "Rename"
msgstr "Переименовать"
msgid "Edit Nginx file"
msgstr "Редактирование файла Nginx"
msgid "This restricted editor can modify only an existing foreign administrator-owned .conf file. telEgo-managed files cannot be edited here."
msgstr "Этот ограниченный редактор может изменять только существующий чужой файл .conf, принадлежащий администратору. Файлы под управлением telEgo здесь редактировать нельзя."
msgid "Editor content is limited to 64 KiB. The file is revalidated with nginx -t and rolled back if validation or reload fails."
msgstr "Размер содержимого редактора ограничен 64 КиБ. Файл повторно проверяется командой nginx -t и откатывается при ошибке проверки или перезагрузки."
msgid "No changes to save."
msgstr "Нет изменений для сохранения."
msgid "Review changes"
msgstr "Проверить изменения"
msgid "Review Nginx changes"
msgstr "Проверка изменений Nginx"
msgid "Lines prefixed with - are from the current file; lines prefixed with + are from the edited version."
msgstr "Строки с префиксом - относятся к текущему файлу; строки с префиксом + — к отредактированной версии."
msgid "Back"
msgstr "Назад"
msgid "Save changes"
msgstr "Сохранить изменения"
msgid "Nginx file updated."
msgstr "Файл Nginx обновлён."

msgid "Create Nginx file"
msgstr "Создание файла Nginx"
msgid "A new file can be created only as a foreign administrator-owned direct child of /etc/nginx/conf.d/. telEgo-managed names cannot be used."
msgstr "Новый файл можно создать только как чужой файл администратора непосредственно в /etc/nginx/conf.d/. Имена файлов под управлением telEgo использовать нельзя."
msgid "File name"
msgstr "Имя файла"
msgid "Content is limited to 64 KiB. The new file is activated only after nginx -t succeeds and is removed again if validation or reload fails."
msgstr "Размер содержимого ограничен 64 КиБ. Новый файл активируется только после успешной проверки nginx -t и удаляется при ошибке проверки или перезагрузки."
msgid "Review new file"
msgstr "Проверить новый файл"
msgid "Review new Nginx file"
msgstr "Проверка нового файла Nginx"
msgid "The following content will be added as a new administrator-owned file."
msgstr "Следующее содержимое будет добавлено как новый файл, принадлежащий администратору."
msgid "Nginx file created."
msgstr "Файл Nginx создан."

msgid "Rename Nginx file"
msgstr "Переименование файла Nginx"
msgid "Only an active foreign administrator-owned .conf file can be renamed. The destination must not exist and cannot be reserved for telEgo-managed state."
msgstr "Переименовать можно только активный чужой файл .conf, принадлежащий администратору. Файл с новым именем не должен существовать, а имя не должно быть зарезервировано telEgo."
msgid "Current name"
msgstr "Текущее имя"
msgid "New file name"
msgstr "Новое имя файла"
msgid "Choose a different file name."
msgstr "Укажите другое имя файла."
msgid "The rename is protected by the file revision, validated with nginx -t and rolled back if validation or reload fails."
msgstr "Переименование защищено проверкой версии файла, проверяется командой nginx -t и откатывается при ошибке проверки или перезагрузки."
msgid "Nginx file renamed."
msgstr "Файл Nginx переименован."

msgid "Quarantine"
msgstr "В карантин"
msgid "Delete"
msgstr "Удалить"
msgid "Delete Nginx file"
msgstr "Удаление файла Nginx"
msgid "Permanently delete the active foreign Nginx file?"
msgstr "Безвозвратно удалить активный чужой файл Nginx?"
msgid "Delete quarantined file"
msgstr "Удаление файла из карантина"
msgid "Permanently delete this quarantined Nginx file?"
msgstr "Безвозвратно удалить этот файл Nginx из карантина?"
msgid "Restore"
msgstr "Восстановить"
msgid "Managed file diff"
msgstr "Различия управляемого файла"
msgid "Lines prefixed with - are from the canonical package copy; lines prefixed with + are from the active file."
msgstr "Строки с префиксом - относятся к канонической копии пакета; строки с префиксом + — к активному файлу."
msgid "Close"
msgstr "Закрыть"

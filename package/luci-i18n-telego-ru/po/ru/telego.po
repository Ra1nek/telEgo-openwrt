msgid "Unable to read telEgo status."
msgstr "Не удалось получить статус telEgo."

msgid "telEgo Configuration"
msgstr "Конфигурация telEgo"

msgid "Configure MTProxy, TLS fronting, WEB Proxy, Middle-End and runtime limits."
msgstr "Настройка MTProxy, TLS-фронтинга, WEB-прокси, Middle-End и ограничений выполнения."

msgid "MTProxy"
msgstr "MTProxy"

msgid "Enable MTProxy"
msgstr "Включить MTProxy"

msgid "Listen Address"
msgstr "Адрес прослушивания"

msgid "Public TCP address where telEgo accepts MTProxy connections."
msgstr "Публичный TCP-адрес, на котором telEgo принимает соединения MTProxy."

msgid "Log Level"
msgstr "Уровень логирования"

msgid "Trace"
msgstr "Трассировка"

msgid "Debug"
msgstr "Отладка"

msgid "Info"
msgstr "Информация"

msgid "Warning"
msgstr "Предупреждение"

msgid "Error"
msgstr "Ошибка"

msgid "Accept Incoming PROXY Protocol"
msgstr "Принимать входящий PROXY Protocol"

msgid "Enable only when a trusted TCP proxy is directly in front of the public MTProxy listener."
msgstr "Включайте только если перед публичным MTProxy listener находится доверенный TCP-прокси."

msgid "Max Connections per IP"
msgstr "Максимум соединений на IP"

msgid "0 disables this connection-flood limit."
msgstr "0 отключает это ограничение от лавины соединений."

msgid "Max IPs per User"
msgstr "Максимум IP на пользователя"

msgid "0 disables per-secret IP limiting."
msgstr "0 отключает ограничение числа IP для одного секрета."

msgid "IP Block Timeout"
msgstr "Время блокировки IP"

msgid "Handshake Timeout"
msgstr "Таймаут handshake"

msgid "Clock Sync URL"
msgstr "URL синхронизации времени"

msgid "Optional HTTP(S) URL whose Date header corrects startup clock skew for FakeTLS validation."
msgstr "Необязательный HTTP(S)-URL, заголовок Date которого корректирует сдвиг часов при запуске для проверки FakeTLS."

msgid "TLS Fronting"
msgstr "TLS-фронтинг"

msgid "Mask Domain"
msgstr "Домен маскировки"

msgid "Hostname used for FakeTLS SNI validation and certificate fetching."
msgstr "Имя хоста для проверки SNI FakeTLS и получения сертификата."

msgid "Mask Port"
msgstr "Порт маскировки"

msgid "Certificate Host"
msgstr "Хост сертификата"

msgid "Optional certificate source. Native shared-port Nginx on this router uses 127.0.0.1."
msgstr "Необязательный источник сертификата. Для native shared-port Nginx на этом роутере используется 127.0.0.1."

msgid "Certificate Port"
msgstr "Порт сертификата"

msgid "Native shared-port Nginx uses port 8444 for certificate collection."
msgstr "Native shared-port Nginx использует порт 8444 для получения сертификата."

msgid "Fallback Host"
msgstr "Резервный хост"

msgid "Where unrecognized TLS is spliced. Native shared-port Nginx on this router uses 127.0.0.1."
msgstr "Куда передаётся нераспознанный TLS. Для native shared-port Nginx на этом роутере используется 127.0.0.1."

msgid "Fallback Port"
msgstr "Резервный порт"

msgid "Native shared-port Nginx uses port 8443 and PROXY protocol v2."
msgstr "Native shared-port Nginx использует порт 8443 и PROXY Protocol v2."

msgid "Fake Certificate Size"
msgstr "Размер фиктивного сертификата"

msgid "0 selects automatic matching; an explicit override must be from 256 to 16384 bytes."
msgstr "0 включает автоматический подбор; явное значение должно быть от 256 до 16384 байт."

msgid "Use 0 for automatic mode or a value from 256 to 16384."
msgstr "Укажите 0 для автоматического режима или значение от 256 до 16384."

msgid "Mask SNI Safelist"
msgstr "Разрешённые SNI для маскировки"

msgid "Fallback PROXY Protocol"
msgstr "PROXY Protocol для резервного соединения"

msgid "PROXY Protocol v1"
msgstr "PROXY Protocol v1"

msgid "PROXY Protocol v2"
msgstr "PROXY Protocol v2"

msgid "Fallback Idle Timeout"
msgstr "Таймаут простоя резервного соединения"

msgid "Enable DRS"
msgstr "Включить DRS"

msgid "Enable Split TLS"
msgstr "Включить Split TLS"

msgid "Users"
msgstr "Пользователи"

msgid "Username"
msgstr "Имя пользователя"

msgid "Secret (32 hex characters)"
msgstr "Секрет (32 hex-символа)"

msgid "Enter exactly 32 hexadecimal characters."
msgstr "Введите ровно 32 шестнадцатеричных символа."

msgid "Secret must contain exactly 32 hexadecimal characters."
msgstr "Секрет должен содержать ровно 32 шестнадцатеричных символа."

msgid "Generate random secret"
msgstr "Сгенерировать случайный секрет"

msgid "Generate"
msgstr "Сгенерировать"

msgid "WEB Proxy"
msgstr "WEB-прокси"

msgid "Enable WEB Proxy"
msgstr "Включить WEB-прокси"

msgid "Select the transport used by Telegram Desktop. HTTPS Lanes is the conservative upstream recommendation for new HTTP/2 deployments."
msgstr "Выберите транспорт Telegram Desktop. Для новых HTTP/2-развёртываний upstream рекомендует начинать с HTTPS Lanes."

msgid "HTTPS"
msgstr "HTTPS"

msgid "HTTPS Lanes"
msgstr "HTTPS Lanes"

msgid "WebSocket"
msgstr "WebSocket"

msgid "WebSocket Lanes"
msgstr "WebSocket Lanes"

msgid "Bind Address"
msgstr "Адрес привязки"

msgid "Private HTTP/1.1 listener. Keep this address inaccessible from the Internet."
msgstr "Приватный HTTP/1.1 listener. Этот адрес не должен быть доступен из Интернета."

msgid "Hostname"
msgstr "Имя хоста"

msgid "Hostname covered by the public TLS certificate or Cloudflare Published Application."
msgstr "Имя хоста из публичного TLS-сертификата или Cloudflare Published Application."

msgid "Trusted Proxy CIDRs"
msgstr "CIDR доверенных прокси"

msgid "Only these proxy addresses may supply forwarded client addresses."
msgstr "Только эти адреса прокси могут передавать исходный адрес клиента."

msgid "Compatibility Backend"
msgstr "Совместимый backend"

msgid "Optional local TCP or Unix backend. Leave empty to use the faster shared MTProxy core directly."
msgstr "Необязательный локальный TCP- или Unix-backend. Оставьте пустым, чтобы напрямую использовать более быстрый общий MTProxy core."

msgid "WEB Event Loops"
msgstr "Циклы событий WEB"

msgid "0 selects the automatic gnet event-loop count."
msgstr "0 выбирает количество циклов событий gnet автоматически."

msgid "Telegram Middle-End"
msgstr "Telegram Middle-End"

msgid "Enable Middle-End"
msgstr "Включить Middle-End"

msgid "Keep disabled unless you intentionally use Telegram Middle-End transport. Existing direct DC routing remains the default."
msgstr "Оставьте отключённым, если вы специально не используете транспорт Telegram Middle-End. Прямая маршрутизация к DC остаётся вариантом по умолчанию."

msgid "Proxy Tag"
msgstr "Тег прокси"

msgid "Optional registered Telegram proxy tag: exactly 32 hexadecimal characters."
msgstr "Необязательный зарегистрированный тег Telegram-прокси: ровно 32 шестнадцатеричных символа."

msgid "Proxy Tag must be empty or contain exactly 32 hexadecimal characters."
msgstr "Тег прокси должен быть пустым или содержать ровно 32 шестнадцатеричных символа."

msgid "SOCKS5 Proxy"
msgstr "SOCKS5-прокси"

msgid "SOCKS5 Username"
msgstr "Имя пользователя SOCKS5"

msgid "SOCKS5 Password"
msgstr "Пароль SOCKS5"

msgid "Artifact Proxy"
msgstr "Прокси для артефактов"

msgid "STUN NAT IP"
msgstr "NAT IP для STUN"

msgid "Middle-End Max Connections"
msgstr "Максимум соединений Middle-End"

msgid "0 uses the upstream default of 10000; an override may only reduce it."
msgstr "0 использует upstream-значение 10000; явное значение может только уменьшить лимит."

msgid "Use 0 or a value from 1 to 10000."
msgstr "Укажите 0 или значение от 1 до 10000."

msgid "Middle-End Queue Budget (MB)"
msgstr "Лимит очереди Middle-End (МБ)"

msgid "0 uses the upstream 32 MiB default; an override may be from 2 to 32 MiB."
msgstr "0 использует upstream-значение 32 МиБ; явное значение может быть от 2 до 32 МиБ."

msgid "Use 0 or a value from 2 to 32."
msgstr "Укажите 0 или значение от 2 до 32."

msgid "Performance"
msgstr "Производительность"

msgid "TCP Buffer (KB)"
msgstr "TCP-буфер (КБ)"

msgid "Event Loops"
msgstr "Циклы событий"

msgid "IP Preference"
msgstr "Предпочтение IP"

msgid "Prefer IPv4"
msgstr "Предпочитать IPv4"

msgid "Prefer IPv6"
msgstr "Предпочитать IPv6"

msgid "IPv4 only"
msgstr "Только IPv4"

msgid "IPv6 only"
msgstr "Только IPv6"

msgid "Idle Timeout"
msgstr "Таймаут простоя"

msgid "Max Write Buffer (MB)"
msgstr "Максимальный буфер записи (МБ)"

msgid "Client Silence Close"
msgstr "Закрытие при молчании клиента"

msgid "0 disables this recovery timer; upstream suggests roughly 10–15s only when diagnosing the iOS Updating stall."
msgstr "0 отключает таймер; upstream рекомендует примерно 10–15 с только при диагностике зависания iOS в состоянии Updating."

msgid "Upstream"
msgstr "Upstream"

msgid "Optional SOCKS5 route for Telegram DC connections. Leave empty for direct routing."
msgstr "Необязательный SOCKS5-маршрут для соединений с Telegram DC. Оставьте пустым для прямой маршрутизации."

msgid "Metrics"
msgstr "Метрики"

msgid "Metrics Address"
msgstr "Адрес метрик"

msgid "Keep metrics on a literal loopback address."
msgstr "Оставляйте метрики на явном loopback-адресе."

msgid "Metrics Path"
msgstr "Путь метрик"

msgid "Enable Diagnostics"
msgstr "Включить диагностику"

msgid "Private runtime diagnostics require a literal loopback metrics address."
msgstr "Приватная runtime-диагностика требует явного loopback-адреса метрик."

msgid "Configuration"
msgstr "Конфигурация"

msgid "Status"
msgstr "Статус"

msgid "telEgo Status"
msgstr "Статус telEgo"

msgid "Live service, WEB Proxy and Middle-End statistics from the local metrics endpoint."
msgstr "Текущая статистика службы, WEB-прокси и Middle-End из локального endpoint метрик."

msgid "Unable to read telEgo status."
msgstr "Не удалось получить статус telEgo."

msgid "telEgo Configuration"
msgstr "Конфигурация telEgo"

msgid "Configure MTProxy, TLS fronting, WEB Proxy, Middle-End and runtime limits."
msgstr "Настройка MTProxy, TLS-фронтинга, WEB-прокси, Middle-End и ограничений выполнения."

msgid "MTProxy"
msgstr "MTProxy"

msgid "Enable MTProxy"
msgstr "Включить MTProxy"

msgid "Listen Address"
msgstr "Адрес прослушивания"

msgid "Public TCP address where telEgo accepts MTProxy connections."
msgstr "Публичный TCP-адрес, на котором telEgo принимает соединения MTProxy."

msgid "Log Level"
msgstr "Уровень логирования"

msgid "Trace"
msgstr "Трассировка"

msgid "Debug"
msgstr "Отладка"

msgid "Info"
msgstr "Информация"

msgid "Warning"
msgstr "Предупреждение"

msgid "Error"
msgstr "Ошибка"

msgid "Accept Incoming PROXY Protocol"
msgstr "Принимать входящий PROXY Protocol"

msgid "Enable only when a trusted TCP proxy is directly in front of the public MTProxy listener."
msgstr "Включайте только если перед публичным MTProxy listener находится доверенный TCP-прокси."

msgid "Max Connections per IP"
msgstr "Максимум соединений на IP"

msgid "0 disables this connection-flood limit."
msgstr "0 отключает это ограничение от лавины соединений."

msgid "Max IPs per User"
msgstr "Максимум IP на пользователя"

msgid "0 disables per-secret IP limiting."
msgstr "0 отключает ограничение числа IP для одного секрета."

msgid "IP Block Timeout"
msgstr "Время блокировки IP"

msgid "Handshake Timeout"
msgstr "Таймаут handshake"

msgid "Clock Sync URL"
msgstr "URL синхронизации времени"

msgid "Optional HTTP(S) URL whose Date header corrects startup clock skew for FakeTLS validation."
msgstr "Необязательный HTTP(S)-URL, заголовок Date которого корректирует сдвиг часов при запуске для проверки FakeTLS."

msgid "TLS Fronting"
msgstr "TLS-фронтинг"

msgid "Mask Domain"
msgstr "Домен маскировки"

msgid "Hostname used for FakeTLS SNI validation and certificate fetching."
msgstr "Имя хоста для проверки SNI FakeTLS и получения сертификата."

msgid "Mask Port"
msgstr "Порт маскировки"

msgid "Certificate Host"
msgstr "Хост сертификата"

msgid "Optional certificate source. Native shared-port Nginx on this router uses 127.0.0.1."
msgstr "Необязательный источник сертификата. Для native shared-port Nginx на этом роутере используется 127.0.0.1."

msgid "Certificate Port"
msgstr "Порт сертификата"

msgid "Native shared-port Nginx uses port 8444 for certificate collection."
msgstr "Native shared-port Nginx использует порт 8444 для получения сертификата."

msgid "Fallback Host"
msgstr "Резервный хост"

msgid "Where unrecognized TLS is spliced. Native shared-port Nginx on this router uses 127.0.0.1."
msgstr "Куда передаётся нераспознанный TLS. Для native shared-port Nginx на этом роутере используется 127.0.0.1."

msgid "Fallback Port"
msgstr "Резервный порт"

msgid "Native shared-port Nginx uses port 8443 and PROXY protocol v2."
msgstr "Native shared-port Nginx использует порт 8443 и PROXY Protocol v2."

msgid "Fake Certificate Size"
msgstr "Размер фиктивного сертификата"

msgid "0 selects automatic matching; an explicit override must be from 256 to 16384 bytes."
msgstr "0 включает автоматический подбор; явное значение должно быть от 256 до 16384 байт."

msgid "Use 0 for automatic mode or a value from 256 to 16384."
msgstr "Укажите 0 для автоматического режима или значение от 256 до 16384."

msgid "Mask SNI Safelist"
msgstr "Разрешённые SNI для маскировки"

msgid "Fallback PROXY Protocol"
msgstr "PROXY Protocol для резервного соединения"

msgid "PROXY Protocol v1"
msgstr "PROXY Protocol v1"

msgid "PROXY Protocol v2"
msgstr "PROXY Protocol v2"

msgid "Fallback Idle Timeout"
msgstr "Таймаут простоя резервного соединения"

msgid "Enable DRS"
msgstr "Включить DRS"

msgid "Enable Split TLS"
msgstr "Включить Split TLS"

msgid "Users"
msgstr "Пользователи"

msgid "Username"
msgstr "Имя пользователя"

msgid "Secret (32 hex characters)"
msgstr "Секрет (32 hex-символа)"

msgid "Enter exactly 32 hexadecimal characters."
msgstr "Введите ровно 32 шестнадцатеричных символа."

msgid "Secret must contain exactly 32 hexadecimal characters."
msgstr "Секрет должен содержать ровно 32 шестнадцатеричных символа."

msgid "Generate random secret"
msgstr "Сгенерировать случайный секрет"

msgid "Generate"
msgstr "Сгенерировать"

msgid "WEB Proxy"
msgstr "WEB-прокси"

msgid "Enable WEB Proxy"
msgstr "Включить WEB-прокси"

msgid "Select the transport used by Telegram Desktop. HTTPS Lanes is the conservative upstream recommendation for new HTTP/2 deployments."
msgstr "Выберите транспорт Telegram Desktop. Для новых HTTP/2-развёртываний upstream рекомендует начинать с HTTPS Lanes."

msgid "HTTPS"
msgstr "HTTPS"

msgid "HTTPS Lanes"
msgstr "HTTPS Lanes"

msgid "WebSocket"
msgstr "WebSocket"

msgid "WebSocket Lanes"
msgstr "WebSocket Lanes"

msgid "Bind Address"
msgstr "Адрес привязки"

msgid "Private HTTP/1.1 listener. Keep this address inaccessible from the Internet."
msgstr "Приватный HTTP/1.1 listener. Этот адрес не должен быть доступен из Интернета."

msgid "Hostname"
msgstr "Имя хоста"

msgid "Hostname covered by the public TLS certificate or Cloudflare Published Application."
msgstr "Имя хоста из публичного TLS-сертификата или Cloudflare Published Application."

msgid "Trusted Proxy CIDRs"
msgstr "CIDR доверенных прокси"

msgid "Only these proxy addresses may supply forwarded client addresses."
msgstr "Только эти адреса прокси могут передавать исходный адрес клиента."

msgid "Compatibility Backend"
msgstr "Совместимый backend"

msgid "Optional local TCP or Unix backend. Leave empty to use the faster shared MTProxy core directly."
msgstr "Необязательный локальный TCP- или Unix-backend. Оставьте пустым, чтобы напрямую использовать более быстрый общий MTProxy core."

msgid "WEB Event Loops"
msgstr "Циклы событий WEB"

msgid "0 selects the automatic gnet event-loop count."
msgstr "0 выбирает количество циклов событий gnet автоматически."

msgid "Telegram Middle-End"
msgstr "Telegram Middle-End"

msgid "Enable Middle-End"
msgstr "Включить Middle-End"

msgid "Keep disabled unless you intentionally use Telegram Middle-End transport. Existing direct DC routing remains the default."
msgstr "Оставьте отключённым, если вы специально не используете транспорт Telegram Middle-End. Прямая маршрутизация к DC остаётся вариантом по умолчанию."

msgid "Proxy Tag"
msgstr "Тег прокси"

msgid "Optional registered Telegram proxy tag: exactly 32 hexadecimal characters."
msgstr "Необязательный зарегистрированный тег Telegram-прокси: ровно 32 шестнадцатеричных символа."

msgid "Proxy Tag must be empty or contain exactly 32 hexadecimal characters."
msgstr "Тег прокси должен быть пустым или содержать ровно 32 шестнадцатеричных символа."

msgid "SOCKS5 Proxy"
msgstr "SOCKS5-прокси"

msgid "SOCKS5 Username"
msgstr "Имя пользователя SOCKS5"

msgid "SOCKS5 Password"
msgstr "Пароль SOCKS5"

msgid "Artifact Proxy"
msgstr "Прокси для артефактов"

msgid "STUN NAT IP"
msgstr "NAT IP для STUN"

msgid "Middle-End Max Connections"
msgstr "Максимум соединений Middle-End"

msgid "0 uses the upstream default of 10000; an override may only reduce it."
msgstr "0 использует upstream-значение 10000; явное значение может только уменьшить лимит."

msgid "Use 0 or a value from 1 to 10000."
msgstr "Укажите 0 или значение от 1 до 10000."

msgid "Middle-End Queue Budget (MB)"
msgstr "Лимит очереди Middle-End (МБ)"

msgid "0 keeps upstream defaults: about 32 MiB request/input and 66 MiB shared response/output on 64-bit; 2 to 32 sets N MiB request/input and 2xN MiB shared response/output."
msgstr "0 сохраняет upstream-значения: около 32 МиБ для запросов/входа и 66 МиБ общего пула ответов/вывода на 64-битной системе; 2–32 задаёт N МиБ для запросов/входа и 2xN МиБ общего пула ответов/вывода."

msgid "Use 0 or a value from 2 to 32."
msgstr "Укажите 0 или значение от 2 до 32."

msgid "Performance"
msgstr "Производительность"

msgid "TCP Buffer (KB)"
msgstr "TCP-буфер (КБ)"

msgid "Event Loops"
msgstr "Циклы событий"

msgid "IP Preference"
msgstr "Предпочтение IP"

msgid "Prefer IPv4"
msgstr "Предпочитать IPv4"

msgid "Prefer IPv6"
msgstr "Предпочитать IPv6"

msgid "IPv4 only"
msgstr "Только IPv4"

msgid "IPv6 only"
msgstr "Только IPv6"

msgid "Idle Timeout"
msgstr "Таймаут простоя"

msgid "Max Write Buffer (MB)"
msgstr "Максимальный буфер записи (МБ)"

msgid "Client Silence Close"
msgstr "Закрытие при молчании клиента"

msgid "0 disables this recovery timer; upstream suggests roughly 10–15s only when diagnosing the iOS Updating stall."
msgstr "0 отключает таймер; upstream рекомендует примерно 10–15 с только при диагностике зависания iOS в состоянии Updating."

msgid "Upstream"
msgstr "Upstream"

msgid "Optional SOCKS5 route for Telegram DC connections. Leave empty for direct routing."
msgstr "Необязательный SOCKS5-маршрут для соединений с Telegram DC. Оставьте пустым для прямой маршрутизации."

msgid "Metrics"
msgstr "Метрики"

msgid "Metrics Address"
msgstr "Адрес метрик"

msgid "Keep metrics on a literal loopback address."
msgstr "Оставляйте метрики на явном loopback-адресе."

msgid "Metrics Path"
msgstr "Путь метрик"

msgid "Enable Diagnostics"
msgstr "Включить диагностику"

msgid "Private runtime diagnostics require a literal loopback metrics address."
msgstr "Приватная runtime-диагностика требует явного loopback-адреса метрик."

msgid "Configuration"
msgstr "Конфигурация"

msgid "Status"
msgstr "Статус"

msgid "WEB Ingress"
msgstr "WEB-вход"

msgid "WEB Ingress / Nginx Integration"
msgstr "WEB-вход / интеграция Nginx"

msgid "Choose one managed WEB ingress profile. Disabled leaves hand-written Nginx configuration untouched; managed profiles are mutually exclusive and are validated by nginx-telego before Nginx is reloaded."
msgstr "Выберите один управляемый профиль WEB-входа. Режим «Отключено» не трогает Nginx-конфигурацию, созданную вручную; управляемые профили взаимоисключающие и проверяются nginx-telego до перезагрузки Nginx."

msgid "Ingress Profile"
msgstr "Профиль входа"

msgid "Mode"
msgstr "Режим"

msgid "Selecting a mode updates the existing shared.enabled and cloudflare.enabled UCI flags. Save & Apply invokes the nginx-telego reconciliation engine through the OpenWrt reload trigger."
msgstr "Выбор режима обновляет UCI-флаги shared.enabled и cloudflare.enabled. «Сохранить и применить» применяет изменения через механизм согласования nginx-telego и триггер перезагрузки OpenWrt."

msgid "Managed Nginx Files"
msgstr "Управляемые файлы Nginx"

msgid "Current telEgo WEB Contract"
msgstr "Текущий WEB-контракт telEgo"

msgid "not set"
msgstr "не задано"

msgid "WEB Proxy enabled"
msgstr "WEB-прокси включён"

msgid "WEB Proxy disabled"
msgstr "WEB-прокси отключён"

msgid "loopback proxy trusted"
msgstr "loopback-прокси доверен"

msgid "loopback proxy is not trusted"
msgstr "loopback-прокси не доверен"

msgid "Leave empty to reuse telego.web_proxy.hostname. When set, it must match that hostname exactly."
msgstr "Оставьте пустым, чтобы использовать telego.web_proxy.hostname. Если значение задано, оно должно точно совпадать с этим hostname."

msgid "The ingress hostname must match the telEgo WEB Proxy hostname."
msgstr "Hostname входного профиля должен совпадать с hostname WEB-прокси telEgo."

msgid "Cloudflare Tunnel Service URL"
msgstr "URL сервиса Cloudflare Tunnel"

msgid "Configure the Cloudflare Published Application to use this local HTTP origin. Public TLS terminates at Cloudflare."
msgstr "Укажите этот локальный HTTP origin в Cloudflare Published Application. Публичный TLS завершается на стороне Cloudflare."

msgid "Leave empty to reuse telego.web_proxy.hostname. Native Shared-Port requires the WEB hostname, FakeTLS mask hostname and TLS certificate hostname to agree."
msgstr "Оставьте пустым, чтобы использовать telego.web_proxy.hostname. Для Native Shared-Port WEB hostname, hostname маски FakeTLS и hostname TLS-сертификата должны совпадать."

msgid "TLS Certificate"
msgstr "TLS-сертификат"

msgid "Absolute path to the existing certificate chain used by the private Nginx TLS listeners."
msgstr "Абсолютный путь к существующей цепочке сертификатов для приватных TLS-listener Nginx."

msgid "TLS Private Key"
msgstr "Закрытый ключ TLS"

msgid "Absolute path to the matching private key. nginx-telego never creates or renews certificates."
msgstr "Абсолютный путь к соответствующему закрытому ключу. nginx-telego не выпускает и не обновляет сертификаты."

msgid "Native Shared-Port Flow"
msgstr "Схема Native Shared-Port"

msgid "FakeTLS Certificate Source"
msgstr "Источник сертификата FakeTLS"

msgid "Current Native Shared-Port Contract"
msgstr "Текущий контракт Native Shared-Port"

msgid "Required values are public TCP/443, certificate source 127.0.0.1:8444, fallback 127.0.0.1:8443 and PROXY Protocol v2. nginx-telego refuses to apply the managed Nginx state if this contract is not satisfied."
msgstr "Требуются публичный TCP/443, источник сертификата 127.0.0.1:8444, fallback 127.0.0.1:8443 и PROXY Protocol v2. nginx-telego откажется применять управляемое состояние Nginx, если этот контракт не выполнен."

msgid "Manage Local Fallback"
msgstr "Управлять локальным fallback"

msgid "Provide the minimal loopback-only ordinary-site fallback on 127.0.0.1:8090. Disable this only when another local Nginx server already owns that listener."
msgstr "Создавать минимальный fallback обычного сайта только на loopback 127.0.0.1:8090. Отключайте только если этот listener уже принадлежит другому локальному server Nginx."

msgid "Apply Safety"
msgstr "Безопасность применения"

msgid "Conflict detection · nginx -t · atomic rollback · administrator-owned files are never overwritten"
msgstr "Проверка конфликтов · nginx -t · атомарный rollback · файлы администратора никогда не перезаписываются"

msgid "An absolute path is required for Native Shared-Port mode."
msgstr "Для режима Native Shared-Port требуется абсолютный путь."

msgid "Use an absolute path containing only letters, digits, underscore, dot, slash, plus or hyphen."
msgstr "Используйте абсолютный путь только из букв, цифр, подчёркивания, точки, косой черты, плюса и дефиса."

msgid "Absolute path to the certificate chain used by the dedicated Direct HTTPS Nginx listener on TCP/443."
msgstr "Абсолютный путь к цепочке сертификатов для выделенного listener Direct HTTPS Nginx на TCP/443."

msgid "Advanced Compatibility Mode"
msgstr "Расширенный режим совместимости"

msgid "Advanced — Native Shared-Port"
msgstr "Расширенные настройки — Native Shared-Port"

msgid "An absolute path is required."
msgstr "Требуется абсолютный путь."

msgid "Checks dedicated WAN TCP/443 ownership, WAN zone safety, pending UCI changes and fw4 syntax without changing firewall rules."
msgstr "Проверяет выделенное владение WAN TCP/443, безопасность зоны WAN, неприменённые изменения UCI и синтаксис fw4, не изменяя правила firewall."

msgid "Choose one managed WEB ingress profile. Disabled leaves hand-written Nginx configuration untouched; managed profiles are mutually exclusive and are validated before public traffic is changed."
msgstr "Выберите один управляемый профиль WEB-входа. Режим «Отключено» не трогает созданную вручную конфигурацию Nginx; управляемые профили взаимоисключающие и проверяются до изменения обработки публичного трафика."

msgid "Conflict detection · nginx -t · fw4 check · transactional rollback · administrator-owned files and firewall rules are never overwritten"
msgstr "Проверка конфликтов · nginx -t · fw4 check · транзакционный rollback · файлы и правила firewall администратора никогда не перезаписываются"

msgid "Direct HTTPS Flow"
msgstr "Схема Direct HTTPS"

msgid "Direct HTTPS and Cloudflare are normal ingress modes. Native Shared-Port remains available as an advanced compatibility mode. Save & Apply invokes the nginx-telego reconciliation engine through the OpenWrt reload trigger."
msgstr "Direct HTTPS и Cloudflare — обычные режимы входа. Native Shared-Port остаётся доступен как расширенный режим совместимости. «Сохранить и применить» запускает согласование nginx-telego через триггер перезагрузки OpenWrt."

msgid "Firewall Preflight"
msgstr "Предварительная проверка firewall"

msgid "Firewall Status"
msgstr "Состояние firewall"

msgid "Firewall preflight failed:"
msgstr "Предварительная проверка firewall не пройдена:"

msgid "Firewall preflight passed."
msgstr "Предварительная проверка firewall пройдена."

msgid "Foreign WAN TCP/443"
msgstr "Чужой WAN TCP/443"

msgid "Foreign reserved section"
msgstr "Зарезервированная секция занята чужим правилом"

msgid "Managed rule"
msgstr "Управляемое правило"

msgid "Native Shared-Port (Advanced)"
msgstr "Native Shared-Port (расширенный режим)"

msgid "Native Shared-Port keeps telEgo on public TCP/443 and splices WEB TLS to private Nginx listeners. Use it only when you intentionally need the legacy shared-port topology."
msgstr "Native Shared-Port оставляет telEgo на публичном TCP/443 и передаёт WEB TLS на приватные listener Nginx. Используйте этот режим только если вам намеренно нужна прежняя shared-port топология."

msgid "Owned and in sync"
msgstr "Принадлежит telEgo и синхронизировано"

msgid "Owned but drifted"
msgstr "Принадлежит telEgo, но отличается от ожидаемого состояния"

msgid "Pending firewall changes"
msgstr "Неприменённые изменения firewall"

msgid "Run Preflight"
msgstr "Запустить проверку"

msgid "Status is read without changing firewall configuration. Direct HTTPS owns only firewall.telego_direct_https."
msgstr "Статус читается без изменения конфигурации firewall. Direct HTTPS владеет только секцией firewall.telego_direct_https."

msgid "Unavailable"
msgstr "Недоступно"

msgid "WAN input"
msgstr "Входящий трафик WAN"

msgid "none"
msgstr "нет"

msgid "unknown"
msgstr "неизвестно"

msgid "unknown error"
msgstr "неизвестная ошибка"

msgid "ACME DNS-01"
msgstr "ACME DNS-01"

msgid "Active Certificate Paths"
msgstr "Активные пути сертификата"

msgid "Certificate"
msgstr "Сертификат"

msgid "Certificate Preflight"
msgstr "Предварительная проверка сертификата"

msgid "Certificate Status"
msgstr "Состояние сертификата"

msgid "Certificate and private key do not match"
msgstr "Сертификат и закрытый ключ не совпадают"

msgid "Certificate does not cover the configured hostname"
msgstr "Сертификат не покрывает настроенное имя хоста"

msgid "Certificate preflight failed:"
msgstr "Предварительная проверка сертификата не пройдена:"

msgid "Certificate preflight passed."
msgstr "Предварительная проверка сертификата пройдена."

msgid "Certificate, key and hostname match"
msgstr "Сертификат, ключ и имя хоста соответствуют друг другу"

msgid "Expired"
msgstr "Истёк"

msgid "Expires within 30 days"
msgstr "Истекает менее чем через 30 дней"

msgid "Expires within 7 days"
msgstr "Истекает менее чем через 7 дней"

msgid "Expiry"
msgstr "Срок действия"

msgid "External certificate path"
msgstr "Внешний путь к сертификату"

msgid "No local managed TLS certificate is active."
msgstr "Активный локальный управляемый TLS-сертификат отсутствует."

msgid "Not after"
msgstr "Действителен до"

msgid "OpenWrt ACME can issue and renew the certificate without taking over WAN ports 80 or 443. For an ACME-managed hostname, use /etc/ssl/acme/<hostname>.fullchain.crt and /etc/ssl/acme/<hostname>.key. The nginx-telego hotplug hook preflights renewed material before OpenWrt emits acme.renew; the stock Nginx service then performs nginx -t and reloads safely."
msgstr "OpenWrt ACME может выпускать и обновлять сертификат, не занимая WAN-порты 80 или 443. Для имени хоста под управлением ACME используйте /etc/ssl/acme/<hostname>.fullchain.crt и /etc/ssl/acme/<hostname>.key. Hotplug-hook nginx-telego предварительно проверяет обновлённые данные до события acme.renew, после чего штатный сервис Nginx выполняет nginx -t и безопасную перезагрузку."

msgid "OpenWrt ACME path detected"
msgstr "Обнаружен путь OpenWrt ACME"

msgid "Private key"
msgstr "Закрытый ключ"

msgid "Read-only X.509 status for the active local TLS profile, including key match, hostname coverage and expiry."
msgstr "Состояние X.509 активного локального TLS-профиля только для чтения: совпадение ключа, покрытие имени хоста и срок действия."

msgid "Run Certificate Preflight"
msgstr "Запустить проверку сертификата"

msgid "See docs/TLS_CERTIFICATE.md for the DNS-01 runbook."
msgstr "См. руководство DNS-01 в docs/TLS_CERTIFICATE.md."

msgid "Valid for more than 30 days"
msgstr "Действителен более 30 дней"

msgid "Validates X.509 parsing, private key parsing, certificate/key match, hostname coverage, expiry and the complete Nginx configuration with nginx -t. No files or services are changed."
msgstr "Проверяет разбор X.509, закрытый ключ, совпадение сертификата и ключа, покрытие имени хоста, срок действия и полную конфигурацию Nginx через nginx -t. Файлы и сервисы не изменяются."

msgid "Certificate SHA-256"
msgstr "SHA-256 сертификата"


msgid "Direct HTTPS and Cloudflare are normal ingress modes. Direct HTTPS reserves TCP/443 for WEB/Nginx on LAN and WAN and moves LuCI HTTPS to a separate management port; MTProxy must use another public port. Native Shared-Port remains available when WEB and MTProxy must share public TCP/443."
msgstr "Direct HTTPS и Cloudflare — обычные режимы входа. Direct HTTPS резервирует TCP/443 для WEB/Nginx в LAN и WAN и переносит HTTPS LuCI на отдельный порт управления; MTProxy должен использовать другой публичный порт. Native Shared-Port остаётся доступен, когда WEB и MTProxy должны совместно использовать публичный TCP/443."

msgid "Direct HTTPS reserves TCP/443 for WEB/Nginx on LAN and WAN. Move the telEgo MTProxy listener to another port, or use Native Shared-Port to share public TCP/443."
msgstr "Direct HTTPS резервирует TCP/443 для WEB/Nginx в LAN и WAN. Перенесите listener MTProxy telEgo на другой порт или используйте Native Shared-Port для совместного использования публичного TCP/443."

msgid "Foreign WAN TCP/18443"
msgstr "Чужой WAN TCP/18443"

msgid "Port Ownership"
msgstr "Владение портами"

msgid "Direct HTTPS dedicates TCP/443 to WEB/Nginx on both LAN and WAN. LuCI/uhttpd uses the configured management port; MTProxy must use another public port."
msgstr "Direct HTTPS выделяет TCP/443 для WEB/Nginx и в LAN, и в WAN. LuCI/uhttpd использует настроенный порт управления; MTProxy должен использовать другой публичный порт."


msgid "Managed WEB ingress requires enabled telEgo and WEB Proxy, bind 127.0.0.1:8080, a WEB hostname, and trusted 127.0.0.1/32. Fix Services → telEgo → Configuration / Advanced Settings first."
msgstr "Managed WEB ingress требует включённые telEgo и WEB Proxy, bind 127.0.0.1:8080, WEB hostname и доверенный 127.0.0.1/32. Исправьте базовые параметры в «Конфигурация», а доверенные proxy CIDR — в «Расширенные настройки»."


msgid "LuCI HTTPS Management Port"
msgstr "Порт управления HTTPS LuCI"

msgid "When uhttpd still owns HTTPS TCP/443, nginx-telego moves only those LuCI listeners to this management port before Nginx claims TCP/443. Existing administrator-managed non-443 LuCI listeners are preserved."
msgstr "Если uhttpd всё ещё владеет HTTPS TCP/443, nginx-telego переносит только эти listener LuCI на указанный порт управления до того, как Nginx займёт TCP/443. Существующие listener LuCI на других портах, которыми управляет администратор, сохраняются."

msgid "LuCI management port must differ from Direct HTTPS TCP/443."
msgstr "Порт управления LuCI должен отличаться от TCP/443 Direct HTTPS."

msgid "LAN Split-DNS Address"
msgstr "LAN-адрес Split DNS"

msgid "Optional router LAN IPv4 address returned for the WEB hostname to LAN clients. This avoids public-IP hairpin NAT. Leave empty to keep administrator-managed DNS unchanged."
msgstr "Необязательный LAN IPv4-адрес роутера, который будет возвращаться LAN-клиентам для WEB hostname. Это исключает hairpin NAT через публичный IP. Оставьте пустым, чтобы не изменять DNS, которым управляет администратор."

msgid "Platform Status"
msgstr "Состояние платформы"

msgid "Read-only Direct HTTPS ownership status for LuCI/uhttpd and optional dnsmasq split DNS."
msgstr "Состояние владения Direct HTTPS для LuCI/uhttpd и необязательного split DNS dnsmasq. Только чтение."

msgid "Platform Preflight"
msgstr "Предварительная проверка платформы"

msgid "Checks LuCI TCP/443 migration safety, the configured management port, optional split DNS, pending UCI changes and ownership drift without changing services or configuration."
msgstr "Проверяет безопасность переноса LuCI с TCP/443, настроенный порт управления, необязательный split DNS, неприменённые изменения UCI и отклонения владения без изменения служб или конфигурации."

msgid "Run Platform Preflight"
msgstr "Запустить проверку платформы"

msgid "Platform preflight passed."
msgstr "Предварительная проверка платформы пройдена."

msgid "Platform preflight failed:"
msgstr "Предварительная проверка платформы не пройдена:"

msgid "LuCI HTTPS"
msgstr "HTTPS LuCI"

msgid "uhttpd owns TCP/443"
msgstr "uhttpd владеет TCP/443"

msgid "uhttpd management listener"
msgstr "listener управления uhttpd"

msgid "Split DNS"
msgstr "Split DNS"

msgid "Pending platform changes"
msgstr "Неприменённые изменения платформы"

msgid "Administrator-owned"
msgstr "Управляется администратором"

msgid "Configured but absent"
msgstr "Настроено, но отсутствует"

msgid "present"
msgstr "есть"

msgid "not detected"
msgstr "не обнаружен"

msgid "LAN address"
msgstr "LAN-адрес"


msgid "DD Downlink Chunk (bytes)"
msgstr "Размер блока DD вниз (байт)"

msgid "0 keeps the upstream raw-DD batching. For restrictive mobile networks, start with 1200 bytes together with a small DD downlink delay."
msgstr "0 сохраняет стандартную пакетную отправку raw DD. Для мобильных сетей с фильтрацией начните с 1200 байт вместе с небольшой задержкой DD вниз."

msgid "Use 0 or a value from 256 to 65536 bytes."
msgstr "Используйте 0 или значение от 256 до 65536 байт."

msgid "DD Downlink Delay"
msgstr "Задержка DD вниз"

msgid "Paces raw-DD proxy-to-client writes without blocking the event loop. 0s disables pacing; start with 2ms when testing mobile DPI degradation."
msgstr "Разносит по времени отправку raw DD от прокси к клиенту, не блокируя цикл событий. 0s отключает pacing; при проверке деградации мобильным DPI начните с 2ms."

msgid "Use 0s or a positive integer duration such as 500us, 2ms, or 1s."
msgstr "Используйте 0s или положительную целую длительность, например 500us, 2ms или 1s."


msgid "Public Host"
msgstr "Публичный адрес"

msgid "Hostname or IP used only when generating MTProxy client links. It does not change the listener address."
msgstr "Имя хоста или IP используется только при генерации клиентских ссылок MTProxy и не изменяет адрес прослушивания."

msgid "Public Port"
msgstr "Публичный порт"

msgid "Optional port used only in generated links. Leave empty to reuse the port from Listen Address."
msgstr "Необязательный порт только для генерируемых ссылок. Оставьте пустым, чтобы использовать порт из адреса прослушивания."

msgid "Base secret is invalid. Save a 32-hex secret first."
msgstr "Базовый секрет некорректен. Сначала сохраните секрет из 32 шестнадцатеричных символов."

msgid "Mask domain is required for EE / FakeTLS."
msgstr "Для EE / FakeTLS требуется домен маскировки."

msgid "Public server is required."
msgstr "Укажите публичный адрес сервера."

msgid "Enter a valid public port."
msgstr "Укажите корректный публичный порт."

msgid "Copied to clipboard."
msgstr "Скопировано в буфер обмена."

msgid "Unable to copy automatically. Select the field and copy it manually."
msgstr "Не удалось скопировать автоматически. Выделите поле и скопируйте его вручную."

msgid "Copy"
msgstr "Копировать"

msgid "Derived Secret"
msgstr "Готовый секрет"

msgid "Telegram Link"
msgstr "Ссылка Telegram"

msgid "Raw Obfuscated2. The generated secret is dd + the saved 32-hex base secret."
msgstr "Raw Obfuscated2. Готовый секрет состоит из dd и сохранённого базового секрета из 32 hex-символов."

msgid "FakeTLS + Obfuscated2. The EE secret uses the saved TLS Fronting mask domain."
msgstr "FakeTLS + Obfuscated2. Секрет EE использует сохранённый домен маскировки TLS-фронтинга."

msgid "DD / Raw"
msgstr "DD / Raw"

msgid "EE / FakeTLS"
msgstr "EE / FakeTLS"

msgid "Connection Links"
msgstr "Ссылки подключения"

msgid "Links are generated locally in your browser. This dialog does not change telEgo runtime settings."
msgstr "Ссылки генерируются локально в браузере. Это окно не изменяет рабочие настройки telEgo."

msgid "Public Server"
msgstr "Публичный сервер"

msgid "Links"
msgstr "Ссылки"

msgid "Close"
msgstr "Закрыть"


msgid "Enable TLS Fronting"
msgstr "Включить TLS-фронтинг"

msgid "Enables EE / FakeTLS, certificate fingerprinting and TLS splice handling. DD / Raw continues to work when this is disabled."
msgstr "Включает EE / FakeTLS, получение TLS-отпечатка сертификата и обработку TLS splice. DD / Raw продолжает работать, когда TLS-фронтинг выключен."

msgid "TLS Fronting is required while Native Shared-Port is enabled. Disable Native Shared-Port first."
msgstr "TLS-фронтинг обязателен при включённом Native Shared-Port. Сначала отключите Native Shared-Port."

msgid "Enable TLS Fronting to generate EE / FakeTLS links."
msgstr "Включите TLS-фронтинг для генерации ссылок EE / FakeTLS."

msgid "TLS Fronting is disabled. EE / FakeTLS links are unavailable."
msgstr "TLS-фронтинг выключен. Ссылки EE / FakeTLS недоступны."

msgid "Native Shared-Port requires TLS Fronting. Enable it in Services → telEgo → Configuration first."
msgstr "Native Shared-Port требует TLS-фронтинг. Сначала включите его в Службы → telEgo → Конфигурация."


msgid "Configure the core telEgo services. Rare transport and runtime controls are available on the Advanced Settings page."
msgstr "Настройте основные службы telEgo. Редкие параметры транспорта и runtime вынесены на страницу «Расширенные настройки»."

msgid "Advanced Settings"
msgstr "Расширенные настройки"

msgid "Rare transport, security and runtime controls. Defaults are recommended unless you are diagnosing a specific problem or using an advanced ingress topology."
msgstr "Редкие параметры транспорта, безопасности и runtime. Оставляйте значения по умолчанию, если не диагностируете конкретную проблему и не используете расширенную схему входа."

msgid "MTProxy Advanced"
msgstr "MTProxy — расширенные настройки"

msgid "TLS Fronting Advanced"
msgstr "TLS-фронтинг — расширенные настройки"

msgid "TLS Fronting is disabled. Enable it on the Configuration page to edit EE / FakeTLS advanced settings."
msgstr "TLS-фронтинг выключен. Включите его на странице «Конфигурация», чтобы изменить расширенные параметры EE / FakeTLS."

msgid "WEB Proxy Advanced"
msgstr "WEB Proxy — расширенные настройки"

msgid "WEB Proxy is disabled. Enable it on the Configuration page to edit advanced WEB transport settings."
msgstr "WEB Proxy выключен. Включите его на странице «Конфигурация», чтобы изменить расширенные параметры WEB-транспорта."

msgid "Middle-End Advanced"
msgstr "Middle-End — расширенные настройки"

msgid "Middle-End is disabled. Enable it on the Configuration page to edit advanced Middle-End transport settings."
msgstr "Middle-End выключен. Включите его на странице «Конфигурация», чтобы изменить расширенные параметры транспорта Middle-End."


msgid "Set DD Downlink Delay to 0s before setting DD Downlink Chunk to 0."
msgstr "Перед установкой размера блока DD в 0 установите задержку DD в 0s."

msgid "Use 0s or a positive integer duration no greater than 1s, such as 500us, 2ms, or 1s."
msgstr "Используйте 0s или положительную целую длительность не более 1s, например 500us, 2ms или 1s."

msgid "DD Downlink Delay requires a non-zero DD Downlink Chunk."
msgstr "Для ненулевой задержки DD требуется ненулевой размер блока DD."


msgid "Disable DD Downlink Shaping before enabling Middle-End."
msgstr "Перед включением Middle-End отключите DD Downlink Shaping."

msgid "DD Downlink Shaping is unavailable while Middle-End is enabled."
msgstr "DD Downlink Shaping недоступен, пока включён Middle-End."


msgid "Enter a hostname or IP address only, without a URL, path or spaces."
msgstr "Укажите только имя хоста или IP-адрес — без URL, пути и пробелов."

msgid "Enter a valid hostname or IP address."
msgstr "Укажите корректное имя хоста или IP-адрес."

msgid "Unavailable"
msgstr "Недоступно"



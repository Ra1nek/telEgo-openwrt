# telEgo Nginx Configuration
# ============================
#
# UCI configuration file for nginx-telego package.
# This file is used by luci-app-telego to manage nginx settings dynamically.
#

config 'nginx_telego'
	option 'enabled' '0'
	option 'listen_https_port' '443'
	option 'listen_http_port' '80'
	option 'upstream_host' '127.0.0.1'
	option 'upstream_port' '8080'
	option 'ssl_certificate' '/etc/telego/cert.pem'
	option 'ssl_certificate_key' '/etc/telego/key.pem'
	option 'proxy_buffer_size' '32k'
	option 'proxy_buffers' '4 64k'
	option 'client_max_body_size' '0'

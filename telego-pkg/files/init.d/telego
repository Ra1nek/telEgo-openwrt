#!/bin/sh /etc/rc.common

# =============================================================================
# Telego Service Control Script for OpenWrt 25.12.4
# Supports MTProto, WEB Proxy, and Telegram Middle-End (v0.6.0+)
# =============================================================================

START=95
STOP=20
SERVICE_USE_PROCD=1
SERVICE_PIDFILE=/var/run/telego.pid
CONFIG_FILE=/etc/config/telego
DEFAULT_CONFIG=/etc/config/telego.default

# -----------------------------------------------------------------------------
# Service triggers - auto-reload on config change
# -----------------------------------------------------------------------------
service_triggers() {
    procd_add_reload_trigger "$CONFIG_FILE"
}

# -----------------------------------------------------------------------------
# Get effective config file path (UCI or default)
# -----------------------------------------------------------------------------
get_config_file() {
    if [ -f "$CONFIG_FILE" ]; then
        echo "$CONFIG_FILE"
    elif [ -f "$DEFAULT_CONFIG" ]; then
        cp "$DEFAULT_CONFIG" "$CONFIG_FILE" 2>/dev/null || true
        echo "$CONFIG_FILE"
    else
        echo "$DEFAULT_CONFIG"
    fi
}

# -----------------------------------------------------------------------------
# Start service with procd
# -----------------------------------------------------------------------------
cmd_start_service() {
    local config_file=$(get_config_file)
    
    # Ensure config directory exists
    mkdir -p "$(dirname "$config_file")" 2>/dev/null || true
    
    procd_open_instance telego
        procd_set_param path /usr/bin/telego
        procd_set_param command run --config "$config_file"
        procd_set_param user root
        procd_set_param group root
        procd_set_param respawn true
        procd_set_param respawn_threshold 5
        procd_set_param pidfile "/var/run/telego.pid"
        procd_set_param stdout 1
        procd_set_param stderr 1
        procd_set_param reload_signal HUP
        # Health check - verify service is responding
        procd_set_param command_check "pgrep -f 'telego run' > /dev/null"
    procd_close_instance
}

# -----------------------------------------------------------------------------
# Stop service with graceful shutdown
# -----------------------------------------------------------------------------
cmd_stop_service() {
    local pid=$(cat /var/run/telego.pid 2>/dev/null)
    if [ -n "$pid" ]; then
        # Send TERM for graceful shutdown (5s timeout)
        kill -TERM "$pid" 2>/dev/null || true
        sleep 1
        
        # Force kill if still running
        if ps -p "$pid" > /dev/null 2>&1; then
            kill -KILL "$pid" 2>/dev/null || true
        fi
    fi
}

# -----------------------------------------------------------------------------
# Reload service - send SIGHUP for hot-reload (no connection drop)
# -----------------------------------------------------------------------------
cmd_reload_service() {
    local pid=$(cat /var/run/telego.pid 2>/dev/null)
    if [ -n "$pid" ] && ps -p "$pid" > /dev/null 2>&1; then
        kill -HUP "$pid" 2>/dev/null || true
        echo "Telego configuration reloaded (PID: $pid)"
        return 0
    else
        echo "Telego is not running, cannot reload"
        return 1
    fi
}

# -----------------------------------------------------------------------------
# Check service status (text output)
# -----------------------------------------------------------------------------
cmd_status() {
    local pid=$(cat /var/run/telego.pid 2>/dev/null)
    if [ -n "$pid" ] && ps -p "$pid" > /dev/null 2>&1; then
        echo "Running (PID: $pid)"
        return 0
    else
        echo "Stopped"
        return 1
    fi
}

# -----------------------------------------------------------------------------
# Check service status (JSON output for LuCI)
# -----------------------------------------------------------------------------
cmd_status_json() {
    local pid=$(cat /var/run/telego.pid 2>/dev/null)
    if [ -n "$pid" ] && ps -p "$pid" > /dev/null 2>&1; then
        echo '{"running": true, "pid": '$pid'}'
        return 0
    else
        echo '{"running": false}'
        return 1
    fi
}

# -----------------------------------------------------------------------------
# Export functions for procd
# -----------------------------------------------------------------------------
export_service_functions() {
    export -f cmd_start_service
    export -f cmd_stop_service
    export -f cmd_reload_service
    export -f cmd_status
    export -f cmd_status_json
}

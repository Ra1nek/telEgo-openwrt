+++ b/pkg/config/openwrt_dd_shaping_test.go
@@ -0,0 +1,35 @@
+package config
+
+import (
+	"testing"
+	"time"
+)
+
+func TestOpenWrtDDDownlinkShapingConfig(t *testing.T) {
+	cfg := Config{
+		Secrets:     map[string]string{"test": "0123456789abcdef0123456789abcdef"},
+		TLSFronting: TLSFrontingConfig{MaskHost: "example.com"},
+		Performance: PerformanceConfig{
+			DDDownlinkChunk: 1200,
+			DDDownlinkDelay: Duration(2 * time.Millisecond),
+		},
+	}
+	got, err := cfg.ToGProxyConfig()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got.DDDownlinkChunk != 1200 || got.DDDownlinkDelay != 2*time.Millisecond {
+		t.Fatalf("DD shaping = %d/%v, want 1200/2ms", got.DDDownlinkChunk, got.DDDownlinkDelay)
+	}
+}
+
+func TestOpenWrtDDDownlinkDelayRequiresChunk(t *testing.T) {
+	cfg := Config{
+		Secrets:     map[string]string{"test": "0123456789abcdef0123456789abcdef"},
+		TLSFronting: TLSFrontingConfig{MaskHost: "example.com"},
+		Performance: PerformanceConfig{DDDownlinkDelay: Duration(time.Millisecond)},
+	}
+	if _, err := cfg.ToGProxyConfig(); err == nil {
+		t.Fatal("expected DD downlink delay without chunk to be rejected")
+	}
+}
+
+func TestOpenWrtDDDownlinkRejectsMiddleEnd(t *testing.T) {
+	cfg := Config{
+		Secrets:     map[string]string{"test": "0123456789abcdef0123456789abcdef"},
+		TLSFronting: TLSFrontingConfig{MaskHost: "example.com"},
+		Performance: PerformanceConfig{DDDownlinkChunk: 1200},
+		MiddleEnd:   MiddleEndConfig{Enabled: true},
+	}
+	if _, err := cfg.ToGProxyConfig(); err == nil {
+		t.Fatal("expected DD shaping with Middle-End to be rejected")
+	}
+}
+
+func TestOpenWrtDDDownlinkDelayBound(t *testing.T) {
+	cfg := Config{
+		Secrets:     map[string]string{"test": "0123456789abcdef0123456789abcdef"},
+		TLSFronting: TLSFrontingConfig{MaskHost: "example.com"},
+		Performance: PerformanceConfig{
+			DDDownlinkChunk: 1200,
+			DDDownlinkDelay: Duration(time.Second + time.Nanosecond),
+		},
+	}
+	if _, err := cfg.ToGProxyConfig(); err == nil {
+		t.Fatal("expected DD downlink delay above 1s to be rejected")
+	}
+}

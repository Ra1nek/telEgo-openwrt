+func (h *ProxyHandler) ddDownlinkChunkSize(available int) int {
+	n := min(available, relayBatchSize)
+	if limit := h.config.DDDownlinkChunk; limit > 0 && n > limit {
+		n = limit
+	}
+	return n
+}
+
+func (h *ProxyHandler) scheduleDDDownlinkWake(dcConn gnet.Conn, dcCtx *DCConnContext, delay time.Duration) {
+	if delay <= 0 || !dcCtx.ddWakeScheduled.CompareAndSwap(false, true) {
+		return
+	}
+	time.AfterFunc(delay, func() {
+		dcCtx.ddWakeScheduled.Store(false)
+		if dcCtx.closed.Load() || dcCtx.ClientCtx == nil || dcCtx.ClientCtx.State() == StateClosed {
+			return
+		}
+		_ = dcConn.Wake(nil)
+	})
+}
+
 func (h *ProxyHandler) handleDCTrafficDD(dcConn gnet.Conn, dcCtx *DCConnContext) gnet.Action {
 	clientCtx := dcCtx.ClientCtx
 	data, _ := dcConn.Peek(-1)
 	if len(data) == 0 {
 		return gnet.None
+	}
+	if delay := h.config.DDDownlinkDelay; delay > 0 {
+		now := time.Now().UnixNano()
+		if next := dcCtx.ddNextWriteNs.Load(); next > now {
+			h.scheduleDDDownlinkWake(dcConn, dcCtx, time.Duration(next-now))
+			return gnet.None
+		}
 	}
 	if len(data) > max(h.maxWriteBuffer, relayBatchSize) {
 		return gnet.Close
 	}
 	if dcCtx.ToClient == nil {
 		dcCtx.ToClient = newRelayOutput(dcCtx.ClientConn, dcConn, clientCtx, h.maxWriteBuffer)
 	}
-	n := dcCtx.ToClient.reserve(min(len(data), relayBatchSize), 1)
+	n := dcCtx.ToClient.reserve(h.ddDownlinkChunkSize(len(data)), 1)
 	if n == 0 {
 		return gnet.None
 	}
 	buffer, release := h.relayBuffer(n)
 	dcCtx.DCDecrypt.XORKeyStream(buffer, data[:n])
 	dcCtx.ClientEncrypt.XORKeyStream(buffer, buffer)
 	if err := dcCtx.ToClient.write(buffer, release); err != nil {
 		return gnet.Close
 	}
 	if counter := clientCtx.TrafficOut(); counter != nil {
 		counter.Add(int64(n))
 	}
 	clientCtx.recordServerActivity()
 	_, _ = dcConn.Discard(n)
+
+	delay := h.config.DDDownlinkDelay
+	if delay > 0 {
+		dcCtx.ddNextWriteNs.Store(time.Now().Add(delay).UnixNano())
+	}
 	if len(data) > n {
-		if err := dcConn.Wake(nil); err != nil {
+		if delay > 0 {
+			h.scheduleDDDownlinkWake(dcConn, dcCtx, delay)
+		} else if err := dcConn.Wake(nil); err != nil {
 			return gnet.Close
 		}
 	}
 	return gnet.None
 }
diff --git a/pkg/gproxy/openwrt_dd_shaping_test.go b/pkg/gproxy/openwrt_dd_shaping_test.go
new file mode 100644
--- /dev/null
+++ b/pkg/gproxy/openwrt_dd_shaping_test.go
@@ -0,0 +1,19 @@
+package gproxy
+
+import "testing"
+
+func TestDDDownlinkChunkSizeOpenWrt(t *testing.T) {
+	handler := NewProxyHandler(&Config{}, &testLogger{})
+
+	if got := handler.ddDownlinkChunkSize(2 * relayBatchSize); got != relayBatchSize {
+		t.Fatalf("unshaped DD chunk = %d, want %d", got, relayBatchSize)
+	}
+
+	handler.config.DDDownlinkChunk = 1200
+	if got := handler.ddDownlinkChunkSize(2 * relayBatchSize); got != 1200 {
+		t.Fatalf("shaped DD chunk = %d, want 1200", got)
+	}
+	if got := handler.ddDownlinkChunkSize(700); got != 700 {
+		t.Fatalf("short DD chunk = %d, want 700", got)
+	}
+}

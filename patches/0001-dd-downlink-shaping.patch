+func (h *ProxyHandler) ddDownlinkChunkSize(available int) int {
+	n := min(available, relayBatchSize)
+	if limit := h.config.DDDownlinkChunk; limit > 0 && n > limit {
+		n = limit
+	}
+	return n
+}
+
+func (dcCtx *DCConnContext) ddDownlinkRemaining() time.Duration {
+	dcCtx.ddPacingMu.Lock()
+	defer dcCtx.ddPacingMu.Unlock()
+
+	if dcCtx.ddNextWrite.IsZero() {
+		return 0
+	}
+	remaining := time.Until(dcCtx.ddNextWrite)
+	if remaining > 0 {
+		return remaining
+	}
+
+	dcCtx.ddWakeGeneration++
+	if dcCtx.ddTimer != nil {
+		dcCtx.ddTimer.Stop()
+		dcCtx.ddTimer = nil
+	}
+	dcCtx.ddNextWrite = time.Time{}
+	return 0
+}
+
+func (dcCtx *DCConnContext) setDDDownlinkDeadline(delay time.Duration) {
+	dcCtx.ddPacingMu.Lock()
+	defer dcCtx.ddPacingMu.Unlock()
+
+	dcCtx.ddWakeGeneration++
+	if dcCtx.ddTimer != nil {
+		dcCtx.ddTimer.Stop()
+		dcCtx.ddTimer = nil
+	}
+	if delay > 0 {
+		dcCtx.ddNextWrite = time.Now().Add(delay)
+	} else {
+		dcCtx.ddNextWrite = time.Time{}
+	}
+}
+
+func (dcCtx *DCConnContext) stopDDDownlinkTimer() {
+	dcCtx.ddPacingMu.Lock()
+	defer dcCtx.ddPacingMu.Unlock()
+
+	dcCtx.ddWakeGeneration++
+	if dcCtx.ddTimer != nil {
+		dcCtx.ddTimer.Stop()
+		dcCtx.ddTimer = nil
+	}
+	dcCtx.ddNextWrite = time.Time{}
+}
+
+func (h *ProxyHandler) scheduleDDDownlinkWake(dcConn gnet.Conn, dcCtx *DCConnContext, delay time.Duration) {
+	if delay <= 0 {
+		return
+	}
+
+	dcCtx.ddPacingMu.Lock()
+	if dcCtx.closed.Load() || dcCtx.ddTimer != nil {
+		dcCtx.ddPacingMu.Unlock()
+		return
+	}
+	generation := dcCtx.ddWakeGeneration
+	dcCtx.ddTimer = time.AfterFunc(delay, func() {
+		dcCtx.ddPacingMu.Lock()
+		if generation != dcCtx.ddWakeGeneration {
+			dcCtx.ddPacingMu.Unlock()
+			return
+		}
+		dcCtx.ddTimer = nil
+		dcCtx.ddNextWrite = time.Time{}
+		dcCtx.ddPacingMu.Unlock()
+
+		if dcCtx.closed.Load() || dcCtx.ClientCtx == nil || dcCtx.ClientCtx.State() == StateClosed {
+			return
+		}
+		if err := dcConn.Wake(nil); err != nil {
+			_ = dcConn.Close()
+		}
+	})
+	dcCtx.ddPacingMu.Unlock()
+}

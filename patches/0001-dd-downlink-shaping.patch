diff --git a/pkg/gproxy/openwrt_dd_shaping_test.go b/pkg/gproxy/openwrt_dd_shaping_test.go
new file mode 100644
--- /dev/null
+++ b/pkg/gproxy/openwrt_dd_shaping_test.go
@@ -0,0 +1,88 @@
+package gproxy
+
+import (
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/panjf2000/gnet/v2"
+)
+
+type ddWakeTestConn struct {
+	*testMockGnetConn
+	wakes atomic.Int64
+}
+
+func (c *ddWakeTestConn) Wake(callback gnet.AsyncCallback) error {
+	c.wakes.Add(1)
+	return c.testMockGnetConn.Wake(callback)
+}
+
+func TestDDDownlinkChunkSizeOpenWrt(t *testing.T) {
+	handler := NewProxyHandler(&Config{}, &testLogger{})
+
+	if got := handler.ddDownlinkChunkSize(2 * relayBatchSize); got != relayBatchSize {
+		t.Fatalf("unshaped DD chunk = %d, want %d", got, relayBatchSize)
+	}
+
+	handler.config.DDDownlinkChunk = 1200
+	if got := handler.ddDownlinkChunkSize(2 * relayBatchSize); got != 1200 {
+		t.Fatalf("shaped DD chunk = %d, want 1200", got)
+	}
+	if got := handler.ddDownlinkChunkSize(700); got != 700 {
+		t.Fatalf("short DD chunk = %d, want 700", got)
+	}
+}
+
+func TestOpenWrtDDDownlinkTimerCancellation(t *testing.T) {
+	handler := NewProxyHandler(&Config{}, &testLogger{})
+	conn := &ddWakeTestConn{testMockGnetConn: newTestMockGnetConn()}
+	ctx := &DCConnContext{ClientCtx: NewConnContext()}
+
+	ctx.setDDDownlinkDeadline(40 * time.Millisecond)
+	handler.scheduleDDDownlinkWake(conn, ctx, ctx.ddDownlinkRemaining())
+	ctx.ddPacingMu.Lock()
+	timerScheduled := ctx.ddTimer != nil
+	ctx.ddPacingMu.Unlock()
+	if !timerScheduled {
+		t.Fatal("DD wake timer was not scheduled")
+	}
+
+	ctx.closed.Store(true)
+	ctx.stopDDDownlinkTimer()
+	time.Sleep(70 * time.Millisecond)
+
+	if got := conn.wakes.Load(); got != 0 {
+		t.Fatalf("cancelled DD timer woke connection %d times", got)
+	}
+	ctx.ddPacingMu.Lock()
+	defer ctx.ddPacingMu.Unlock()
+	if ctx.ddTimer != nil || !ctx.ddNextWrite.IsZero() {
+		t.Fatal("cancelled DD timer retained pacing state")
+	}
+}
+
+func TestOpenWrtDDDownlinkTimerResetDropsStaleWake(t *testing.T) {
+	handler := NewProxyHandler(&Config{}, &testLogger{})
+	conn := &ddWakeTestConn{testMockGnetConn: newTestMockGnetConn()}
+	ctx := &DCConnContext{ClientCtx: NewConnContext()}
+
+	ctx.setDDDownlinkDeadline(80 * time.Millisecond)
+	handler.scheduleDDDownlinkWake(conn, ctx, ctx.ddDownlinkRemaining())
+
+	ctx.setDDDownlinkDeadline(10 * time.Millisecond)
+	handler.scheduleDDDownlinkWake(conn, ctx, ctx.ddDownlinkRemaining())
+
+	deadline := time.Now().Add(time.Second)
+	for conn.wakes.Load() == 0 && time.Now().Before(deadline) {
+		time.Sleep(time.Millisecond)
+	}
+	if got := conn.wakes.Load(); got != 1 {
+		t.Fatalf("reset DD timer wake count = %d, want 1", got)
+	}
+
+	time.Sleep(100 * time.Millisecond)
+	if got := conn.wakes.Load(); got != 1 {
+		t.Fatalf("stale DD timer produced an extra wake: %d", got)
+	}
+}

@@ -0,0 +1,30 @@
+package gproxy
+
+import (
+	"testing"
+
+	"github.com/panjf2000/gnet/v2"
+)
+
+func TestOpenWrtTLSFrontingDisabledRejectsEEButKeepsDDDetection(t *testing.T) {
+	handler := NewProxyHandler(&Config{DisableTLSFronting: true}, &testLogger{})
+
+	tlsConn := newTestMockGnetConn()
+	tlsCtx := NewConnContext()
+	tlsConn.SetContext(tlsCtx)
+	tlsConn.SetReadData([]byte{0x16, 0x03, 0x01, 0x00, 0x05})
+	if action := handler.handleDetectProtocol(tlsConn, tlsCtx); action != gnet.Close {
+		t.Fatalf("disabled TLS fronting action = %v, want Close", action)
+	}
+
+	ddConn := newTestMockGnetConn()
+	ddCtx := NewConnContext()
+	ddConn.SetContext(ddCtx)
+	ddConn.SetReadData([]byte{0x45, 0x12, 0x34, 0x56, 0x78})
+	if action := handler.handleDetectProtocol(ddConn, ddCtx); action != gnet.None {
+		t.Fatalf("DD detection action = %v, want None", action)
+	}
+	if got := ddCtx.ProtocolMode(); got != ModeDD {
+		t.Fatalf("protocol mode = %v, want ModeDD", got)
+	}
+}

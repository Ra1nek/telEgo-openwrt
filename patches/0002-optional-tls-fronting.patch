diff --git a/pkg/config/openwrt_tls_fronting_test.go b/pkg/config/openwrt_tls_fronting_test.go
new file mode 100644
--- /dev/null
+++ b/pkg/config/openwrt_tls_fronting_test.go
@@ -0,0 +1,40 @@
+package config
+
+import "testing"
+
+func TestOpenWrtTLSFrontingDisabledAllowsDDOnlyWithoutMaskHost(t *testing.T) {
+	disabled := false
+	cfg := Config{
+		Secrets: map[string]string{
+			"test": "0123456789abcdef0123456789abcdef",
+		},
+		TLSFronting: TLSFrontingConfig{Enabled: &disabled},
+	}
+
+	got, err := cfg.ToGProxyConfig()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !got.DisableTLSFronting {
+		t.Fatal("TLS fronting was not disabled")
+	}
+	if got.MaskHost != "" || got.FetchRealCert || got.SpliceUnrecognized {
+		t.Fatalf("disabled TLS runtime leaked fronting state: host=%q fetch=%v splice=%v", got.MaskHost, got.FetchRealCert, got.SpliceUnrecognized)
+	}
+	if len(got.Secrets) != 1 || got.Secrets[0].RawHex != "" || got.Secrets[0].Host != "" {
+		t.Fatalf("disabled TLS runtime derived an EE secret: %#v", got.Secrets)
+	}
+}
+
+func TestOpenWrtTLSFrontingEnabledStillRequiresMaskHost(t *testing.T) {
+	enabled := true
+	cfg := Config{
+		Secrets: map[string]string{
+			"test": "0123456789abcdef0123456789abcdef",
+		},
+		TLSFronting: TLSFrontingConfig{Enabled: &enabled},
+	}
+	if _, err := cfg.ToGProxyConfig(); err == nil {
+		t.Fatal("enabled TLS fronting unexpectedly accepted an empty mask-host")
+	}
+}

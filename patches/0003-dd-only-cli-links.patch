diff --git a/cmd/telego/openwrt_dd_only_links_test.go b/cmd/telego/openwrt_dd_only_links_test.go
new file mode 100644
--- /dev/null
+++ b/cmd/telego/openwrt_dd_only_links_test.go
@@ -0,0 +1,37 @@
+package main
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/scratch-net/telego/pkg/gproxy"
+)
+
+func TestOpenWrtDDOnlyTelegramLinksOmitEE(t *testing.T) {
+	secret := gproxy.Secret{
+		Name: "test",
+		Key:  []byte{0x01, 0x23, 0x45, 0x67, 0x89, 0xab, 0xcd, 0xef, 0x01, 0x23, 0x45, 0x67, 0x89, 0xab, 0xcd, 0xef},
+	}
+	links := buildTelegramProxyLinks("203.0.113.10", "2443", secret)
+	if links.EE != "" {
+		t.Fatalf("DD-only config produced EE link %q", links.EE)
+	}
+	if !strings.Contains(links.DD, "secret=dd0123456789abcdef0123456789abcdef") {
+		t.Fatalf("unexpected DD link %q", links.DD)
+	}
+}
+
+func TestOpenWrtTLSFrontingTelegramLinksIncludeEE(t *testing.T) {
+	secret := gproxy.Secret{
+		Name:   "test",
+		Key:    []byte{0x01, 0x23, 0x45, 0x67, 0x89, 0xab, 0xcd, 0xef, 0x01, 0x23, 0x45, 0x67, 0x89, 0xab, 0xcd, 0xef},
+		RawHex: "ee0123456789abcdef0123456789abcdef79612e7275",
+	}
+	links := buildTelegramProxyLinks("203.0.113.10", "2443", secret)
+	if links.EE == "" || !strings.Contains(links.EE, "secret="+secret.RawHex) {
+		t.Fatalf("TLS-fronting config did not produce EE link: %q", links.EE)
+	}
+	if links.DD == "" {
+		t.Fatal("TLS-fronting config lost DD link")
+	}
+}

+func buildTelegramProxyLinks(server, port string, secret gproxy.Secret) telegramProxyLinks {
+	ddSecret := config.BuildDDSecret(secret.Key)
+	links := telegramProxyLinks{
+		DD: fmt.Sprintf("tg://proxy?server=%s&port=%s&secret=%s", server, port, ddSecret),
+	}
+	if secret.RawHex != "" {
+		links.EE = fmt.Sprintf("tg://proxy?server=%s&port=%s&secret=%s", server, port, secret.RawHex)
+	}
+	return links
+}
